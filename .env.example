# Copy this file to ".env" for local runs (".env" is gitignored). On Railway, set the same
# names under Variables instead. Real values never go in this file or in git.

# --- Zoho Creator service account (required) ---
# Alternative locally: server/zoho-credentials.json (gitignored). Variables below win if both exist.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Optional: a starting access token; the server refreshes it on its own.
ZOHO_ACCESS_TOKEN=

# --- Zoho Books and Inventory (own OAuth client: scopes ZohoBooks.fullaccess.all, ZohoInventory.FullAccess.all) ---
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
# Organization id shared by Books and Inventory (Deluge scripts use 751117756); override Inventory's with ZOHO_INVENTORY_ORG_ID
ZOHO_BOOKS_ORG_ID=

# --- Inquiry notifications to the supplier portals (workflows/inquiry.mjs) ---
# Portal account email that sees each supplier's notifications; empty means nobody sees them.
TONY_PORTAL_EMAIL=
FENTENG_PORTAL_EMAIL=
# Prefix of the links inside those notifications, e.g. https://supply-chain-app-production.up.railway.app
APP_BASE_URL=

# --- Which Zoho app and environment the site talks to ---
ZOHO_OWNER=homecartel
ZOHO_APP=supply-chain-app
# development = safe test data, production = live data. Switch only at go-live.
ZOHO_ENV=development
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# --- Server ---
# local = offline SQLite (no Delivery workflows), pg = business data in Postgres (the Delivery workflows
# only run here; on a PC use `npm run dev:pg`). Zoho Creator is no longer a backend.
BACKEND=local
PORT=4000

# --- Postgres (BACKEND=pg, and tools/import-zoho-backup.mjs) ---
# On Railway set it to the reference ${{Postgres.DATABASE_URL}} (private address). From a PC use the
# public TCP proxy URL of the Postgres service.
DATABASE_URL=
# PGSSL=disable   (SSL is skipped automatically for localhost and *.railway.internal)
# PG_POOL_MAX=10
# Where the SQLite file with users and sessions lives. On Railway point this at the mounted volume.
# DATA_DIR=

# --- Delivery Management (BACKEND=pg) ---
# Geoapify key for geocoding delivery addresses (SA_Geocode_Address). Unset = addresses are not geocoded.
GEOAPIFY_API_KEY=
# Inbound secret for CMS requests (POST /api/integrations/cms/*). Required for CMS -> DMS sync.
# CMS_API_KEY=
# Outbound webhook URLs to the CMS Creator app. Unset = status/message push is skipped.
# CMS_STATUS_URL=      (full URL incl. publickey, where a confirmed/declined request status is posted)
# CMS_MESSAGE_URL=     (the same for chat messages)
# Server time zone: "today" for the scheduling engine is the server's date, so run with Asia/Manila.
# TZ=Asia/Manila

# --- Scheduled workflows (BACKEND=pg) ---
# The daily jobs (Forecast_Stamp_Daily, Backfill_PreOrder_Forecas) only run when this is on. Leave it off on a PC and in tests.
# SCHEDULES=on
