
			displayName = "PR to PO Grouping"
			show all rows from Purchase_Request1    
			(
				sku as "SKU"
				quantity as "Quantity"
				unit as "Unit"
				description as "Description"
				supplier_target_date as "Supplier  Target Date"
				Sales_Owner as "Sales Owner"
				Items
				Selcted_Final_Cost as "Selected Final Cost"
				Followed_Recommendation as "Followed Recommendation"
				Similar_Item as "Similar Item"
				Attachments
				Target_Delivery as "Target  Delivery"
				Remaining_Days as "Remaining Days"
				Required_Days_Lead as "Lead Time (days)"
				Delay_Status as "Delay Status"
				PR_No as "PR No"
				PR_Date as "PR Date"
				Selected_Supplier as "Selected Supplier"
				Priority
				Customer_Type as "Customer Type"
				Description1 as "Description"
				Customer
				category as "Category"
				Additional_Details as "Additional Details"
				Shipment_Mode as "Shipment Mode"
				Selected_Supplier1 as "Selected Supplier"
				Final_price_confirmed as "Final price confirmed"
				Shipping_mode_selected as "Shipping mode selected"
				Target_date_exists as "Target date exists"
				PR_READY_FOR_PO as "PR READY FOR PO"
				PR_Approved as "PR Approved"
				custom action "Approve PR to PO"
				(
	  			workflow = PR_Approved
				show action in view header = true
				show action in edit record menu = true
				column header = "Approve PR to PO"
				condition = (PR_READY_FOR_PO == true && PR_Approved == false)
				confirmation before execution
				(
					message for individual record = "Approve PR for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Sales_Order as "Sales Order"
				Supplier_Selected.Suppliers as "Supplier Selected"
				Order_Value as "Order Value"
				inquiry_reference as "Inquiry Reference"
				PR_Status as "PR Status"
				Order_Type as "Order Type"
				Link_PO_No as "Link PO No"
				Priority_Score as "Priority Score"
				Aging
				Supplier_Load_Balancing.Suppliers as "Supplier Load Balancing"
				Override_Reason as "Override Reason"
				Shipment_Days
				Production_Date as "Production Date"
				Last_Update as "Last Update"
				Source
				Product_Image_PR as "Product Image"
				SRP_Rate_PR as "SRP (Rate)"
			)
			group by
			(
				Sales_Order ascending
				Customer ascending
				Order_Value ascending
			)
		