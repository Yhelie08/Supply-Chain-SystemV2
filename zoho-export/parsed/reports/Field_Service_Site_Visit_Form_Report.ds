				Remarks1 as "Remarks"
				Electrical_Check as "3) Electrical Check"
				Voltage
				Breaker_Size_if_known as "Breaker Size (if known)"
				Remarks2 as "Remarks"
				Ceiling_Structure_Check as "4) Ceiling & Structure Check"
				Remarks3 as "Remarks"
				Safety_Access_Check as "5 Safety & Access Check"
				Remarks4 as "Remarks"
				Site_Delivery_Check as "6) Site & Delivery Check"
				Remarks5 as "Remarks"
				Client_Confirmation as "7) Client Confirmation"
