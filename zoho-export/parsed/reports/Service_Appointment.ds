				Location_Route as "Location Route"
				Date_Confirmed as "Date Confirmed"
				Third_Party_Provider as "3rd Party Provider"
				Shipment_Order_No
				Needs_Site_Visit
				Rescheduled_From_SA
				Item_Details as "Item Details"
