// form: PO_Detect_Mixed  form=Fenteng_Lighting_Purchase_Order event=on add or edit on validate  [.ds line 39035]
    // === PO_Detect_Mixed ===
// Form: Purchase_Order | Event: Created or Edited | Validations on form submission
firstShippingMode = "";
isMixedShipping = false;
for each  ln in input.PO_Line_Items_Supplier1
{
    if(firstShippingMode == "")
    {
        firstShippingMode = ln.Shipping_Mode_Supplier1;
    }
    else if(ln.Shipping_Mode_Supplier1 != firstShippingMode)
    {
        isMixedShipping = true;
    }
}
input.Mixed_Shipping_Supplier1 = isMixedShipping;
