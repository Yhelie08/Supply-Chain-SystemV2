    Target_URL="https://creator.zoho.com/homecartel/supply-chain-app/#Page:Order_Aggregation2?orderAggRecordId=" + input.ID
    Source_Record_No=input.SO
    Source_Record_ID=input.ID
    Added_User=zoho.loginuser
]
