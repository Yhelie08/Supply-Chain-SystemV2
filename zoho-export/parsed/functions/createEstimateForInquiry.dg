            response.put("status","success");
            response.put("estimateId",newEstID);
            response.put("estimateNo",newEstNo);
            response.put("message","Estimate " + newEstNo + " created with " + lineItems.size() + " items");
            return response;
        }
        else
        {
            response.put("status","error");
            response.put("message","Books CREATE failed: " + createResp.get("message") + "");
            return response;
        }
    }
}
if(!found)
{
    response.put("status","error");
    response.put("message","Inquiry " + inqNo + " not found");
}
return response;
