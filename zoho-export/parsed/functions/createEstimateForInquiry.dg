                // description box (the "Add a description to your item" field on the Estimate).
                // The item's own description stays first so nothing that used to be sent is lost;
                // every other part is optional and simply left out when blank.
                descPartsC = List();
                if(inq.description != null && inq.description + "" != "")
                {
                    descPartsC.add(inq.description + "");
                }
                if(inq.Dimension != null && inq.Dimension + "" != "")
