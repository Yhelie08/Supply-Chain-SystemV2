// map getItemBinLocations(String itemBooksId)   [.ds lines 34184-34335]
response = Map();
orgId = "751117756";
itemBooksId = itemBooksId.trim();
if(itemBooksId == "")
{
    response.put("code",3001);
    response.put("message","itemBooksId is required.");
    return response;
}
itemResp = invokeurl
[
    url :"https://www.zohoapis.com/books/v3/items/" + itemBooksId + "?organization_id=" + orgId
    type :GET
    connection:"zhbooks3"
];
detail = itemResp.get("item");
if(detail == null)
{
    response.put("code",3002);
    response.put("message","Item not found in Books for ID " + itemBooksId + ".");
    return response;
}
warehouses = detail.get("warehouses");
warehouseResults = List();
whMatch1 = null;
if(warehouses != null)
{
    for each  wh in warehouses
    {
        if(wh.get("warehouse_id") + "" == "2680178000042173149")
        {
            whMatch1 = wh;
        }
    }
}
if(whMatch1 != null && whMatch1.get("is_storage_location_enabled") == true)
{
    binResp1 = invokeurl
    [
        url :"https://www.zohoapis.com/books/v3/settings/warehouses/2680178000042173149/storagelocations?item_id=" + itemBooksId + "&organization_id=" + orgId
        type :GET
        connection:"zhbooks3"
    ];
    locs1 = binResp1.get("storage_locations");
    binsOut1 = List();
    if(locs1 != null)
    {
        for each  loc in locs1
        {
            locQty1 = loc.get("balance_quantity");
            if(locQty1 != null && locQty1 > 0)
            {
                binRow1 = Map();
                binRow1.put("name",loc.get("name") + "");
                binRow1.put("balance_quantity",locQty1);
                binsOut1.add(binRow1);
            }
        }
    }
    whOut1 = Map();
    whOut1.put("warehouse_id","2680178000042173149");
    whOut1.put("warehouse_name","HC WH3 BAESA");
    whOut1.put("bins",binsOut1);
    warehouseResults.add(whOut1);
}
