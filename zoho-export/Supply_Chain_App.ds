			FW_Completion_Schedule_Sy as "FW_Completion_Schedule_Sync"
			{
				type =  form
				form = Field_Work

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Installation_Status == "Complete" && input.Schedule_End_Date_and_Time != null && input.Service_Appointment_ID != null && input.Service_Appointment_ID != "")
										{
											saId = input.Service_Appointment_ID.toLong();
											saRec = Service_Appointment_Form[ID == saId];
											idMismatch = saRec != null && input.Sales_Order != null && saRec.Sales_Order != input.Sales_Order;
											if(idMismatch)
											{
												mismatchRec = Service_Appointment_Form[ID == saId];
												mismatchRec.Exception_Status="Flagged";
												mismatchRec.Exception_Reason="Field Work ID Mismatch — resolved Service_Appointment's SO doesn't match the Field Work's own SO, completion not applied";
												custNameMismatch = "";
												if(mismatchRec.Customer_Name != null)
												{
													fNameMismatch = mismatchRec.Customer_Name.first_name;
													lNameMismatch = mismatchRec.Customer_Name.last_name;
													if(fNameMismatch == null)
													{
														fNameMismatch = "";
													}
													if(lNameMismatch == null)
													{
														lNameMismatch = "";
													}
													custNameMismatch = (fNameMismatch + " " + lNameMismatch).trim();
												}
												insert into DMS_Exception_Queue
												[
													Sales_Order_Reference=mismatchRec.ID
													Customer_Name=custNameMismatch
													Exception_Stage="Dispatch"
													Exception_Reason="Field Work ID Mismatch — resolved Service_Appointment's SO doesn't match the Field Work's own SO, completion not applied"
													Severity="High"
													Raised_By="System"
													Date_Raised=zoho.currenttime
													Status="Open"
													Added_User=zoho.loginuser
												]
											}
											if(saRec != null && !idMismatch && saRec.Appointment_Status != "Completed" && saRec.Appointment_Status != "Failed")
											{
												saRec.Appointment_Status="Completed";
												// NEW 2026-09-08 — appends the real actual Schedule_Start/End times onto
												// Calendar_Event_Summary so they're visible on the Delivery Queue detail
												// view without an extra click into "View Field Report." FLAGGED
												// 2026-09-10 — this whole block was found MISSING from the live-pasted
												// workflow (silently dropped somewhere between sessions, see [[feedback_
												// files_can_silently_revert]]) — restored here, make sure it's included
												// this time.
												actualStartDT = input.Schedule_Start_Date_and_Time;
												actualEndDTForNote = input.Schedule_End_Date_and_Time;
												actualTimeNote = " | Actual: ";
												if(actualStartDT != null)
												{
													actualTimeNote = actualTimeNote + actualStartDT.toString("MMM dd, yyyy hh:mm a");
												}
												else
												{
													actualTimeNote = actualTimeNote + "?";
												}
												actualTimeNote = actualTimeNote + " - ";
												if(actualEndDTForNote != null)
												{
													actualTimeNote = actualTimeNote + actualEndDTForNote.toString("hh:mm a");
												}
												else
												{
													actualTimeNote = actualTimeNote + "?";
												}
												baseSummaryFW = saRec.Calendar_Event_Summary;
												if(baseSummaryFW == null)
												{
													baseSummaryFW = "";
												}
												saRec.Calendar_Event_Summary=baseSummaryFW + actualTimeNote;
												teamInstaller = saRec.Installer;
												teamDate = saRec.Confirmed_Schedule_Date;
												if(teamInstaller != null && teamDate != null)
												{
													actualEndDT = input.Schedule_End_Date_and_Time;
													actualEndTimeStr24 = actualEndDT.toString("HH:mm");
													aeParts = actualEndTimeStr24.toList(":");
													actualEndMin = 0;
													if(aeParts.size() == 2)
													{
														actualEndMin = aeParts.get(0).toLong() * 60 + aeParts.get(1).toLong();
													}
													aeHr24 = actualEndMin / 60;
													aeMinRem = actualEndMin - aeHr24 * 60;
													aeDispHr = aeHr24;
													if(aeHr24 == 0)
													{
														aeDispHr = 12;
													}
													if(aeHr24 > 12)
													{
														aeDispHr = aeHr24 - 12;
													}
													aeDispAmPm = "AM";
													if(aeHr24 >= 12)
													{
														aeDispAmPm = "PM";
													}
													aeMinStr = aeMinRem + "";
													if(aeMinRem < 10)
													{
														aeMinStr = "0" + aeMinRem;
													}
													actualEndTimeStr = aeDispHr + ":" + aeMinStr + " " + aeDispAmPm;
													pendingSameDay = Service_Appointment_Form[Installer == teamInstaller && Suggested_Schedule_Date == teamDate && Confirmed_Schedule_Date == null && Appointment_Status != "Failed" && ID != saRec.ID];
													if(pendingSameDay != null)
													{
														for each  psd in pendingSameDay
														{
															pendRec = Service_Appointment_Form[ID == psd.ID];
															pendRec.Suggested_Time_Slot=actualEndTimeStr;
														}
													}
													confirmedSameDay = Service_Appointment_Form[Installer == teamInstaller && Confirmed_Schedule_Date == teamDate && Appointment_Status != "Completed" && Appointment_Status != "Failed" && ID != saRec.ID];
													if(confirmedSameDay != null)
													{
														for each  csd in confirmedSameDay
														{
															csdTimeStr = "";
															if(csd.Confirmed_Time_Slot != null)
															{
																csdTimeStr = csd.Confirmed_Time_Slot.toString();
															}
															if(csdTimeStr != null && csdTimeStr != "")
															{
																csdParts = csdTimeStr.toList(" ");
																csdMin = -1;
																if(csdParts.size() == 2)
																{
																	csdHM = csdParts.get(0).toList(":");
																	if(csdHM.size() >= 2)
																	{
																		csdHr = csdHM.get(0).toLong();
																		csdMinPart = csdHM.get(1).toLong();
																		csdAmPm = csdParts.get(1).toUpperCase();
																		if(csdAmPm == "PM" && csdHr != 12)
																		{
																			csdHr = csdHr + 12;
																		}
																		if(csdAmPm == "AM" && csdHr == 12)
																		{
																			csdHr = 0;
																		}
																		csdMin = csdHr * 60 + csdMinPart;
																	}
																}
																if(csdMin >= 0 && actualEndMin > csdMin)
																{
																	flagRec = Service_Appointment_Form[ID == csd.ID];
																	flagRec.Exception_Status="Flagged";
																	flagRec.Exception_Reason="Schedule Drift — Prior job finished later than planned";
																	custNameDrift = "";
																	if(flagRec.Customer_Name != null)
																	{
																		fNameDrift = flagRec.Customer_Name.first_name;
																		lNameDrift = flagRec.Customer_Name.last_name;
																		if(fNameDrift == null)
																		{
																			fNameDrift = "";
																		}
																		if(lNameDrift == null)
																		{
																			lNameDrift = "";
																		}
																		custNameDrift = (fNameDrift + " " + lNameDrift).trim();
																	}
																	insert into DMS_Exception_Queue
																	[
																		Sales_Order_Reference=flagRec.ID
																		Customer_Name=custNameDrift
																		Exception_Stage="Scheduling"
																		Exception_Reason="Schedule Drift — Prior job finished later than planned"
																		Severity="Medium"
																		Raised_By="System"
																		Date_Raised=zoho.currenttime
																		Status="Open"
																		Added_User=zoho.loginuser
																	]
																}
															}
														}
													}
												}
											}
										}
						)
					}
				}

			}
			DS_Validate_Team_Capacity1 as "DS_Validate_Team_Capacity"
			{
				type =  form
				form = Delivery_Scheduling

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Date_field != null && input.Installer != null)
										{
											warnTeams = "";
											for each  ins in input.Installer
											{
												availDS = Daily_Team_Availability[Availability_Date == input.Date_field && Installer == ins && Availability_Status != "Not Available"];
												cntDS = 0;
												if(availDS != null)
												{
													for each  ad in availDS
													{
														cntDS = cntDS + 1;
													}
												}
												if(cntDS == 0)
												{
													if(warnTeams != "")
													{
														warnTeams = warnTeams + ", ";
													}
													warnTeams = warnTeams + ins;
												}
											}
											if(warnTeams != "")
											{
												alert "Paalala: walang Daily Team Availability record para sa " + warnTeams + " sa petsang ito. I-check muna sa Daily Team Availability - baka naka-leave o walang schedule. Tutuloy pa rin ang save kung sigurado ka.";
											}
										}
						)
					}
				}

			}
			SR_Created_Make_Appointme as "SR_Created_Make_Appointment"
			{
				type =  form
				form = Service_Request1

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================================
										// SR_Created_Make_Appointment
										// Service_Request1 (Created > Successful submission)
										//
										// Guard: kung may Service_Appointment_ID na, wala nang gagawin. Ito ang
										// nagpipigil ng dobleng appointment kung sakaling ma-trigger ulit ito.
										// =====================================================================
										if(input.Service_Appointment_ID == null || input.Service_Appointment_ID == "")
										{
											srRec = Service_Request1[ID == input.ID];
											// -----------------------------------------------------------------
											// 1. Kunin ang stage-1 record (Initial Scheduling) para sa 2 petsa na
											//    wala sa Service Request: Order_Date at ang araw ng dispatch.
											//    for-each, hindi bare assignment — ito ang proven-safe na shape
											//    dito para sa pagbasa ng record na hindi `input` (pareho ng
											//    dms_exception_queue.txt).
											// -----------------------------------------------------------------
											isOrderDate = null;
											isDispatchDate = null;
											if(input.Initial_Schedule_ID != null && input.Initial_Schedule_ID != "")
											{
												for each  isLoop in Delivery_Scheduling[ID == input.Initial_Schedule_ID.toLong()]
												{
													isOrderDate = isLoop.Order_Date;
													isDispatchDate = isLoop.Added_Time.toDate();
												}
											}
											if(isDispatchDate == null)
											{
												isDispatchDate = zoho.currentdate;
											}
											// -----------------------------------------------------------------
											// 2. Type_of_Delivery — PICKLIST sa appointment, plain text sa SR.
											//    Ang value na wala sa listahan ay tinatanggihan ang BUONG insert,
											//    kaya hindi natin ipapasa kung hindi eksaktong tugma. Hindi ito
											//    hula — ito ang 8 tunay na choice sa Service_Appointment_Form.
											// -----------------------------------------------------------------
											validTypes = {"Delivery Only","With Installation","Full-Day Install","Multi-Day Install","Replacement","Site Visit","Pullout","Pick Up"};
											typeToUse = "";
											rawType = ifnull(input.Delivery_Type,"").trim();
											if(validTypes.contains(rawType))
											{
												typeToUse = rawType;
											}
											// -----------------------------------------------------------------
											// 3. Gawin ang appointment. Naka-"Queued" — ito ang tunay na starting
											//    state ng DMS, at ito ang hinahanap ng site-confirmation workflow.
											//
											//    Walang Date field na ipinapasa na blangko: ang Deluge ay
											//    sumasabog ng "UnParsable date" sa blangkong petsa, kaya ang
											//    Requested_Delivery_* at Order_Date ay isusulat PAGKATAPOS ng
											//    insert, may null check bawat isa.
											// -----------------------------------------------------------------
											newSaId = insert into Service_Appointment_Form
											[
												Appointment_Status="Queued"
												Sales_Order=ifnull(input.Sales_Order,"")
												Sales_Order_Display=ifnull(input.Sales_Order,"")
												Package_Number=ifnull(input.Package_Number,"")
												Customer_Address=ifnull(input.Customer_Address,"")
												City=ifnull(input.City,"")
												Email=ifnull(input.Email,"")
												Contact=input.Phone_Number
												Type_of_Delivery=typeToUse
												Initial_Schedule_ID=ifnull(input.Initial_Schedule_ID,"")
												Service_Request_ID=input.ID + ""
												Service_Request=ifnull(input.SR_No,"") + ""
												Original_SO=ifnull(input.Original_SO,"")
												RMA=ifnull(input.RMA1,"")
												Reason=ifnull(input.Reason,"")
												Sub_Reason=ifnull(input.Sub,"")
												If_Pull_Out=ifnull(input.If_Pull_Out,"")
												Priority_Level=ifnull(input.Priority_Level,"")
												Scheduled_by=ifnull(input.Scheduled_by,"")
												Fulfillment_Completed_Date=isDispatchDate
												Site_Confirmation_Status="Pending"
												Exception_Status="None"
												Added_User=zoho.loginuser
											];
											newSA = Service_Appointment_Form[ID == newSaId];
											// -----------------------------------------------------------------
											// 4. Customer_Name — NAME-type field sa appointment, plain text sa SR.
											//    Walang maaasahang hati sa first/last, kaya buo sa last_name
											//    (mababasa pa rin ang zc_display_value) — pareho ng desisyon ng
											//    Order Aggregation widget noong 2026-07-28, hindi hula sa hati.
											// -----------------------------------------------------------------
											srCustName = ifnull(input.Customer_Name,"").trim();
											if(srCustName != "")
											{
												newSA.Customer_Name.first_name="";
												newSA.Customer_Name.last_name=srCustName;
											}
											// -----------------------------------------------------------------
											// 5. ANG BUOD NG BUONG STEP NA ITO — ang initial schedule.
											//    Ito ang dadaanan ng scheduling engine (step 4): ang slot search
											//    ay mag-aanchor sa Requested_Delivery_Date, hindi na sa "ngayon".
											//
											//    CHANGED 2026-10-27 — ang Initial_Schedule_Time ay DATE-TIME pala
											//    (nakumpirma nang live: code 3002 "Enter a valid date format for
											//    Initial Schedule Time" nang sinubukang isulat na puro oras), samantalang
											//    ang Requested_Delivery_Time ay TIME. Kaya kinukuha dito ang oras na
											//    bahagi lang. 12-oras ang format ("09:39:00 AM") — ganoon ang ipinapakita
											//    ng lahat ng Time field sa app na ito (timedisplayoptions = "hh:mm:ss",
											//    maliit na hh = 12-oras), at ganoon din ang Confirmed_Time_Slot.
											// -----------------------------------------------------------------
											if(input.Delivery_Date != null)
											{
												newSA.Requested_Delivery_Date=input.Delivery_Date;
											}
											if(input.Initial_Schedule_Time != null)
											{
												newSA.Requested_Delivery_Time=input.Initial_Schedule_Time.toString("hh:mm:ss a");
											}
											if(isOrderDate != null)
											{
												newSA.Order_Date=isOrderDate;
											}
											// -----------------------------------------------------------------
											// 6. Item rows. Kasama ang PAC — ito ang per-package identity na
											//    kailangang makarating hanggang dulo ng chain.
											//    Ang .insert() sa subform ang proven-safe na shape dito.
											// -----------------------------------------------------------------
											for each  it in input.Item_Details
											{
												newRow = Service_Appointment_Form.Item_Details();
												newRow.Item_Name=it.Item_Name;
												newRow.SKU=it.SKU;
												newRow.Quantity=it.Quantity;
												newRow.PAC=it.PAC;
												newSA.Item_Details.insert(newRow);
											}
											// -----------------------------------------------------------------
											// 7. Package_Shipments — isang row kada package.
											//    Galing sa per-row PAC, hindi sa header Package_Number (display
											//    lang iyon; pwedeng "PAC1, PAC2" kapag 2 package ang dispatch).
											//    Kapag walang PAC sa kahit isang row (lumang record), hahatiin
											//    ang header sa kuwit bilang fallback.
											// -----------------------------------------------------------------
											pacList = List();
											for each  it2 in input.Item_Details
											{
												p = ifnull(it2.PAC,"").trim();
												if(p != "" && !pacList.contains(p))
												{
													pacList.add(p);
												}
											}
											if(pacList.size() == 0)
											{
												hdrPac = ifnull(input.Package_Number,"").trim();
												if(hdrPac != "")
												{
													for each  hp in hdrPac.toList(",")
													{
														hp2 = hp.trim();
														if(hp2 != "" && !pacList.contains(hp2))
														{
															pacList.add(hp2);
														}
													}
												}
											}
											for each  pac in pacList
											{
												insert into Package_Shipments
												[
													Service_Appointment_ID=newSaId + ""
													Sales_Order=ifnull(input.Sales_Order,"")
													Package_Number=pac
													Shipment_Created=false
													Added_User=zoho.loginuser
												]
											}
											// -----------------------------------------------------------------
											// 8. Write-back sa Service Request. Huling-huli ito: hangga't
											//    blangko ang Service_Appointment_ID, alam ng guard sa itaas na
											//    hindi pa tapos — kaya ang isang na-abort na run ay pwedeng
											//    i-retry nang hindi nagdodoble.
											// -----------------------------------------------------------------
											srRec.Service_Appointment_ID=newSaId + "";
											srRec.SR_Status="Scheduling";
											info "SR_Created_Make_Appointment: SR " + input.ID + " -> SA " + newSaId + ", " + pacList.size() + " package row(s)";
										}
						)
					}
				}

			}
			Pick1_Marked_to_QC_Sync as "Pick1 Marked to QC Sync"
			{
				type =  form
				form = Pick1

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ===== FULFILLMENT_STAGE = "Picking" =====
										// Ang pagkakaroon ng Pick1 record para sa item na ito ay nangangahulugang "Picking" na
										// ang stage nito sa Sales_Order_Fulfillment. Isang Sales_Order_Fulfillment record per
										// item (see so_fulfillment_sync.txt), kaya SO + Item + SKU ang batayan ng pagtugma.
										// BINAGO 2026-10-29: naka-guard na ito sa likod ng "hindi pa Marked" - dati tumatakbo ito
										// sa BAWAT save, kaya ang muling pag-save ng isang Marked nang Pick1 record ay nagbabalik
										// muna sa "Picking" bago sumulong ulit. Kapag Marked na, ang "Quality Checking" block sa
										// dulo na ang bahala.
										if(input.Marked != true)
										{
											soValStage = input.SO + "";
											skuValStage = input.SKU + "";
											itemNameForSOF = input.Item_Name + "";
											sofMatches = Sales_Order_Fulfillment[SO_No == soValStage];
											for each  sofRec in sofMatches
											{
												sofFullList = Sales_Order_Fulfillment[ID == sofRec.ID];
												for each  sofFull in sofFullList
												{
													sofFound = false;
													for each  sofRow in sofFull.Item_Details1
													{
														if(sofRow.Item + "" == itemNameForSOF && sofRow.SKU + "" == skuValStage)
														{
															sofFound = true;
														}
													}
													if(sofFound == true && sofFull.Fulfillment_Stage != "Picking")
													{
														update sofFull
														[
															Fulfillment_Stage="Picking"
														];
														info "Fulfillment_Stage updated to Picking for SO " + soValStage + " / SKU " + skuValStage;
													}
												}
											}
											info "Marked (Mark Picked) is not checked - skipping QC sync.";
											return;
										}
										soVal = input.SO + "";
										skuVal = input.SKU + "";
										pacVal = input.Package_Order + "";
										// Guard sa "null" + "" -> literal na string na "null" na gotcha (see
										// [[deluge_creator_gotchas]]) para ang talagang blangkong RR ay maging "" dito, tugma sa
										// kung paano talaga nababasa ang existing records, hindi ang salitang "null".
										// Kailangan ang RR sa dedup key dahil sinasadyang ginagamit ulit ng isang RR replacement
										// ang PAREHONG Package_Order ng original (see checker_checklist_qc_sync.txt), kaya hindi
										// na sapat ang SO+SKU+PAC para pagkaibahin sila.
										rrVal = input.RR + "";
										if(rrVal == "null")
										{
											rrVal = "";
										}
										// ===== UPDATE-or-CREATE sa Checker_Checklist =====
										// Kasama ang QC_Status == "" sa key: ang isang existing record ay bilang na "pareho" lang
										// kung PENDING pa ito (hindi pa na-review). Ang na-Approve/Reject na ay closed historical
										// record na - hindi binubuksan ulit, kaya ang isang RR item na umikot pabalik sa Pick ay
										// laging may sarili at bagong QC record na tunay na rere-review-in. (Parehong dahilan ng
										// 2026-08-13 fix sa pack_to_checker_checklist_sync.txt.)
										alreadyExists = false;
										for each  existingRec in Checker_Checklist[SO == soVal && SKU == skuVal && PAC == pacVal && RR == rrVal && QC_Status == ""]
										{
											alreadyExists = true;
											update existingRec
											[
												PR=input.PR_if_any
												Demo=input.Demo
												RR=input.RR
												Delivery_Type=input.Delivery_Type
												Order_Type=input.Order_Type
												Target_Delivery_Date=input.Target_Delivery_Date
												For_Crate=input.For_Crate
												Customer_Name=input.Customer_Name
												Customer_Address=input.Customer_Address
												Customer_Type=input.Customer_Type
												Item_Name=input.Item_Name
												Quantity=input.Quantity_to_Pick
												Bin_Location=input.Bin_Location
											];
											info "Updated existing Checker_Checklist record for SO " + soVal + " / SKU " + skuVal + " / PAC " + pacVal;
										}
										if(alreadyExists == false)
										{
											// ===== CREATE Checker_Checklist RECORD =====
											// Sinasadyang WALANG Quality_Checker dito - ang QC Report widget (viewlist) ang
											// pipili ng packer, at doon lang bubukas ang QC button.
											newId = insert into Checker_Checklist
											[
												SO=soVal
												PAC=pacVal
												PR=input.PR_if_any
												Demo=input.Demo
												RR=input.RR
												Delivery_Type=input.Delivery_Type
												Order_Type=input.Order_Type
												Target_Delivery_Date=input.Target_Delivery_Date
												For_Crate=input.For_Crate
												Customer_Name=input.Customer_Name
												Customer_Address=input.Customer_Address
												Customer_Type=input.Customer_Type
												Item_Name=input.Item_Name
												Quantity=input.Quantity_to_Pick
												SKU=skuVal
												Bin_Location=input.Bin_Location
												Added_User=zoho.loginuser
											];
											info "Checker_Checklist record created straight from Pick1 (SO " + soVal + " / SKU " + skuVal + " / PAC " + pacVal + "), new ID: " + newId;
										}
										// ===== FULFILLMENT_STAGE = "Quality Checking" =====
										// Diretso na mula "Picking" - hindi na dumadaan sa "Pack". Parehong SO+Item+SKU na
										// pagtugma sa Item_Details1 subform ng Sales_Order_Fulfillment, parehong "bump lang kung
										// hindi pa ito ang stage" na guard para hindi paulit-ulit tumakbo sa ibang edit.
										sofMatches2 = Sales_Order_Fulfillment[SO_No == soVal];
										for each  sofRec2 in sofMatches2
										{
											sofFullList2 = Sales_Order_Fulfillment[ID == sofRec2.ID];
											for each  sofFull2 in sofFullList2
											{
												sofFound2 = false;
												for each  sofRow2 in sofFull2.Item_Details1
												{
													if(sofRow2.Item + "" == input.Item_Name + "" && sofRow2.SKU + "" == skuVal)
													{
														sofFound2 = true;
													}
												}
												if(sofFound2 == true && sofFull2.Fulfillment_Stage != "Quality Checking")
												{
													update sofFull2
													[
														Fulfillment_Stage="Quality Checking"
													];
													info "Fulfillment_Stage updated to Quality Checking for SO " + soVal + " / SKU " + skuVal;
												}
											}
										}
						)
					}
				}

			}
