			DMS_Site_Confirmation_Fol as "DMS_Site_Confirmation_FollowUp"
			{
				type =  schedule
					status = inactive
				start = "2026-07-17 06:00:00"
				frequency = daily
				time zone = "Asia/Manila"
				on start
				{
					actions 
					{
					on load
					(
						followupWaitDays = 3;
										maxAttempts = 2;
										p1 = Policy_Settings[Policy_Key == "followup_wait_days"];
										if(p1 != null && p1.Value != null && p1.Value != "")
										{
											followupWaitDays = p1.Value.toLong();
										}
										p2 = Policy_Settings[Policy_Key == "max_followup_attempts"];
										if(p2 != null && p2.Value != null && p2.Value != "")
										{
											maxAttempts = p2.Value.toLong();
										}
										pendingRecs = Service_Appointment_Form[Site_Confirmation_Status == "Pending" || Site_Confirmation_Status == "Not Ready" && Outreach_Sent_Date != null];
										for each  r in pendingRecs
										{
											daysSince = zoho.currentdate.daysBetween(r.Outreach_Sent_Date);
											if(daysSince >= followupWaitDays)
											{
												if(r.Followup_Count >= maxAttempts)
												{
													r.Site_Confirmation_Status="Unreachable";
													r.Exception_Status="Flagged";
													custNameU = "";
													if(r.Customer_Name != null)
													{
														custNameU = r.Customer_Name.first_name + " " + r.Customer_Name.last_name;
													}
													// No dedup guard needed — this branch is self-terminating: once status
													// flips to Unreachable, the record falls out of pendingRecs' own filter
													// (Pending/Not Ready only) on every future daily run.
													insert into DMS_Exception_Queue
													[
														Sales_Order_Reference=r.ID
														Customer_Name=custNameU
														Exception_Stage="Site Confirmation"
														Exception_Reason="Customer unreachable after max attempts"
														Severity="High"
														Raised_By="System"
														Date_Raised=zoho.currenttime
														Status="Open"
														Added_User=zoho.loginuser
													]
												}
												else
												{
													custName = "";
													if(r.Customer_Name != null)
													{
														custName = r.Customer_Name.first_name + " " + r.Customer_Name.last_name;
													}
													followupMsg = "Hi " + custName + ", just checking if your delivery site is now ready for " + r.Sales_Order + ". Please let us know.";
													// CHANGED 2026-08-26, per user ("use email only for now") — same email-first
													// flip as Action 1 above. A phone-only record can only reach this scan if it
													// already has an Outreach_Sent_Date (i.e. it got here with an email at least
													// once before) — a phone-only record with NO email never enters pendingRecs
													// at all (that query requires Outreach_Sent_Date != null), so there's no
													// phone-only branch to handle here the way Action 1 needed one.
													if(r.Email != null && r.Email != "")
													{
														sendmail
														[
															from :zoho.adminuserid
															to :r.Email
															subject :"Delivery Confirmation Follow-Up — " + r.Sales_Order
															message :followupMsg
														]
														info "[Email FOLLOWUP] Sent to: " + r.Email;
													}
													else
													{
														// Shouldn't normally happen (see comment above) but fail safe rather than
														// silently burning a Followup_Count attempt with no real send.
														info "[SITE CONFIRMATION FOLLOWUP] No email on file for record " + r.ID + " (" + r.Sales_Order + ") — skipping this cycle.";
													}
													r.Outreach_Sent_Date=zoho.currentdate;
													r.Followup_Count=r.Followup_Count + 1;
												}
											}
										}
					)
					}
				}
			}
			Daily_Shipment_10_Day_Che as "Daily Shipment 10-Day Check"
			{
				type =  schedule
				start = "2026-07-31 08:00:00"
				frequency = daily
				time zone = "Asia/Manila"
				on start
				{
					actions 
					{
					on load
					(
						shipments = Shipments[Notified_10d == false];
										for each  s in shipments
										{
											if(s.Remaining_Days <= 10)
											{
												insert into App_Notifications
												[
													Recipient_Email="homecartelpacker@gmail.com"
													Notification_Type="Shipment"
													Message="Shipment " + s.Shipment_No + " has " + s.Remaining_Days + " day(s) left on its timeline."
													Created_On=zoho.currenttime
													Target_URL="https://creatorapp.zoho.com/homecartel/environment/development/supply-chain-app/#Page:Shipments1"
													Source_Record_No=s.Shipment_No
													Source_Record_ID=s.ID
													Added_User=zoho.loginuser
												]
												update s
												[
													Notified_10d=true
												];
											}
										}
					)
					}
				}
			}
			Shipment_Delay_Status_Dai as "Shipment_Delay_Status_Daily"
			{
				type =  schedule
				start = "2026-08-04 08:00:00"
				frequency = daily
				time zone = "Asia/Manila"
				on start
				{
					actions 
					{
					on load
					(
						todayVal = zoho.currentdate;
										usingOverride = false;
										settingsRec = Schedule_Test_Settings[ID != 0];
										for each  s in settingsRec
										{
											if(s.Test_Current_Date != null)
											{
												todayVal = s.Test_Current_Date;
												usingOverride = true;
											}
										}
										delayedCount = 0;
										arrivingCount = 0;
										skippedDelivered = 0;
										checkedCount = 0;
										allShips = Shipments[ID != 0];
										for each  sh in allShips
										{
											if(sh.Shipment_Status == "Delivered")
											{
												skippedDelivered = skippedDelivered + 1;
											}
											else if(sh.Estimated_Warehouse_Arrival != null)
											{
												checkedCount = checkedCount + 1;
												diffMs = (sh.Estimated_Warehouse_Arrival - todayVal);
												diffDays = (diffMs / 86400000).round(0);
												if(diffDays < 0)
												{
													if(sh.Shipment_Status != "Delayed")
													{
														sh.Shipment_Status="Delayed";
													}
													delayedCount = delayedCount + 1;
												}
												else if(diffDays <= 7)
												{
													if(sh.Shipment_Status != "Arriving in 1 Week")
													{
														sh.Shipment_Status="Arriving in 1 Week";
													}
													arrivingCount = arrivingCount + 1;
												}
											}
										}
					)
					}
				}
			}
			Forecast_Stamp_Daily as "Forecast_Stamp_Daily"
			{
				type =  schedule
				start = "2026-11-04 01:00:00"
				frequency = daily
				time zone = "Asia/Manila"
				on start
				{
					actions 
					{
					on load
					(
						/* ============================================================================
										   1. SETTINGS — isang beses lang, may fallback sa spec ng user
										   ============================================================================ */
										/* Isang record lang ang binabasa — ang UNA. Kung higit sa isa ang nasa form, ang una
										   ang mananalo at tahimik na babalewalain ang iba; kaya isa lang ang gawin.
										
										   Kung WALA pang record, ang mga default sa ibaba ang gagamitin — ang mismong spec mo
										   noong 2026-10-30. Tumatakbo pa rin ang script, hindi lang gagalaw ang mga numero
										   hangga't hindi ka pa nagsa-save ng record.
										
										   Apat ang walang min/max sa form (Prep, Delivery, Local Transit, Local Customs):
										   isang numero lang ang kanila, kaya pareho ang min at max. Walang nawawala — pareho
										   naman ang min at max ng apat na iyon sa orihinal na spec (7/7, 0/0, 0/0, 0/0). */
										airTMin = 5;
										airTMax = 7;
										airCMin = 2;
										airCMax = 3;
										lclTMin = 35;
										lclTMax = 60;
										lclCMin = 7;
										lclCMax = 10;
										fclTMin = 35;
										fclTMax = 60;
										fclCMin = 7;
										fclCMax = 10;
										locTMin = 0;
										locTMax = 0;
										locCMin = 0;
										locCMax = 0;
										prepMin = 7;
										prepMax = 7;
										delMin = 0;
										delMax = 0;
										reAnchor = true;
										addSupLead = false;
										fsTaken = false;
										fsRecs = Forecast_Settings[ID != 0];
										for each  fs in fsRecs
										{
											if(!fsTaken)
											{
												fsTaken = true;
												if(fs.Air_Transit_Min != null)
												{
													airTMin = fs.Air_Transit_Min.toLong();
												}
												if(fs.Air_Transit_Max != null)
												{
													airTMax = fs.Air_Transit_Max.toLong();
												}
												if(fs.Air_Customs_to_WH_Min != null)
												{
													airCMin = fs.Air_Customs_to_WH_Min.toLong();
												}
												if(fs.Air_Customs_to_WH_Max != null)
												{
													airCMax = fs.Air_Customs_to_WH_Max.toLong();
												}
												if(fs.LCL_Transit_Min != null)
												{
													lclTMin = fs.LCL_Transit_Min.toLong();
												}
												if(fs.LCL_Transit_Max != null)
												{
													lclTMax = fs.LCL_Transit_Max.toLong();
												}
												if(fs.LCL_Customs_to_WH_Min != null)
												{
													lclCMin = fs.LCL_Customs_to_WH_Min.toLong();
												}
												if(fs.LCL_Customs_to_WH_Max != null)
												{
													lclCMax = fs.LCL_Customs_to_WH_Max.toLong();
												}
												if(fs.FCL_Transit_Min != null)
												{
													fclTMin = fs.FCL_Transit_Min.toLong();
												}
												if(fs.FCL_Transit_Max != null)
												{
													fclTMax = fs.FCL_Transit_Max.toLong();
												}
												if(fs.FCL_Customs_to_WH_Min != null)
												{
													fclCMin = fs.FCL_Customs_to_WH_Min.toLong();
												}
												if(fs.FCL_Customs_to_WH_Max != null)
												{
													fclCMax = fs.FCL_Customs_to_WH_Max.toLong();
												}
												if(fs.Local_Transit_Days != null)
												{
													locTMin = fs.Local_Transit_Days.toLong();
													locTMax = fs.Local_Transit_Days.toLong();
												}
												if(fs.Local_Customs_Days != null)
												{
													locCMin = fs.Local_Customs_Days.toLong();
													locCMax = fs.Local_Customs_Days.toLong();
												}
												if(fs.Prep_Days_Thru_QC != null)
												{
													prepMin = fs.Prep_Days_Thru_QC.toLong();
													prepMax = fs.Prep_Days_Thru_QC.toLong();
												}
												if(fs.Delivery_Days != null)
												{
													delMin = fs.Delivery_Days.toLong();
													delMax = fs.Delivery_Days.toLong();
												}
												/* Checkbox: sa Deluge pwede itong dumating bilang boolean o bilang text
												   depende sa paraan ng pagbasa, kaya pareho ang hinahawakan dito. Ang laman
												   ng record ang SUMUSUNOD, hindi ang default sa itaas — kung hindi, kasinungalingan
												   ang checkbox. Kaya kung HINDI naka-check ang Re-anchor sa record mo, patay ito. */
												chk = fs.Re_anchor_on_Latest_Real_Event.toString().toLowerCase();
												reAnchor = chk == "true";
												chk = fs.Include_Supplier_Lead_Time.toString().toLowerCase();
												addSupLead = chk == "true";
											}
										}
										today = zoho.currentdate;
										/* Parehong manual-test override na ginagamit ng shipment_delay_status_schedule, para
										   pwedeng i-test ang forecast sa ibang petsa nang hindi hinihintay ang bukas.
										
										   >>> ITO ANG UNANG BURAHIN KUNG AYAW MAG-SAVE NG SCRIPT. <<<
										   Burahin ang 9 na linya mula `settingsRec = ...` hanggang sa pangalawang `}` sa ibaba.
										   Hindi ito kailangan ng forecast — testing convenience lang ito.
										
										   Bakit: kailangan nitong EXISTING na ang `Schedule_Test_Settings` form. Nasa repo ang
										   definition niya (`DelugeScripts\schedule_test_settings_form.txt`) at prerequisite siya
										   ng `shipment_delay_status_schedule`, pero HINDI ko makumpirma na talagang nagawa na
										   siya sa Creator. Kung hindi pa, "Variable Schedule_Test_Settings does not exist" ang
										   isasabi ng editor — at nakakalito iyon, kasi parang problema sa forecast ang dating
										   pero wala namang kinalaman. Burahin lang, o gawin ang form, bahala ka. */
										settingsRec = Schedule_Test_Settings[ID != 0];
										for each  s in settingsRec
										{
											if(s.Test_Current_Date != null)
											{
												today = s.Test_Current_Date;
											}
										}
										/* ============================================================================
										   2. SHIPMENT INDEX — isang pass lang sa Shipments, para hindi na kailangan ng
										      subform criteria (mapagkakatiwalaan ang iteration, hindi ang
										      `Shipments[Supplier_Shipment_Details.PR_No == x]`).
										
										      Para sa isang PR, ang PINAKAUNANG Date_Shipped ang panalo — kapag umalis na
										      ang unang linya, nagsimula nang gumalaw ang order.
										   ============================================================================ */
										shipIdByPr = Map();
										shipDateByPr = Map();
										shipStatusByPr = Map();
										shipModeByPr = Map();
										allShips = Shipments[ID != 0];
										rawShipCount = 0;
										for each  sh in allShips
										{
											rawShipCount = rawShipCount + 1;
											for each  srow in sh.Supplier_Shipment_Details
											{
												if(srow.PR_No != null && srow.PR_No != "")
												{
													pk = srow.PR_No + "";
													/* FIXED 2026-11-04, nakita sa live na form definition ng Shipments:
													   ang Supplier_Shipment_Details.Date_Shipped ay plain TEXT, hindi Date.
													   (Ginagawa itong string ng supplier_shipment_sync: `row.Date_Shipped + ""`,
													   kahit tunay na Date field ang pinanggalingan sa supplier portal.)
										
													   Dalawang sira kung text ang iiwan:
													   1. LEXICOGRAPHIC ang string comparison, kaya "30-Jan-2026" ay lalabas na
													      mas malaki kaysa "05-Feb-2026" — maling shipment ang mapipili bilang
													      pinakauna, kaya maling anchor at maling petsa ang forecast.
													   2. Dumadaan sa .addDay() ang anchor mamaya, at hindi iyon gumagana sa text.
										
													   Kaya isang beses lang itong ginagawang tunay na date, dito sa index.
													   Kung hindi mabasa, null — nawawala lang ang pag-anchor para sa PR na iyon,
													   hindi bumabagsak ang buong run. Ang tanging mapagkukunan ng hindi mabasang
													   halaga ay manual na pag-type sa grid; ang sync mismo ay laging naglalagay
													   ng format ng app. */
													dsVal = null;
													if(srow.Date_Shipped != null && srow.Date_Shipped != "")
													{
														dsVal = srow.Date_Shipped.toDate();
													}
													takeIt = false;
													if(!shipIdByPr.containKey(pk))
													{
														takeIt = true;
													}
													else if(dsVal != null)
													{
														if(shipDateByPr.get(pk) == null)
														{
															takeIt = true;
														}
														else if(dsVal < shipDateByPr.get(pk))
														{
															takeIt = true;
														}
													}
													if(takeIt)
													{
														shipIdByPr.put(pk,sh.ID);
														shipDateByPr.put(pk,dsVal);
														shipStatusByPr.put(pk,sh.Shipment_Status + "");
														/* FIXED 2026-11-04 mula sa live na form definition: WALANG
														   header-level na Shipment_Mode ang Shipments. `sh.Shipment_Mode`
														   ang nakalagay dito dati — compile error iyon ("Shipment_Mode does
														   not exist"), hindi na sana magsa-save ang buong script.
										
														   Ang tanging mode sa Shipments ay nasa mga subform row:
														   Supplier_Shipment_Details.Shipment_Mode (ito) at
														   PO_Shipments.Shipping_Mode (ibang grid, hindi ito nililoop dito).
														   Kaya blangko ang panimula; kung blangko pa rin pagkatapos, ang
														   PR.Shipment_Mode naman ang gagamitin sa ibaba, at kung wala rin,
														   LCL ang assumption na may `assumed` flag. */
														modeHere = "";
														if(srow.Shipment_Mode != null && srow.Shipment_Mode != "")
														{
															modeHere = srow.Shipment_Mode + "";
														}
														shipModeByPr.put(pk,modeHere);
													}
												}
											}
										}
										/* ============================================================================
										   3. MAIN PASS — bawat Sales Order Fulfillment record
										   ============================================================================ */
										sofCount = 0;
										stampCount = 0;
										noDateCount = 0;
										allSof = Sales_Order_Fulfillment[ID != 0];
										rawSofCount = 0;
										/* HINDI "" ang panimula: kung "" ang SO_No ng kauna-unahang row ay lalaktawan
										   ang if at hindi pa definido ang gateRecs - "Variable 'gateRecs' is not
										   defined". */
										cacheSo = "~wala~";
										/* ROLL-UP para sa mga ORDER-LEVEL na form (Receiving, Order_Aggregation1,
										   Service_Request1, Service_Appointment_Form). Walang SKU ang mga iyon - isang
										   record sila kada order o kada package, kaya hindi sila pwedeng per item.
										   Ang panuntunan ay PAREHO ng delivery leg: ang PINAKAHULING petsa sa lahat ng
										   item ang nananalo, at `Will Miss` kung kahit isang item lang ang hindi
										   aabot. Hindi maihahatid ang order hangga't hindi dumarating ang huling item.
										   DATI: kung sinong row ang huling tumakbo, iyon ang naitatak - kaya ang isang
										   order na may item sa bodega at item na nasa China pa ay pwedeng magpakita ng
										   petsa ng nasa bodega. */
										soTouched = Map();
										soBest = Map();
										soBestWin = Map();
										soWorst = Map();
										soWorstRank = Map();
										for each  sof in allSof
										{
											rawSofCount = rawSofCount + 1;
											sofCount = sofCount + 1;
											soNo = sof.SO_No + "";
											prNo = sof.PR_No + "";
											stage = sof.Fulfillment_Stage + "";
											/* ====================================================================
											   PER ITEM (2026-11-06, per user: "dapat per item yung forecast nito").
											   Isang SOF record = ISANG ITEM (so_fulfillment_sync: isang record kada
											   SKU). Kaya ang pagkakakilanlan ng row na ito ay PR_No + SKU, hindi ang
											   SO. Ang `prNo` ay pwedeng dumating na literal na "null" na string mula
											   sa `+ ""` sa blangkong field - hindi iyon nahuhuli ng `!= ""`.
											   ==================================================================== */
											if(prNo == null)
											{
												prNo = "";
											}
											prNo = prNo.trim();
											if(prNo == "null")
											{
												prNo = "";
											}
											hasPr = prNo != "";
											/* Walang sariling SKU field ang SOF. Nasa `SO_SKU_Key` ito, na ginawa ng
											   syncpackagetofulfillment bilang `<SO>_<SKU>` (linya 719). Tinatanggal
											   ang `<SO>_` na unahan para SKU-sa-SKU ang paghahambing, at
											   ini-normalize: TRIM, UPPERCASE, at tinatanggal ang "SKU:" na unahan na
											   nakikita sa ilang Gate row (hal. "SKU: KB314-3-B"). */
											sofKey = sof.SO_SKU_Key + "";
											if(sofKey == null)
											{
												sofKey = "";
											}
											sofKey = sofKey.trim();
											if(sofKey == "null")
											{
												sofKey = "";
											}
											sofSku = "";
											if(sofKey != "")
											{
												sofSku = sofKey;
												if(soNo != "")
												{
													sofSku = sofSku.replaceFirst(soNo + "_","");
												}
												sofSku = sofSku.trim().toUpperCase();
												if(sofSku.startsWith("SKU:"))
												{
													sofSku = sofSku.replaceFirst("SKU:","").trim();
												}
											}
											/* STOCK ON HAND: nasa Fulfillment na ang order at hindi ito pre-order,
											   kaya WALA NANG import leg — prep + delivery na lang ang natitira.
											   Dati ay hindi man lang binabasa ang order_type, kaya ang Normal order na
											   nasa "Waiting For Package" ay binibigyan pa rin ng 35–60 araw na biyahe
											   para sa stock na nasa bodega na. (User, 2026-11-04.)
											   Ang "(Partly) Pre Order" ay pre-order pa rin: may linyang kailangan pang
											   iprodyus at ipadala, kaya ang mas mahabang sagot ang totoo. */
											otype = (sof.order_type + "").toUpperCase();
											/* DATI: `stockOnHand = !otype.contains("PRE ORDER")` - ang ORDER ang
											   tinatanong, hindi ang ITEM. Sa "(Partly) Pre Order" ay may linyang nasa
											   bodega na at may linyang nasa China pa; pareho silang binibigyan ng
											   42-70 araw.
											   NGAYON: "may PR ba ANG LINYANG ITO?". Gumagawa lang ng PR ang so_to_pr
											   kapag `availStock <= 0` (linya 149), kaya ang BLANGKONG PR_No ay ibig
											   sabihin nasa bin na ang item - prep + delivery na lang.
											   Walang nababago sa Normal (lahat blangko) at sa buong Pre Order (lahat
											   may PR). Ang partly lang ang gumagalaw - at ang Normal na naubusan ng
											   stock, na may tunay na import leg at dati ay prep-only ang sagot. */
											stockOnHand = !hasPr;
											clientTarget = sof.target_delivery_date;
											/* -- 3a. Galing sa PR: ang simula ng chain, at ang sourcing/mode -------- */
											prAdded = null;
											sourcing = "";
											supLead = 0;
											modeVal = sof.Shipment_Mode + "";
											if(prNo != null && prNo != "")
											{
												/* `for each`, hindi `if(... != null)`. Ang Form[criteria] na walang
												   katugma ay nagbabalik ng WALANG-LAMANG RECORD, hindi null — kaya
												   dumadaan ang null check, blangko ang Added_Time, at bumabagsak ang
												   `.toDate()` ng buong takbo: "Value is empty and 'toDate' function
												   cannot be applied" (live, 2026-11-04). Sa for-each, hindi tumatakbo
												   ang loob kapag walang row. Ito rin ang ginagamit ng 11 stamp block.
										
												   Sapat na ang isang PR: iisa lang ang simula ng chain. */
												prRecs = Purchase_Request1[PR_No == prNo];
												prTaken = false;
												for each  prRec in prRecs
												{
													if(!prTaken)
													{
														prTaken = true;
														if(prRec.Added_Time != null)
														{
															prAdded = prRec.Added_Time.toDate();
														}
														sourcing = prRec.Sourcing_Type + "";
														if(prRec.Required_Days_Lead != null)
														{
															supLead = prRec.Required_Days_Lead.toLong();
														}
														if(modeVal == null || modeVal == "")
														{
															modeVal = prRec.Shipment_Mode + "";
														}
													}
												}
											}
											/* Walang PR? Ang SO_Created_Date na lang ang simula — mas mabuti pa rin kaysa
											   walang forecast. Nakikita naman sa Forecast_Window kung saan nag-anchor. */
											if(prAdded == null)
											{
												if(sof.SO_Created_Date != null)
												{
													prAdded = sof.SO_Created_Date;
												}
											}
											/* -- 3b. Galing sa Shipment ---------------------------------------------- */
											dateShipped = null;
											shipStatus = "";
											shipId = null;
											if(prNo != null && prNo != "")
											{
												if(shipIdByPr.containKey(prNo))
												{
													shipId = shipIdByPr.get(prNo);
													dateShipped = shipDateByPr.get(prNo);
													shipStatus = shipStatusByPr.get(prNo) + "";
													if(modeVal == null || modeVal == "")
													{
														modeVal = shipModeByPr.get(prNo) + "";
													}
												}
											}
											/* -- 3c. Mga stage record: kinukuha na rin dito para gamitin BOTH sa
											          pag-alam kung kailan nagsimula ang prep AT sa pagtatatak mamaya.
											          Isang fetch lang kada form, walang dagdag na query. ------------- */
											/* ISANG fetch kada SO, hindi kada ITEM. Magkakasunod ang mga SOF row ng
											   iisang SO (sabay silang ginawa), kaya sapat na ang paghahambing sa huling
											   SO para mawala ang 5 query sa bawat dagdag na item. Kung mahiwalay man
											   ang isang row (item na idinagdag mamaya), mag-fe-fetch lang ulit - tama
											   pa rin, mabagal lang nang kaunti. Ito ang pinakamalaking ginagastos ng
											   schedule: sa 5 item kada SO, 25 query ang nagiging 5. */
											if(soNo != cacheSo)
											{
												cacheSo = soNo;
												gateRecs = Sales_Order_Readiness_Gate[sales_order_number == soNo];
												pickRecs = Pick1[SO == soNo];
												qcRecs = Checker_Checklist[SO == soNo];
												oaRecs = Order_Aggregation1[SO == soNo];
												crateRecs = Crate_Checklist[SO == soNo];
											}
											/* ------------------------------------------------------------------------
											   3c-bis. MAY SKU BA ANG FORM NA ITO PARA SA ITEM NA ITO?
											   Isang pasada sa memorya (walang query) kada form. Kung may katugmang
											   SKU, SKU ang gagamiting pagtutugma - tunay na per item. Kung WALA -
											   dahil iba ang pagkakasulat ng SKU doon o blangko - babalik sa dating
											   PR_No / SO-wide na pagtutugma, kaya WALANG row na mawawalan ng forecast
											   dahil sa pagbabagong ito. Hindi pwedeng mas masama kaysa sa dati.
											   ------------------------------------------------------------------------ */
											gSkuHit = false;
											if(sofSku != "")
											{
												for each  gA in gateRecs
												{
													gASku = (gA.SKU + "").trim().toUpperCase();
													if(gASku == "NULL")
													{
														gASku = "";
													}
													if(gASku.startsWith("SKU:"))
													{
														gASku = gASku.replaceFirst("SKU:","").trim();
													}
													if(gASku == sofSku)
													{
														gSkuHit = true;
													}
												}
											}
											pSkuHit = false;
											if(sofSku != "")
											{
												for each  pA in pickRecs
												{
													pASku = (pA.SKU + "").trim().toUpperCase();
													if(pASku == "NULL")
													{
														pASku = "";
													}
													if(pASku.startsWith("SKU:"))
													{
														pASku = pASku.replaceFirst("SKU:","").trim();
													}
													if(pASku == sofSku)
													{
														pSkuHit = true;
													}
												}
											}
											qSkuHit = false;
											if(sofSku != "")
											{
												for each  qA in qcRecs
												{
													qASku = (qA.SKU + "").trim().toUpperCase();
													if(qASku == "NULL")
													{
														qASku = "";
													}
													if(qASku.startsWith("SKU:"))
													{
														qASku = qASku.replaceFirst("SKU:","").trim();
													}
													if(qASku == sofSku)
													{
														qSkuHit = true;
													}
												}
											}
											cSkuHit = false;
											if(sofSku != "")
											{
												for each  cA in crateRecs
												{
													cASku = (cA.SKU + "").trim().toUpperCase();
													if(cASku == "NULL")
													{
														cASku = "";
													}
													if(cASku.startsWith("SKU:"))
													{
														cASku = cASku.replaceFirst("SKU:","").trim();
													}
													if(cASku == sofSku)
													{
														cSkuHit = true;
													}
												}
											}
											/* prepStart ay NAGSISIMULA SA PETSA, hindi sa null. Ang null-initialised na
											   variable ay walang type, kaya hindi mahanap ng Deluge ang .daysBetween()
											   dito: "Not able to find 'daysBetween' function" (live, 2026-11-04).
											   Ang kahulugang "wala pang nakitang prep" ay nasa prepFound na. */
											prepStart = today;
											prepFound = false;
											for each  g in gateRecs
											{
												matchG = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												gSku = (g.SKU + "").trim().toUpperCase();
												if(gSku == "NULL")
												{
													gSku = "";
												}
												if(gSku.startsWith("SKU:"))
												{
													gSku = gSku.replaceFirst("SKU:","").trim();
												}
												if(gSkuHit)
												{
													if(gSku != sofSku)
													{
														matchG = false;
													}
												}
												else if(hasPr && g.pr_number != null && g.pr_number != "" && g.pr_number != prNo)
												{
													matchG = false;
												}
												if(matchG)
												{
													/* I-null muna: kondisyonal na ang assignment sa loob ng loop, kaya
													   kung blangko ang Added_Time ng row na ito ay magagamit sana ulit
													   ang petsa ng NAKARAANG row — at sa kauna-unahang row ay wala pang
													   laman ang variable. */
													gd = null;
													if(g.Added_Time != null)
													{
														gd = g.Added_Time.toDate();
													}
													if(gd != null)
													{
														if(!prepFound || gd < prepStart)
														{
															prepStart = gd;
															prepFound = true;
														}
													}
												}
											}
											for each  p in pickRecs
											{
												matchP = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												pSku = (p.SKU + "").trim().toUpperCase();
												if(pSku == "NULL")
												{
													pSku = "";
												}
												if(pSku.startsWith("SKU:"))
												{
													pSku = pSku.replaceFirst("SKU:","").trim();
												}
												if(pSkuHit)
												{
													if(pSku != sofSku)
													{
														matchP = false;
													}
												}
												else if(hasPr && p.PR_if_any != null && p.PR_if_any != "" && p.PR_if_any != prNo)
												{
													matchP = false;
												}
												if(matchP)
												{
													/* I-null muna: kondisyonal na ang assignment sa loob ng loop, kaya
													   kung blangko ang Added_Time ng row na ito ay magagamit sana ulit
													   ang petsa ng NAKARAANG row — at sa kauna-unahang row ay wala pang
													   laman ang variable. */
													pd = null;
													if(p.Added_Time != null)
													{
														pd = p.Added_Time.toDate();
													}
													if(pd != null)
													{
														if(!prepFound || pd < prepStart)
														{
															prepStart = pd;
															prepFound = true;
														}
													}
												}
											}
											for each  q in qcRecs
											{
												matchQ = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												qSku = (q.SKU + "").trim().toUpperCase();
												if(qSku == "NULL")
												{
													qSku = "";
												}
												if(qSku.startsWith("SKU:"))
												{
													qSku = qSku.replaceFirst("SKU:","").trim();
												}
												if(qSkuHit)
												{
													if(qSku != sofSku)
													{
														matchQ = false;
													}
												}
												else if(hasPr && q.PR != null && q.PR != "" && q.PR != prNo)
												{
													matchQ = false;
												}
												if(matchQ)
												{
													/* I-null muna: kondisyonal na ang assignment sa loob ng loop, kaya
													   kung blangko ang Added_Time ng row na ito ay magagamit sana ulit
													   ang petsa ng NAKARAANG row — at sa kauna-unahang row ay wala pang
													   laman ang variable. */
													qd = null;
													if(q.Added_Time != null)
													{
														qd = q.Added_Time.toDate();
													}
													if(qd != null)
													{
														if(!prepFound || qd < prepStart)
														{
															prepStart = qd;
															prepFound = true;
														}
													}
												}
											}
											for each  c in crateRecs
											{
												matchC = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												cSku = (c.SKU + "").trim().toUpperCase();
												if(cSku == "NULL")
												{
													cSku = "";
												}
												if(cSku.startsWith("SKU:"))
												{
													cSku = cSku.replaceFirst("SKU:","").trim();
												}
												if(cSkuHit)
												{
													if(cSku != sofSku)
													{
														matchC = false;
													}
												}
												else if(hasPr && c.PR_if_any != null && c.PR_if_any != "" && c.PR_if_any != prNo)
												{
													matchC = false;
												}
												if(matchC)
												{
													/* I-null muna: kondisyonal na ang assignment sa loob ng loop, kaya
													   kung blangko ang Added_Time ng row na ito ay magagamit sana ulit
													   ang petsa ng NAKARAANG row — at sa kauna-unahang row ay wala pang
													   laman ang variable. */
													cd = null;
													if(c.Added_Time != null)
													{
														cd = c.Added_Time.toDate();
													}
													if(cd != null)
													{
														if(!prepFound || cd < prepStart)
														{
															prepStart = cd;
															prepFound = true;
														}
													}
												}
											}
											/* ------------------------------------------------------------------------
											   3d. ANG ENGINE. Nandito lang ito ISANG BESES sa buong script — walang
											       kopya, kaya walang pwedeng mag-drift.
											   ------------------------------------------------------------------------ */
											modeKey = modeVal.toUpperCase();
											srcKey = sourcing.toUpperCase();
											if(srcKey == "LOCAL")
											{
												tMin = locTMin;
												tMax = locTMax;
												cMin = locCMin;
												cMax = locCMax;
												bucket = "Local";
											}
											else if(modeKey.contains("AIR"))
											{
												tMin = airTMin;
												tMax = airTMax;
												cMin = airCMin;
												cMax = airCMax;
												bucket = "Air";
											}
											else if(modeKey == "FCL")
											{
												tMin = fclTMin;
												tMax = fclTMax;
												cMin = fclCMin;
												cMax = fclCMax;
												bucket = "FCL";
											}
											else
											{
												/* Blanko o hindi kilalang mode: LCL ang ipinapalagay (iyon ang karaniwan
												   dito), pero sinasabi ito sa Forecast_Window para walang mabigla. */
												tMin = lclTMin;
												tMax = lclTMax;
												cMin = lclCMin;
												cMax = lclCMax;
												bucket = "LCL";
												if(modeKey != "LCL")
												{
													bucket = "LCL?";
												}
											}
											/* Nagsisimula sa PETSA, hindi sa null: ang null-initialised na variable ay
											   walang type, kaya hindi mahanap ng Deluge ang .addDay() dito — "Not able
											   to find ... function". Ang kahulugang "walang mapagsisimulan" ay nasa
											   anchorFound na. */
											anchor = today;
											anchorFound = false;
											sumMin = 0;
											sumMax = 0;
											position = "";
											if(reAnchor && stage == "For Delivery")
											{
												anchor = today;
												anchorFound = true;
												sumMin = delMin;
												sumMax = delMax;
												position = "Ready";
											}
											else if(reAnchor && stage == "Order Readiness" || stage == "Picking" || stage == "Pack" || stage == "Quality Checking" || stage == "Crate")
											{
												anchor = today;
												anchorFound = true;
												usedDays = 0;
												if(prepFound)
												{
													/* Ang (petsa - petsa) sa Deluge na ito ay STRING, kahit ilagay pa sa variable —
													   tinanggihan ng live editor ang parehong anyo noong 2026-11-04. Kaya
													   .daysBetween() na lang, na deretsong araw ang ibinabalik at matagal nang
													   gumagana sa app na ito (dms_site_confirmation.txt).
													   Hindi umaasa sa sign convention ng daysBetween: kinukuha ang laki, saka
													   pinipilit na positibo. */
													usedDays = prepStart.daysBetween(today);
													if(usedDays < 0)
													{
														usedDays = usedDays * -1;
													}
												}
												if(usedDays < 0)
												{
													usedDays = 0;
												}
												leftMin = prepMin - usedDays;
												if(leftMin < 0)
												{
													leftMin = 0;
												}
												leftMax = prepMax - usedDays;
												if(leftMax < 0)
												{
													leftMax = 0;
												}
												sumMin = leftMin + delMin;
												sumMax = leftMax + delMax;
												position = stage;
											}
											else if(stockOnHand)
											{
												/* HINDI nakasalalay sa Re-anchor: ang re-anchor ay tungkol sa KUNG SAAN
												   magsisimulang magbilang, ito ay tungkol sa ALING LEG ang umiiral. */
												anchor = today;
												anchorFound = true;
												sumMin = prepMin + delMin;
												sumMax = prepMax + delMax;
												position = "Stock on hand";
											}
											else if(reAnchor && shipStatus == "Delivered")
											{
												anchor = today;
												anchorFound = true;
												sumMin = prepMin + delMin;
												sumMax = prepMax + delMax;
												position = "At WH";
											}
											else if(reAnchor && dateShipped != null)
											{
												anchor = dateShipped;
												anchorFound = true;
												sumMin = tMin + cMin + prepMin + delMin;
												sumMax = tMax + cMax + prepMax + delMax;
												position = "In transit";
											}
											else
											{
												/* prAdded PWEDENG null (walang PR at walang SO_Created_Date). Dati ay
												   nahuhuli iyon ng `if(anchor == null)` sa baba; ngayong flag na ang
												   gamit, dito na dapat tingnan — kung hindi, magiging null ang anchor
												   habang true ang flag, at bumabagsak ang .addDay() sa null. */
												if(prAdded != null)
												{
													anchor = prAdded;
													anchorFound = true;
												}
												sumMin = tMin + cMin + prepMin + delMin;
												sumMax = tMax + cMax + prepMax + delMax;
												if(addSupLead)
												{
													sumMin = sumMin + supLead;
													sumMax = sumMax + supLead;
												}
												position = "Procurement";
											}
											fcDelivery = null;
											fcWindow = "";
											fcStatus = "";
											if(!anchorFound)
											{
												/* Wala talagang mapagsisimulan — huwag mag-imbento ng petsa. */
												fcWindow = "Walang panimulang petsa";
												fcStatus = "No Start Date";
												noDateCount = noDateCount + 1;
											}
											else
											{
												earliest = anchor.addDay(sumMin);
												latest = anchor.addDay(sumMax);
												/* Pwedeng nasa nakaraan na ang buong window kung hindi gumalaw ang order.
												   Totoong balita iyon — lumampas na ang chain sa sarili nitong tantiya —
												   pero hindi tamang magpakita ng delivery na parang nangyari na. Hinihila
												   sa ngayon, at sinasabi sa window. */
												pastIts = false;
												if(latest < today)
												{
													pastIts = true;
												}
												if(earliest < today)
												{
													earliest = today;
												}
												if(latest < today)
												{
													latest = today;
												}
												/* Ang (petsa - petsa) sa Deluge na ito ay STRING, kahit ilagay pa sa variable —
												   tinanggihan ng live editor ang parehong anyo noong 2026-11-04. Kaya
												   .daysBetween() na lang, na deretsong araw ang ibinabalik at matagal nang
												   gumagana sa app na ito (dms_site_confirmation.txt).
												   Hindi umaasa sa sign convention ng daysBetween: kinukuha ang laki, saka
												   pinipilit na positibo. Laging latest >= earliest dito. */
												spanDays = earliest.daysBetween(latest);
												if(spanDays < 0)
												{
													spanDays = spanDays * -1;
												}
												/* fcDate, hindi fcDelivery, ang ipinapasa sa daysBetween sa ibaba.
												   Nagsisimula ang fcDelivery bilang `null`, kaya hindi mapatunayan ng Deluge
												   na DATE ito kapag ARGUMENTO na — "Data type of argument at index '1' of the
												   function 'daysBetween' did not match ... '[DATE-TIME, DATE]'" (live, 2026-11-04).
												   Ang fcDate ay galing lang sa .addDay(), kaya tiyak na DATE.
												   MALI ang naunang akala ko na mapagparaya ang receiver position — pareho
												   silang mahigpit; isa-isa lang iniuulat ng compiler. Nananatiling
												   null-hanggang-makuha ang
												   fcDelivery dahil kailangan iyon ng mga stamp guard: hindi dapat
												   mabura ng walang-lamang forecast ang naitatak nang petsa. */
												fcDate = earliest.addDay((spanDays / 2).round(0).toLong());
												fcDelivery = fcDate;
												fcWindow = earliest.toString("MMM dd") + " - " + latest.toString("MMM dd, yyyy") + " | " + bucket + " | " + position;
												if(pastIts)
												{
													fcWindow = fcWindow + " | lampas na sa tantiya";
												}
												/* -- Status laban sa HINIHINTAY NG CLIENT ---------------------------
												   Ang client target ay ang Books SO custom field cf_target_delivery_date,
												   na kinokopya ng so_fulfillment_sync papunta sa target_delivery_date.
												   Kung walang laman, HINDI ito itinuturing na on-time — ibinubukod. */
												if(clientTarget == null)
												{
													fcStatus = "No Client Date";
												}
												else if(today > clientTarget)
												{
													fcStatus = "Overdue";
												}
												else if(latest <= clientTarget)
												{
													fcStatus = "On Track";
												}
												else if(earliest <= clientTarget)
												{
													fcStatus = "At Risk";
												}
												else
												{
													fcStatus = "Will Miss";
												}
												if(clientTarget != null)
												{
													/* Ang (petsa - petsa) sa Deluge na ito ay STRING, kahit ilagay pa sa variable —
													   tinanggihan ng live editor ang parehong anyo noong 2026-11-04. Kaya
													   .daysBetween() na lang, na deretsong araw ang ibinabalik at matagal nang
													   gumagana sa app na ito (dms_site_confirmation.txt).
													   Hindi umaasa sa sign convention ng daysBetween: kinukuha ang laki, saka
													   pinipilit na positibo.
													   Dito MAY KAHULUGAN ang sign (+ = huli, - = maaga), kaya hindi
													   hinuhulaan: ang paghahambing ng petsa ang naglalagay nito. */
													varDays = clientTarget.daysBetween(fcDate);
													if(varDays < 0)
													{
														varDays = varDays * -1;
													}
													if(fcDate < clientTarget)
													{
														varDays = varDays * -1;
													}
													if(varDays > 0)
													{
														fcWindow = fcWindow + " | +" + varDays + "d vs client";
													}
													else if(varDays < 0)
													{
														fcWindow = fcWindow + " | " + varDays * -1 + "d early";
													}
													else
													{
														fcWindow = fcWindow + " | sakto sa client";
													}
												}
											}
											/* ------------------------------------------------------------------------
											   3d-bis. ROLL-UP PER SO - para sa mga form na walang SKU.
											   Ang Receiving, Order_Aggregation1, Service_Request1 at
											   Service_Appointment_Form ay isang record kada order o package, kaya
											   hindi sila pwedeng per item. Ang PINAKAHULING petsa ang nananalo at ang
											   PINAKAMASAMANG status - hindi maihahatid ang order hangga't hindi
											   dumarating ang huling item. Pareho ito ng panuntunan sa delivery leg.
											   ------------------------------------------------------------------------ */
											rowRank = 0;
											if(fcStatus == "No Start Date")
											{
												rowRank = 1;
											}
											else if(fcStatus == "No Client Date")
											{
												rowRank = 2;
											}
											else if(fcStatus == "On Track")
											{
												rowRank = 3;
											}
											else if(fcStatus == "At Risk")
											{
												rowRank = 4;
											}
											else if(fcStatus == "Will Miss")
											{
												rowRank = 5;
											}
											else if(fcStatus == "Overdue")
											{
												rowRank = 6;
											}
											/* Sinasabi ng window kung ALING item ang humihila sa petsa - iyon ang
											   unang tanong tuwing "bakit ganito kalayo ang order na ito?". */
											rowWin = fcWindow;
											if(sofSku != "")
											{
												rowWin = fcWindow + " | item " + sofSku;
											}
											soFresh = false;
											if(!soTouched.containKey(soNo))
											{
												soTouched.put(soNo,"1");
												soFresh = true;
											}
											/* `rollChanged` ang nagpapasya kung sulit pang hawakan ang mga
											   order-level na form. Sa unang item ng SO, oo. Pagkatapos, kapag may
											   bagong pinakahuling petsa o mas masamang status lang. Kaya ang SO na may
											   10 item ay karaniwang 1 beses lang hahawakan ang Receiving/OA/SR/SA,
											   hindi 10. */
											rollChanged = soFresh;
											if(soFresh)
											{
												soBestWin.put(soNo,rowWin);
												soWorst.put(soNo,fcStatus);
												soWorstRank.put(soNo,rowRank);
												if(fcDelivery != null)
												{
													soBest.put(soNo,fcDelivery);
												}
											}
											else
											{
												if(fcDelivery != null)
												{
													if(!soBest.containKey(soNo))
													{
														soBest.put(soNo,fcDelivery);
														soBestWin.put(soNo,rowWin);
														rollChanged = true;
													}
													else
													{
														/* `.toDate()` muna: walang type ang galing sa Map, at tumatanggi
														   ang Deluge sa paghahambing ng DATE sa walang-type (gotcha #27). */
														prevBest = soBest.get(soNo).toDate();
														if(fcDelivery > prevBest)
														{
															soBest.put(soNo,fcDelivery);
															soBestWin.put(soNo,rowWin);
															rollChanged = true;
														}
													}
												}
												prevRank = soWorstRank.get(soNo).toLong();
												if(rowRank > prevRank)
												{
													soWorstRank.put(soNo,rowRank);
													soWorst.put(soNo,fcStatus);
													rollChanged = true;
												}
											}
											/* Nagsisimula sa fcDelivery para tiyak na DATE-o-null ang type, hindi
											   walang-type na null. */
											rollDate = fcDelivery;
											if(soBest.containKey(soNo))
											{
												rollDate = soBest.get(soNo).toDate();
											}
											rollWindow = soBestWin.get(soNo) + "";
											rollStatus = soWorst.get(soNo) + "";
											/* ------------------------------------------------------------------------
											   3e. STAMP — pareho ang tatlong field sa lahat. Laging may `!=` guard bago
											       magsulat: ang write ang mabigat, hindi ang read.
										
											       PER ITEM ang SOF, Purchase_Request1, Gate, Pick1, Checker_Checklist
											       at Crate_Checklist (may SKU sila). ROLL-UP ang Receiving,
											       Order_Aggregation1, Service_Request1 at Service_Appointment_Form.
											   ------------------------------------------------------------------------ */
											// STAMP: Sales_Order_Fulfillment
											if(sof.Forecast_Delivery != fcDelivery)
											{
												sof.Forecast_Delivery=fcDelivery;
											}
											if(sof.Forecast_Window != fcWindow)
											{
												sof.Forecast_Window=fcWindow;
											}
											if(sof.Forecast_Status != fcStatus)
											{
												sof.Forecast_Status=fcStatus;
											}
											stampCount = stampCount + 1;
											// STAMP: Purchase_Request1
											if(prNo != null && prNo != "")
											{
												prStamp = Purchase_Request1[PR_No == prNo];
												for each  pr in prStamp
												{
													if(pr.Forecast_Delivery != fcDelivery)
													{
														pr.Forecast_Delivery=fcDelivery;
													}
													if(pr.Forecast_Window != fcWindow)
													{
														pr.Forecast_Window=fcWindow;
													}
													if(pr.Forecast_Status != fcStatus)
													{
														pr.Forecast_Status=fcStatus;
													}
												}
											}
											// STAMP: Shipments
											if(shipId != null)
											{
												shipStamp = Shipments[ID == shipId];
												for each  shp in shipStamp
												{
													if(shp.Forecast_Delivery != fcDelivery)
													{
														shp.Forecast_Delivery=fcDelivery;
													}
													if(shp.Forecast_Window != fcWindow)
													{
														shp.Forecast_Window=fcWindow;
													}
													if(shp.Forecast_Status != fcStatus)
													{
														shp.Forecast_Status=fcStatus;
													}
												}
											}
											// STAMP: Receiving   (ORDER-LEVEL - roll-up, walang SKU sa header)
											if(rollChanged && soNo != null && soNo != "")
											{
												rcvStamp = Receiving[SO_No == soNo];
												for each  rcv in rcvStamp
												{
													if(rcv.Forecast_Delivery != rollDate)
													{
														rcv.Forecast_Delivery=rollDate;
													}
													if(rcv.Forecast_Window != rollWindow)
													{
														rcv.Forecast_Window=rollWindow;
													}
													if(rcv.Forecast_Status != rollStatus)
													{
														rcv.Forecast_Status=rollStatus;
													}
												}
											}
											// STAMP: Sales_Order_Readiness_Gate
											for each  g2 in gateRecs
											{
												matchG2 = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												g2Sku = (g2.SKU + "").trim().toUpperCase();
												if(g2Sku == "NULL")
												{
													g2Sku = "";
												}
												if(g2Sku.startsWith("SKU:"))
												{
													g2Sku = g2Sku.replaceFirst("SKU:","").trim();
												}
												if(gSkuHit)
												{
													if(g2Sku != sofSku)
													{
														matchG2 = false;
													}
												}
												else if(hasPr && g2.pr_number != null && g2.pr_number != "" && g2.pr_number != prNo)
												{
													matchG2 = false;
												}
												if(matchG2)
												{
													if(g2.Forecast_Delivery != fcDelivery)
													{
														g2.Forecast_Delivery=fcDelivery;
													}
													if(g2.Forecast_Window != fcWindow)
													{
														g2.Forecast_Window=fcWindow;
													}
													if(g2.Forecast_Status != fcStatus)
													{
														g2.Forecast_Status=fcStatus;
													}
												}
											}
											// STAMP: Pick1
											for each  p2 in pickRecs
											{
												matchP2 = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												p2Sku = (p2.SKU + "").trim().toUpperCase();
												if(p2Sku == "NULL")
												{
													p2Sku = "";
												}
												if(p2Sku.startsWith("SKU:"))
												{
													p2Sku = p2Sku.replaceFirst("SKU:","").trim();
												}
												if(pSkuHit)
												{
													if(p2Sku != sofSku)
													{
														matchP2 = false;
													}
												}
												else if(hasPr && p2.PR_if_any != null && p2.PR_if_any != "" && p2.PR_if_any != prNo)
												{
													matchP2 = false;
												}
												if(matchP2)
												{
													if(p2.Forecast_Delivery != fcDelivery)
													{
														p2.Forecast_Delivery=fcDelivery;
													}
													if(p2.Forecast_Window != fcWindow)
													{
														p2.Forecast_Window=fcWindow;
													}
													if(p2.Forecast_Status != fcStatus)
													{
														p2.Forecast_Status=fcStatus;
													}
												}
											}
											// STAMP: Checker_Checklist
											for each  q2 in qcRecs
											{
												matchQ2 = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												q2Sku = (q2.SKU + "").trim().toUpperCase();
												if(q2Sku == "NULL")
												{
													q2Sku = "";
												}
												if(q2Sku.startsWith("SKU:"))
												{
													q2Sku = q2Sku.replaceFirst("SKU:","").trim();
												}
												if(qSkuHit)
												{
													if(q2Sku != sofSku)
													{
														matchQ2 = false;
													}
												}
												else if(hasPr && q2.PR != null && q2.PR != "" && q2.PR != prNo)
												{
													matchQ2 = false;
												}
												if(matchQ2)
												{
													if(q2.Forecast_Delivery != fcDelivery)
													{
														q2.Forecast_Delivery=fcDelivery;
													}
													if(q2.Forecast_Window != fcWindow)
													{
														q2.Forecast_Window=fcWindow;
													}
													if(q2.Forecast_Status != fcStatus)
													{
														q2.Forecast_Status=fcStatus;
													}
												}
											}
											// STAMP: Order_Aggregation1   (ORDER-LEVEL - roll-up)
											/* WALANG SKU field ang Order_Aggregation1 - nasa Item_Details subform ang
											   mga item, at isang record ito kada package. Dati ay isinasala sa `PR`,
											   pero isang halaga lang ang kaya ng field na iyon samantalang ang isang
											   package ay pwedeng maraming PR, kaya hindi nito kayang kumatawan sa
											   item. Roll-up na: ang huling petsa ng buong SO. */
											if(rollChanged)
											{
												for each  oa2 in oaRecs
												{
													if(oa2.Forecast_Delivery != rollDate)
													{
														oa2.Forecast_Delivery=rollDate;
													}
													if(oa2.Forecast_Window != rollWindow)
													{
														oa2.Forecast_Window=rollWindow;
													}
													if(oa2.Forecast_Status != rollStatus)
													{
														oa2.Forecast_Status=rollStatus;
													}
												}
											}
											// STAMP: Crate_Checklist
											for each  c2 in crateRecs
											{
												matchC2 = true;
												/* PER ITEM: SKU kung may katugma sa form na ito, PR_No kung wala. */
												c2Sku = (c2.SKU + "").trim().toUpperCase();
												if(c2Sku == "NULL")
												{
													c2Sku = "";
												}
												if(c2Sku.startsWith("SKU:"))
												{
													c2Sku = c2Sku.replaceFirst("SKU:","").trim();
												}
												if(cSkuHit)
												{
													if(c2Sku != sofSku)
													{
														matchC2 = false;
													}
												}
												else if(hasPr && c2.PR_if_any != null && c2.PR_if_any != "" && c2.PR_if_any != prNo)
												{
													matchC2 = false;
												}
												if(matchC2)
												{
													if(c2.Forecast_Delivery != fcDelivery)
													{
														c2.Forecast_Delivery=fcDelivery;
													}
													if(c2.Forecast_Window != fcWindow)
													{
														c2.Forecast_Window=fcWindow;
													}
													if(c2.Forecast_Status != fcStatus)
													{
														c2.Forecast_Status=fcStatus;
													}
												}
											}
											// STAMP: Service_Request1   (DMS — Sales_Order ang field, hindi SO_No)
											/* ORDER-LEVEL: isang delivery ito, hindi isang item. Roll-up. */
											if(rollChanged && soNo != null && soNo != "")
											{
												srStamp = Service_Request1[Sales_Order == soNo];
												for each  sr in srStamp
												{
													if(sr.Forecast_Delivery != rollDate)
													{
														sr.Forecast_Delivery=rollDate;
													}
													if(sr.Forecast_Window != rollWindow)
													{
														sr.Forecast_Window=rollWindow;
													}
													if(sr.Forecast_Status != rollStatus)
													{
														sr.Forecast_Status=rollStatus;
													}
												}
											}
											// STAMP: Service_Appointment_Form   (ORDER-LEVEL - roll-up)
											if(rollChanged && soNo != null && soNo != "")
											{
												saStamp = Service_Appointment_Form[Sales_Order == soNo];
												for each  sa in saStamp
												{
													if(sa.Forecast_Delivery != rollDate)
													{
														sa.Forecast_Delivery=rollDate;
													}
													if(sa.Forecast_Window != rollWindow)
													{
														sa.Forecast_Window=rollWindow;
													}
													if(sa.Forecast_Status != rollStatus)
													{
														sa.Forecast_Status=rollStatus;
													}
												}
											}
										}
										/* ============================================================================
										   4. PANGALAWANG PASS — mga PR na wala pa talagang SOF.
										      Nasa procurement pa lang, pero kailangan na nilang may forecast — iyon ang
										      "PR hanggang delivery". Dahil walang SO, walang client target, kaya laging
										      "No Client Date" ang status nila; ang petsa ang mahalaga dito.
										   ============================================================================ */
										prOnlyCount = 0;
										allPr = Purchase_Request1[ID != 0];
										rawPrCount = 0;
										for each  pr3 in allPr
										{
											rawPrCount = rawPrCount + 1;
											prNo3 = pr3.PR_No + "";
											hasSof = false;
											sofCheck = Sales_Order_Fulfillment[PR_No == prNo3];
											for each  sc in sofCheck
											{
												hasSof = true;
											}
											if(!hasSof)
											{
												prOnlyCount = prOnlyCount + 1;
												modeVal3 = pr3.Shipment_Mode + "";
												src3 = (pr3.Sourcing_Type + "").toUpperCase();
												mode3 = modeVal3.toUpperCase();
												if(src3 == "LOCAL")
												{
													t3Min = locTMin;
													t3Max = locTMax;
													c3Min = locCMin;
													c3Max = locCMax;
													bucket3 = "Local";
												}
												else if(mode3.contains("AIR"))
												{
													t3Min = airTMin;
													t3Max = airTMax;
													c3Min = airCMin;
													c3Max = airCMax;
													bucket3 = "Air";
												}
												else if(mode3 == "FCL")
												{
													t3Min = fclTMin;
													t3Max = fclTMax;
													c3Min = fclCMin;
													c3Max = fclCMax;
													bucket3 = "FCL";
												}
												else
												{
													t3Min = lclTMin;
													t3Max = lclTMax;
													c3Min = lclCMin;
													c3Max = lclCMax;
													bucket3 = "LCL";
													if(mode3 != "LCL")
													{
														bucket3 = "LCL?";
													}
												}
												/* I-null muna, tulad ng gd/pd/qd/cd: kondisyonal na ang assignment sa
												   loob ng loop, kaya tatagas sana ang petsa ng NAKARAANG PR. May
												   if(anchor3 != null) na sa baba bago ito gamitin. */
												/* Nagsisimula sa PETSA, hindi sa null: ang null-initialised na variable ay
												   walang type, kaya hindi mahanap ng Deluge ang .addDay() dito — "Not able
												   to find ... function". Ang kahulugang "walang mapagsisimulan" ay nasa
												   anchor3Found na. */
												anchor3 = today;
												anchor3Found = false;
												if(pr3.Added_Time != null)
												{
													anchor3 = pr3.Added_Time.toDate();
													anchor3Found = true;
												}
												pos3 = "Procurement";
												s3Min = t3Min + c3Min + prepMin + delMin;
												s3Max = t3Max + c3Max + prepMax + delMax;
												/* Kahit walang SOF, kung may shipment na ang PR ay umaalis na ito —
												   i-anchor sa Date_Shipped para humigpit ang window. */
												if(reAnchor && shipIdByPr.containKey(prNo3))
												{
													ds3 = shipDateByPr.get(prNo3);
													st3 = shipStatusByPr.get(prNo3) + "";
													if(st3 == "Delivered")
													{
														anchor3 = today;
														anchor3Found = true;
														s3Min = prepMin + delMin;
														s3Max = prepMax + delMax;
														pos3 = "At WH";
													}
													else if(ds3 != null)
													{
														anchor3 = ds3;
														anchor3Found = true;
														pos3 = "In transit";
													}
												}
												else if(addSupLead)
												{
													if(pr3.Required_Days_Lead != null)
													{
														s3Min = s3Min + pr3.Required_Days_Lead.toLong();
														s3Max = s3Max + pr3.Required_Days_Lead.toLong();
													}
												}
												fc3Delivery = null;
												fc3Window = "Walang panimulang petsa";
												fc3Status = "No Start Date";
												if(anchor3Found)
												{
													e3 = anchor3.addDay(s3Min);
													l3 = anchor3.addDay(s3Max);
													past3 = false;
													if(l3 < today)
													{
														past3 = true;
													}
													if(e3 < today)
													{
														e3 = today;
													}
													if(l3 < today)
													{
														l3 = today;
													}
													/* Ang (petsa - petsa) sa Deluge na ito ay STRING, kahit ilagay pa sa variable —
													   tinanggihan ng live editor ang parehong anyo noong 2026-11-04. Kaya
													   .daysBetween() na lang, na deretsong araw ang ibinabalik at matagal nang
													   gumagana sa app na ito (dms_site_confirmation.txt).
													   Hindi umaasa sa sign convention ng daysBetween: kinukuha ang laki, saka
													   pinipilit na positibo. Laging l3 >= e3 dito. */
													span3 = e3.daysBetween(l3);
													if(span3 < 0)
													{
														span3 = span3 * -1;
													}
													fc3Delivery = e3.addDay((span3 / 2).round(0).toLong());
													fc3Window = e3.toString("MMM dd") + " - " + l3.toString("MMM dd, yyyy") + " | " + bucket3 + " | " + pos3;
													if(past3)
													{
														fc3Window = fc3Window + " | lampas na sa tantiya";
													}
													fc3Status = "No Client Date";
												}
												if(pr3.Forecast_Delivery != fc3Delivery)
												{
													pr3.Forecast_Delivery=fc3Delivery;
												}
												if(pr3.Forecast_Window != fc3Window)
												{
													pr3.Forecast_Window=fc3Window;
												}
												if(pr3.Forecast_Status != fc3Status)
												{
													pr3.Forecast_Status=fc3Status;
												}
												// STAMP: Shipments (para sa PR na wala pang SOF)
												if(shipIdByPr.containKey(prNo3))
												{
													shipStamp3 = Shipments[ID == shipIdByPr.get(prNo3)];
													for each  shp3 in shipStamp3
													{
														if(shp3.Forecast_Delivery != fc3Delivery)
														{
															shp3.Forecast_Delivery=fc3Delivery;
														}
														if(shp3.Forecast_Window != fc3Window)
														{
															shp3.Forecast_Window=fc3Window;
														}
														if(shp3.Forecast_Status != fc3Status)
														{
															shp3.Forecast_Status=fc3Status;
														}
													}
												}
											}
										}
										info "FORECAST STAMP — petsa: " + today.toString("MMM dd, yyyy");
										info "SOF na-proseso: " + sofCount + " | na-stamp: " + stampCount + " | walang panimulang petsa: " + noDateCount;
										info "PR na wala pang SOF: " + prOnlyCount;
										/* DIAGNOSTIC, idinagdag 2026-11-04. Hindi magkasya ang unang takbo: 7 SOF at 8 PR
										   na walang SOF, habang 197 ang nasa Purchase Request list. Kung 7 lang talaga ang
										   SOF, dapat halos lahat ng PR ay "walang SOF" — hindi 8. Ang tatlong bilang na ito
										   ay ang HILAW na laki ng bawat fetch, bago pa ang anumang filter ng loop, kaya
										   sila ang magsasabi kung aling fetch ang kulang. Burahin kapag nasagot na. */
										info "HILAW na fetch — Shipments: " + rawShipCount + " | SOF: " + rawSofCount + " | PR: " + rawPrCount;
					)
					}
				}
			}
			Backfill_PreOrder_Forecas as "Backfill_PreOrder_Forecast"
			{
				type =  schedule
				start = "2026-11-04 01:00:00"
				frequency = daily
				time zone = "Asia/Manila"
				on start
				{
					actions 
					{
					on load
					(
						/* 1. ISANG pasada sa Purchase_Request1 — tinitipon ang forecast ng bawat PR.
										   Map muna, hindi paisa-isang hanap kada Pre-Order row: kung hahanapin ang PR
										   kada row, 592 na magkakahiwalay na query ito sa isang takbo. Dalawang pasada
										   lang ito. */
										fcDateByPr = Map();
										fcWinByPr = Map();
										fcStatByPr = Map();
										prSeen = 0;
										for each  pr in Purchase_Request1[ID != 0]
										{
											prNo = pr.PR_No + "";
											/* Ang walang petsa ay hindi isinasama: wala itong maibibigay, at ang
											   pagsulat ng blangko ay magbubura ng dating laman ng Pre-Order row. */
											if(prNo != "" && pr.Forecast_Delivery != null)
											{
												fcDateByPr.put(prNo,pr.Forecast_Delivery);
												fcWinByPr.put(prNo,pr.Forecast_Window + "");
												fcStatByPr.put(prNo,pr.Forecast_Status + "");
												prSeen = prSeen + 1;
											}
										}
										/* 2. ISANG pasada sa Pre_Order_FF — kinokopya ang forecast ng PR ng bawat row.
										   Ang `PR` sa row na ito ay PER ITEM (syncpackagetofulfillment.txt linya 886),
										   kaya kusang tama ang (Partly) Pre Order: bawat item, sariling PR, sariling
										   petsa. Walang espesyal na ginagawa para doon. */
										filled = 0;
										noPr = 0;
										noForecast = 0;
										/* Nagsisimula sa PETSA, hindi sa null: ang null-initialised na variable ay
										   walang type sa Deluge at hindi na maipapasok sa date field. Gotcha #27. */
										d = zoho.currentdate;
										for each  po in Pre_Order_FF[ID != 0]
										{
											prNo = po.PR + "";
											if(prNo == "")
											{
												noPr = noPr + 1;
											}
											else if(!fcDateByPr.containKey(prNo))
											{
												/* `containKey`, hindi `containsKey`. */
												noForecast = noForecast + 1;
											}
											else
											{
												d = fcDateByPr.get(prNo);
												w = fcWinByPr.get(prNo) + "";
												s = fcStatByPr.get(prNo) + "";
												/* `!=` guard: ang write ang mabigat, hindi ang read. Sa pangalawang
												   takbo bukas, karamihan ay walang magbabago at walang isusulat. */
												if(po.Forecast_Delivery != d)
												{
													po.Forecast_Delivery=d;
												}
												if(po.Forecast_Window != w)
												{
													po.Forecast_Window=w;
												}
												if(po.Forecast_Status != s)
												{
													po.Forecast_Status=s;
												}
												filled = filled + 1;
											}
										}
										info "FORECAST PRE-ORDER BACKFILL — " + prSeen + " PR na may forecast | " + filled + " pre-order row na natatakan | " + noPr + " walang PR | " + noForecast + " walang forecast ang PR nito";
					)
					}
				}
			}
		}




		functions
		{
			Action_Button_Supplier as "Action_Button_Supplier"
			{
				type =  functions
				form = Supplier_2
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Supplier_2?viewLinkName=Supplier_2_Report&recLinkID=" + input.ID,"same window");
					)
					}
				}
			}
			Action_Button_Supplier1 as "Action_Button_Supplier"
			{
				type =  functions
				form = Supplier_1
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Supplier_1?viewLinkName=Supplier_1_Report&recLinkID=" + input.ID,"same window");
					)
					}
				}
			}
			PR_Approved as "PR_Approved"
			{
				type =  functions
				form = Purchase_Request1
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						siblingPRs = Purchase_Request1[Sales_Order == input.Sales_Order && PR_Approved == false && PR_READY_FOR_PO == true];
										approvedList = "";
										skippedList = "";
										for each  prLoop in siblingPRs
										{
											/* ADDED 2026-10-01 (PR On Hold plan, Phase 2) — a PR that is On Hold or Cancelled
											   is never converted to a PO, even when a sibling PR in the same SO is. Blank
											   Hold_Status (older PRs) counts as Active. */
											if(prLoop.Hold_Status == "On Hold" || prLoop.Hold_Status == "Cancelled")
											{
												skippedList = skippedList + prLoop.PR_No + " (" + prLoop.Hold_Status + "), ";
												continue;
											}
											if(prLoop.Followed_Recommendation == "No")
											{
												if(prLoop.Override_Reason == null || prLoop.Override_Reason == "")
												{
													skippedList = skippedList + prLoop.PR_No + ", ";
													continue;
												}
											}
											selectedSupplierName = prLoop.Selected_Supplier;
											customerRec = prLoop.Customer;
											customerName = customerRec.customer_name;
											itemRec = prLoop.Items;
											itemName = itemRec.item_name;
											matchingPONo = "";
											candidatePOs = Purchase_Order[PO_Status != "Completed"];
											for each  po in candidatePOs
											{
												if(po.SO_No.Sales_Order_Number == prLoop.Sales_Order)
												{
													for each  ln in po.PO_Line_Items
													{
														lnSupplierVal = ln.Supplier + "";
														if(lnSupplierVal == selectedSupplierName || lnSupplierVal.contains(selectedSupplierName) || selectedSupplierName.contains(lnSupplierVal))
														{
															/* FIXED 2026-08-10, mirrors pr_approve_po_custom_api.txt's approvePOMain
															   fix — was exact ln.Supplier==selectedSupplierName, same full-vs-bare-name
															   mismatch class as elsewhere in this file (see NOTES). Real live case
															   (SO-16438): a PR skipped earlier for missing Override_Reason, re-approved
															   after fixing it, would create a duplicate PO instead of joining the
															   existing one if the supplier name shape differs between the two PRs. */
															matchingPONo = po.PO_No;
														}
													}
												}
											}
											if(matchingPONo != "")
											{
												targetPOs = Purchase_Order[PO_No == matchingPONo];
												for each  tpo in targetPOs
												{
													targetPO = tpo;
												}
											}
											else
											{
												maxNum = 0;
												existingPOs = Purchase_Order[ID != 0];
												for each  po in existingPOs
												{
													poNoStr = po.PO_No;
													if(poNoStr != null && poNoStr != "")
													{
														numPart = poNoStr.removeFirstOccurence("PO-");
														num = numPart.toLong();
														if(num > maxNum)
														{
															maxNum = num;
														}
													}
												}
												newNum = maxNum + 1;
												if(newNum < 10)
												{
													newPONo = "PO-0000" + newNum;
												}
												else if(newNum < 100)
												{
													newPONo = "PO-000" + newNum;
												}
												else if(newNum < 1000)
												{
													newPONo = "PO-00" + newNum;
												}
												else if(newNum < 10000)
												{
													newPONo = "PO-0" + newNum;
												}
												else
												{
													newPONo = "PO-" + newNum;
												}
												newPOID = insert into Purchase_Order
												[
													PO_No=newPONo
													Customer=customerName
													Customer_Type=prLoop.Customer_Type
													Sales_Owner=prLoop.Sales_Owner
													PO_Date=zoho.currentdate
													PO_Status="Draft"
													Added_User=zoho.loginuser
												];
												targetPO = Purchase_Order[ID == newPOID];
												soFound = false;
												soIDNum = 0;
												soRecs = Sales_Order[Sales_Order_Number == prLoop.Sales_Order];
												for each  sor in soRecs
												{
													soIDNum = sor.ID;
													soFound = true;
												}
												if(soFound == false)
												{
													soIDNum = insert into Sales_Order
													[
														Sales_Order_Number=prLoop.Sales_Order
														Added_User=zoho.loginuser
													];
												}
												targetPO.SO_No=soIDNum;
											}
											alreadyHasLine = false;
											for each  existingLn in targetPO.PO_Line_Items
											{
												if(existingLn.PR_No == prLoop.PR_No)
												{
													alreadyHasLine = true;
												}
											}
											if(alreadyHasLine == true)
											{
												prLoop.PR_Status="Converted to PO";
												prLoop.Link_PO_No=targetPO.PO_No;
												prLoop.PR_Approved=true;
												approvedList = approvedList + prLoop.PR_No + ", ";
												continue;
											}
											targetPO.Sales_Owner=prLoop.Sales_Owner;
											/* REVERTED 2026-07-15, per user ("dont show srp/rate there") — both the SRP_Rate_PR
											   and catalog-Rate fallback tiers dropped from the aggregate Final_Price too, same
											   as Actions 2/3 earlier today. Safe for the same reason: Books-sync no longer
											   depends on this field for money-correctness (Item_Price_Supplier1/2, see
											   purchase_order_scripts.txt, already carries the authoritative catalog rate
											   separately) — this is purely a buyer-facing DISPLAY field now, and per user's
											   principle established today, no surface should show a reference/fallback number
											   as if it were a real confirmed price. Final_Price now ONLY ever reflects
											   Selcted_Final_Cost (0 if blank). */
											rateToUse = prLoop.Selcted_Final_Cost;
											if(rateToUse == null)
											{
												rateToUse = 0;
											}
											newLine = Purchase_Order.PO_Line_Items();
											newLine.PR_No=prLoop.PR_No;
											newLine.Supplier=selectedSupplierName;
											newLine.Item=itemName;
											newLine.SKU=prLoop.sku;
											newLine.QTY=prLoop.quantity.round(0).toLong();
											newLine.Unit=prLoop.unit;
											newLine.Final_Price=rateToUse;
											newLine.Line_Total=prLoop.quantity.round(0).toLong() * rateToUse.round(0).toLong();
											itemRateStr = itemRec.Rate + "";
											if(itemRateStr != "null" && itemRateStr != "" && itemRateStr != "0" && itemRateStr.toDecimal() != 0)
											{
												newLine.SRP_Rate_PO=itemRateStr.toDecimal().round(0).toLong();
												targetPO.SRP_Rate=itemRateStr.toDecimal().round(0).toLong();
											}
											newLine.Shipping_Mode=prLoop.Shipment_Mode;
											newLine.Target_Delivery=prLoop.Target_Delivery;
											newLine.supplier_target_date=prLoop.supplier_target_date;
											newLine.Delay_Status=prLoop.Delay_Status;
											newLine.Required_Days_Lead=prLoop.Required_Days_Lead;
											newLine.Remaining_Days=prLoop.Remaining_Days;
											newLine.Followed_Recommendation=prLoop.Followed_Recommendation;
											newLine.Override_Reason=prLoop.Override_Reason;
											newLine.Priority=prLoop.Priority;
											newLine.Production_Date=zoho.currentdate;
											if(itemRec != null && itemRec.Image != null)
											{
												newLine.Item_Image=itemRec.Image;
											}
											targetPO.PO_Line_Items.insert(newLine);
											totalVal = 0;
											totalLns = 0;
											for each  poLn in targetPO.PO_Line_Items
											{
												totalLns = totalLns + 1;
												if(poLn.Line_Total != null)
												{
													totalVal = totalVal + poLn.Line_Total;
												}
											}
											targetPO.Total_PO_Value=totalVal;
											targetPO.Total_Lines=totalLns;
											targetPO.Sent_On=zoho.currenttime;
											targetPO.Is_Locked=true;
											/* FIXED 2026-08-07, real crash risk found via codebase-wide audit: this is the
											   NATIVE "Approve PR" twin of `pr_approve_po_custom_api.txt`'s `approvePOMain` —
											   that file already got this EXACT fix live 2026-08-05 (real Production crash,
											   "'supSnapRec' has no matching records") but the fix was never mirrored here.
											   Suppliers.Supplier_Name stores the FULL name entirely in first_name ("Tony Fan"/
											   "Fenteng Lighting"), while selectedSupplierName (Purchase_Request1.Selected_Supplier)
											   can be either the short name (auto-routed PR, no INQ match) or the full name
											   (INQ-routed PR, confirmed live in Production holding "Tony Fan") depending on
											   the PR's own history — the old exact-match criteria found 0 rows whenever it hit
											   the short-name case, and dot-accessing/writing .Active_PO_Count on the resulting
											   empty collection crashed the whole function, same as the already-fixed incident.
											   Suppliers has only 2 real records — safe to iterate the whole form and
											   string-compare both directions, same pattern as approvePOMain's fix. */
											matchedSupplierIdPR = 0;
											matchedSupplierActivePOCountPR = 0;
											foundSupplierPR = false;
											for each  supRecPR in Suppliers
											{
												supNameValPR = supRecPR.Supplier_Name.first_name + "";
												supMatchesPR = false;
												if(supNameValPR == selectedSupplierName)
												{
													supMatchesPR = true;
												}
												if(supNameValPR.contains(selectedSupplierName))
												{
													supMatchesPR = true;
												}
												if(selectedSupplierName.contains(supNameValPR))
												{
													supMatchesPR = true;
												}
												if(supMatchesPR == true)
												{
													matchedSupplierIdPR = supRecPR.ID;
													matchedSupplierActivePOCountPR = supRecPR.Active_PO_Count;
													foundSupplierPR = true;
												}
											}
											targetPO.Supplier_Load_At_PO=matchedSupplierActivePOCountPR;
											prLoop.PR_Status="Converted to PO";
											prLoop.Link_PO_No=targetPO.PO_No;
											prLoop.Production_Date=zoho.currentdate;
											activePOCount = 0;
											allActivePOs = Purchase_Order[PO_Status != "Completed" && PO_Status != "Cancelled"];
											for each  po in allActivePOs
											{
												for each  poLn in po.PO_Line_Items
												{
													if(poLn.Supplier == selectedSupplierName)
													{
														activePOCount = activePOCount + 1;
													}
												}
											}
											if(foundSupplierPR == true)
											{
												update Suppliers[ID == matchedSupplierIdPR]
												[
													Active_PO_Count=activePOCount
												];
											}
											prLoop.Last_Update=zoho.currenttime;
											prLoop.PR_Approved=true;
											approvedList = approvedList + prLoop.PR_No + " -> " + targetPO.PO_No + "; ";
										}
										if(approvedList == "" && skippedList == "")
										{
											info "No eligible PRs found for SO " + input.Sales_Order + ".";
										}
										else if(skippedList != "")
										{
											info "Approved: " + approvedList + " | Skipped (needs Override Reason, or On Hold/Cancelled): " + skippedList;
										}
										else
										{
											success message "Approved: " + approvedList;
										}
					)
					}
					actions 
					{
					on click
					(
						processedSupPOsF = List();
										siblingPRsF = Purchase_Request1[Sales_Order == input.Sales_Order && PR_Approved == true && Link_PO_No != null];
										for each  prLoopF in siblingPRsF
										{
											if(prLoopF.Link_PO_No == "")
											{
												continue;
											}
											supplierMatchesF = false;
											if(prLoopF.Selected_Supplier == "Fenteng")
											{
												supplierMatchesF = true;
											}
											if(prLoopF.Selected_Supplier.contains("Fenteng"))
											{
												supplierMatchesF = true;
											}
											if(supplierMatchesF == false)
											{
												continue;
											}
											itemRecF = prLoopF.Items;
											itemNameF = itemRecF.item_name;
											existingSupPOsF = Fenteng_Lighting_Purchase_Order[PO_No_Supplier1 == prLoopF.Link_PO_No];
											supPOFoundF = false;
											for each  spoF in existingSupPOsF
											{
												targetSupPOF = spoF;
												supPOFoundF = true;
											}
											if(supPOFoundF == false)
											{
												newSupPOIDF = insert into Fenteng_Lighting_Purchase_Order
												[
													PO_No_Supplier1=prLoopF.Link_PO_No
													PO_Date_Supplier1=zoho.currentdate
													PO_Status_Supplier1="Draft"
													Added_User=zoho.loginuser
												];
												targetSupPOF = Fenteng_Lighting_Purchase_Order[ID == newSupPOIDF];
											}
											alreadyHasLineF = false;
											for each  existingLnF in targetSupPOF.PO_Line_Items_Supplier1
											{
												if(existingLnF.PR_No_Supplier1 == prLoopF.PR_No)
												{
													alreadyHasLineF = true;
												}
											}
											if(alreadyHasLineF == true)
											{
												alreadyTrackedF = false;
												for each  doneNoF in processedSupPOsF
												{
													if(doneNoF == targetSupPOF.PO_No_Supplier1)
													{
														alreadyTrackedF = true;
													}
												}
												if(alreadyTrackedF == false)
												{
													processedSupPOsF.add(targetSupPOF.PO_No_Supplier1);
												}
												continue;
											}
											/* REMOVED 2026-07-15, per user: SRP_Rate_PR fallback dropped from Final_Price_Supplier1
											   entirely — this field must ONLY ever show Fenteng's own real quote (Selcted_Final_Cost),
											   never a reference number, even when that number happens to be 0/blank. Safe now that
											   Books-sync no longer reads Final_Price_Supplier1 as its primary source — it prefers
											   Item_Price_Supplier1 (below) first, so this field carrying no fallback doesn't risk
											   understating what Books gets charged the way it would have before that change. */
											rateToUseF = prLoopF.Selcted_Final_Cost;
											if(rateToUseF == null)
											{
												rateToUseF = 0;
											}
											/* Item_Price_Supplier1 (Single Line/TEXT field) — catalog reference rate, kept
											   SEPARATE from Final_Price_Supplier1 so the supplier-facing "Final Price" always
											   shows their own real quote (or blank/0 pending one), never a catalog value
											   masquerading as their price. Books-sync (Acknowledged_PO_Supplier1, see
											   purchase_order_scripts.txt) prefers this field over Final_Price_Supplier1 when
											   it's set. Written as TEXT on purpose — sidesteps the Currency-type-mismatch class
											   of bug entirely (see Deluge Gotchas), same reasoning as why this field was made
											   Single Line rather than Number/Currency.
											   ADDED 2026-07-15, per user ("we will use whatever is final saved SRP Approved PR
											   going to PO and then going to books") — SRP_Approved_PR (new manually-editable
											   header field, see UI/EndUser/PRs/app/index.html's srpApprovedInfo()) now takes
											   PRIORITY over the catalog Rate here when a human has actually saved a real value
											   (>0) — the widget's own auto-default (catalog rate shown until approved) is a
											   CLIENT-side-only default, never reflected in the stored field itself, so reading
											   SRP_Approved_PR straight is safe: 0/blank there genuinely means "never approved,"
											   correctly falling through to the same catalog-Rate fallback as before. */
											itemPriceValF = 0;
											if(prLoopF.SRP_Approved_PR != null && prLoopF.SRP_Approved_PR != 0)
											{
												itemPriceValF = prLoopF.SRP_Approved_PR;
											}
											else if(prLoopF.SRP_Rate_PR != null && prLoopF.SRP_Rate_PR != 0)
											{
												/* ADDED 2026-08-05, real bug found live in Production: a PR routed from an already-Approved Inquiry (inquiry_reference set) already carries that Inquirys own approved SRP into SRP_Rate_PR automatically at PR-creation time (SO_To_PR) -- but SRP_Approved_PR itself (a separate MANUAL-approval field) stays blank until an officer explicitly re-approves the same number in the PRs widget. Confirmed live: a real PR had SRP_Rate_PR=200 (matching its source Inquirys real approved SRP) but SRP_Approved_PR blank, so this whole block fell to the generic catalog Items.Rate fallback, and Books ended up receiving the suppliers raw quote instead of the real approved SRP. FIX: SRP_Rate_PR checked as a middle tier before the generic catalog fallback. */
												itemPriceValF = prLoopF.SRP_Rate_PR;
											}
											else
											{
												itemRateStrF = itemRecF.Rate + "";
												if(itemRateStrF != "null" && itemRateStrF != "" && itemRateStrF != "0" && itemRateStrF.toDecimal() != 0)
												{
													itemPriceValF = itemRateStrF.toDecimal();
												}
											}
											newSupLineF = Fenteng_Lighting_Purchase_Order.PO_Line_Items_Supplier1();
											newSupLineF.PR_No_Supplier1=prLoopF.PR_No;
											newSupLineF.Supplier_Supplier1=prLoopF.Selected_Supplier;
											newSupLineF.Item_Supplier1=itemNameF;
											newSupLineF.SKU_Supplier1=prLoopF.sku;
											newSupLineF.QTY_Supplier1=prLoopF.quantity.round(0).toLong();
											newSupLineF.Unit_Supplier1=prLoopF.unit;
											newSupLineF.Final_Price_Supplier1=rateToUseF;
											newSupLineF.Item_Price_Supplier1=itemPriceValF + "";
											newSupLineF.Line_Total_Supplier1=prLoopF.quantity.round(0).toLong() * rateToUseF.round(0).toLong();
											newSupLineF.Shipping_Mode_Supplier1=prLoopF.Shipment_Mode;
											newSupLineF.Target_Delivery_Supplier1=prLoopF.Target_Delivery;
											newSupLineF.supplier_target_date_Supplier1=prLoopF.supplier_target_date;
											newSupLineF.Delay_Status_Supplier1=prLoopF.Delay_Status;
											newSupLineF.Followed_Recommendation_Supplier1=prLoopF.Followed_Recommendation;
											newSupLineF.Override_Reason_Supplier1=prLoopF.Override_Reason;
											targetSupPOF.PO_Line_Items_Supplier1.insert(newSupLineF);
											totalValF = 0;
											totalLnsF = 0;
											for each  poLnF in targetSupPOF.PO_Line_Items_Supplier1
											{
												totalLnsF = totalLnsF + 1;
												if(poLnF.Line_Total_Supplier1 != null)
												{
													totalValF = totalValF + poLnF.Line_Total_Supplier1;
												}
											}
											targetSupPOF.Total_PO_Value_Supplier1=totalValF;
											targetSupPOF.Total_Lines_Supplier1=totalLnsF;
											targetSupPOF.Sent_On_Supplier1=zoho.currenttime;
											targetSupPOF.Is_Locked_Supplier1=true;
											alreadyTrackedF2 = false;
											for each  doneNoF2 in processedSupPOsF
											{
												if(doneNoF2 == targetSupPOF.PO_No_Supplier1)
												{
													alreadyTrackedF2 = true;
												}
											}
											if(alreadyTrackedF2 == false)
											{
												processedSupPOsF.add(targetSupPOF.PO_No_Supplier1);
											}
										}
										/* MOVED HERE 2026-07-16, per user ("move the function of acknowledge - going to zoho
										   books, going to shipment and receiving - to PR_Approved. acknowledge only function
										   now: is to populate ETD and ETA in shipment after acknowledge") — Shipment+Receiving
										   creation and the Books Purchase Order sync now fire at PR-approval time instead of
										   waiting for supplier acknowledgment. Logic is IDENTICAL to what used to live in
										   Acknowledged_PO_Supplier1 (purchase_order_scripts.txt) — see that file's NOTES
										   history for the full original debugging trail (Books PO create/approve/open, the
										   SHP-/RCV- manual numbering, the Configure-Fields/BIGINT gotchas already solved there)
										   — only WHEN it fires changed, not the logic itself. Runs once per DISTINCT supplier
										   PO touched this click (not once per PR-line), tracked via processedSupPOsF above, so
										   a multi-PR batch approval (same SO, several sibling PRs) still only builds each
										   Shipment/Receiving/Books PO once — same "once per PO" granularity Acknowledge always
										   used. Acknowledge (purchase_order_scripts.txt) keeps PO_Status/Acknowledge_On
										   bookkeeping and now ALSO writes mandatory ETD/ETA onto the Shipment this block
										   creates — see that file's NOTES. Replacement POs (Damage/QC/Complaint RR flow,
										   approve_rr_supplier.txt) never reach this action at all (they're created directly,
										   bypassing PR1/Link_PO_No entirely) — the RR_Reference_No Books-skip guard that used
										   to wrap this block in Acknowledge is therefore dropped here, not needed. Mirror this
										   into pr_approve_po_custom_api.txt's approvePOFenteng if it changes again. UNTESTED. */
										for each  poNoTouchedF in processedSupPOsF
										{
											supPOsSyncF = Fenteng_Lighting_Purchase_Order[PO_No_Supplier1 == poNoTouchedF];
											for each  spoF2 in supPOsSyncF
											{
												targetSupPOF2 = spoF2;
											}
											aggPOsSyncF = Purchase_Order[PO_No == poNoTouchedF];
											for each  apoF2 in aggPOsSyncF
											{
												apoF = apoF2;
											}
											soNoTextF = apoF.SO_No.Sales_Order_Number;
											matchingShipNoF = "";
											candidateShipmentsF = Shipments[PO_No == apoF.ID && Shipment_Status == "Pending"];
											for each  shF in candidateShipmentsF
											{
												matchingShipNoF = shF.Shipment_No;
											}
											isNewShipmentF = false;
											if(matchingShipNoF != "")
											{
												targetShipsF = Shipments[Shipment_No == matchingShipNoF];
												for each  tshF in targetShipsF
												{
													targetShipF = tshF;
												}
											}
											else
											{
												maxShipNumF = 0;
												existingShipmentsF = Shipments[ID != 0];
												for each  shF in existingShipmentsF
												{
													shipNoStrF = shF.Shipment_No;
													if(shipNoStrF != null && shipNoStrF != "")
													{
														shipNumPartF = shipNoStrF.removeFirstOccurence("SHP-");
														shipNumF = shipNumPartF.toLong();
														if(shipNumF > maxShipNumF)
														{
															maxShipNumF = shipNumF;
														}
													}
												}
												newShipNumF = maxShipNumF + 1;
												if(newShipNumF < 10)
												{
													newShipNoF = "SHP-0000" + newShipNumF;
												}
												else if(newShipNumF < 100)
												{
													newShipNoF = "SHP-000" + newShipNumF;
												}
												else if(newShipNumF < 1000)
												{
													newShipNoF = "SHP-00" + newShipNumF;
												}
												else if(newShipNumF < 10000)
												{
													newShipNoF = "SHP-0" + newShipNumF;
												}
												else
												{
													newShipNoF = "SHP-" + newShipNumF;
												}
												newShipIDF = insert into Shipments
												[
													Shipment_No=newShipNoF
													PO_No=apoF.ID
													Sales_Order=soNoTextF
													Customer=apoF.Customer
													Supplier="Fenteng"
													Shipment_Status="Pending"
													Added_User=zoho.loginuser
												];
												targetShipF = Shipments[ID == newShipIDF];
												isNewShipmentF = true;
											}
											for each  poLnAggF in apoF.PO_Line_Items
											{
												targetShipF.Required_Days_Lead=poLnAggF.Required_Days_Lead;
												targetShipF.Remaining_Days=poLnAggF.Remaining_Days;
												targetShipF.Target_Date=poLnAggF.Target_Delivery;
												targetShipF.Supplier_Target_Date=poLnAggF.supplier_target_date;
												targetShipF.Production_Date=poLnAggF.Production_Date;
												if(poLnAggF.PR_No != null && poLnAggF.PR_No != "")
												{
													prLineF = Purchase_Request1[PR_No == poLnAggF.PR_No];
													targetShipF.Shipment_Days=prLineF.Shipment_Days;
													targetShipF.Sales_Owner=prLineF.Sales_Owner;
												}
												else
												{
													targetShipF.Sales_Owner=apoF.Sales_Owner;
												}
												shipLineExistsF = false;
												for each  existingShipLnF in targetShipF.PO_Shipments
												{
													if(existingShipLnF.PR_No == poLnAggF.PR_No)
													{
														shipLineExistsF = true;
													}
												}
												if(shipLineExistsF == false)
												{
													newShipLineF = Shipments.PO_Shipments();
													newShipLineF.PR_No=poLnAggF.PR_No;
													newShipLineF.SKU=poLnAggF.SKU;
													newShipLineF.Item_Name=poLnAggF.Item;
													newShipLineF.Ordered_QTY=poLnAggF.QTY;
													newShipLineF.Shipment_QTY=poLnAggF.QTY;
													newShipLineF.Remaining_QTY=poLnAggF.QTY;
													newShipLineF.Shipping_Mode=poLnAggF.Shipping_Mode;
													targetShipF.PO_Shipments.insert(newShipLineF);
												}
											}
											/* ADDED 2026-07-21, per user ("drop Shipment_Populate_Receiving, put supplier's
											   shipment populating directly on Create PO — both native and widget") — the
											   Shipments-Created-trigger-based auto-create workflow proved unreliable (Creator's
											   own editor kept corrupting the pasted action, root cause never resolved). Folded
											   directly into this script instead, using targetShipF (already resolved above,
											   whether newly created or an existing Shipment matched this run) and its own
											   just-populated PO_Shipments — no dependency on any Shipments-form trigger firing
											   at all. Only runs when this PO's Shipment was genuinely NEW this click
											   (isNewShipmentF) — an already-existing Shipment being re-touched (e.g. a 2nd PR
											   line added to the same PO in the same batch) must not create a duplicate
											   Fenteng_Shipment record. RR_No always blank here — replacement POs (Damage/QC/
											   Complaint RR flow) never reach this action at all (created directly, bypassing
											   PR1/Link_PO_No), so there is no replacement-PO case to resolve RR_No for. */
											if(isNewShipmentF == true)
											{
												newSuppRecIDF = insert into Fenteng_Shipment
												[
													Shipment_No=targetShipF.Shipment_No
													Parent_Shipment_ID=targetShipF.ID + ""
													Added_User1=zoho.loginuser
													Added_User=zoho.loginuser
												];
												newSuppRecF = Fenteng_Shipment[ID == newSuppRecIDF];
												for each  shLnF in targetShipF.PO_Shipments
												{
													newSuppRowF = Fenteng_Shipment.Supplier1_Shipment_Details();
													newSuppRowF.SKU=shLnF.SKU;
													newSuppRowF.Item_Name=shLnF.Item_Name;
													newSuppRowF.PR_No=shLnF.PR_No;
													newSuppRowF.RR_No="";
													newSuppRecF.Supplier1_Shipment_Details.insert(newSuppRowF);
												}
											}
											recvFoundF = false;
											matchingRecvIDF = 0;
											existingRecvF = Receiving[Shipments == targetShipF.ID];
											for each  rcF in existingRecvF
											{
												matchingRecvIDF = rcF.ID;
												recvFoundF = true;
											}
											if(recvFoundF == true)
											{
												targetRecvsF = Receiving[ID == matchingRecvIDF];
												for each  trcF in targetRecvsF
												{
													targetRecvF = trcF;
												}
											}
											else
											{
												maxRecvNumF = 0;
												existingRecvsF = Receiving[ID != 0];
												for each  rcF in existingRecvsF
												{
													recvNoStrF = rcF.Receive_No1;
													if(recvNoStrF != null && recvNoStrF != "")
													{
														recvNumPartF = recvNoStrF.removeFirstOccurence("RCV-");
														recvNumF = recvNumPartF.toLong();
														if(recvNumF > maxRecvNumF)
														{
															maxRecvNumF = recvNumF;
														}
													}
												}
												newRecvNumF = maxRecvNumF + 1;
												if(newRecvNumF < 10)
												{
													newRecvNoF = "RCV-0000" + newRecvNumF;
												}
												else if(newRecvNumF < 100)
												{
													newRecvNoF = "RCV-000" + newRecvNumF;
												}
												else if(newRecvNumF < 1000)
												{
													newRecvNoF = "RCV-00" + newRecvNumF;
												}
												else if(newRecvNumF < 10000)
												{
													newRecvNoF = "RCV-0" + newRecvNumF;
												}
												else
												{
													newRecvNoF = "RCV-" + newRecvNumF;
												}
												newRecvIDF = insert into Receiving
												[
													Receive_No1=newRecvNoF
													Shipments=targetShipF.ID
													SO_No=soNoTextF
													PO_No=apoF.PO_No
													Customer_Name=apoF.Customer
													Supplier="Fenteng"
													Added_User=zoho.loginuser
												];
												targetRecvF = Receiving[ID == newRecvIDF];
											}
											for each  poLnAggF in apoF.PO_Line_Items
											{
												if(poLnAggF.PR_No != null && poLnAggF.PR_No != "")
												{
													prLineRecvF = Purchase_Request1[PR_No == poLnAggF.PR_No];
													targetRecvF.Sales_Owner=prLineRecvF.Sales_Owner;
												}
												else
												{
													targetRecvF.Sales_Owner=apoF.Sales_Owner;
												}
												recvLineExistsF = false;
												for each  existingRecvLnF in targetRecvF.Receiving_Line_Items
												{
													if(existingRecvLnF.PR_No == poLnAggF.PR_No)
													{
														recvLineExistsF = true;
													}
												}
												if(recvLineExistsF == false)
												{
													newRecvLineF = Receiving.Receiving_Line_Items();
													newRecvLineF.PR_No=poLnAggF.PR_No;
													newRecvLineF.SKU=poLnAggF.SKU;
													newRecvLineF.Item_Name=poLnAggF.Item;
													newRecvLineF.Expected_Qty=poLnAggF.QTY;
													targetRecvF.Receiving_Line_Items.insert(newRecvLineF);
												}
											}
											/* ADDED 2026-07-16, per user ("check my sample rcv after i approve pr. it is
											   completed on status. but not really completed") — Receiving's own Validations
											   workflows (Receiving_Compute_Totals/Receiving_Set_Line_Result/
											   Receiving_Set_Receive_Status, see those files) never fire for a record built via
											   this cross-form `insert into Receiving` (established gotcha in this codebase —
											   Deluge cross-form inserts don't trigger the target form's own workflows), so every
											   rollup field stayed blank/0 and the widget's status bucketing misread "0
											   incomplete of 0 total" as complete. Mirrors those 3 native scripts' exact
											   formulas here so a freshly (or re-synced) Receiving record is correct immediately
											   — recomputed from the CURRENT full line set every run, same as the Shipment/Books
											   sync above, so this also self-heals if more lines get merged in later. */
											totalExpectedF = 0;
											totalAcceptedF = 0;
											totalDamageF = 0;
											totalMissingF = 0;
											totalLinesRF = 0;
											incompleteLinesF = 0;
											readyForFulfillF = 0;
											for each  rln in targetRecvF.Receiving_Line_Items
											{
												totalLinesRF = totalLinesRF + 1;
												expRF = ifnull(rln.Expected_Qty,0);
												accRF = ifnull(rln.Accepted_Qty,0);
												dmgRF = ifnull(rln.Damage_Qty,0);
												misRF = ifnull(rln.Missing_Qty,0);
												totalExpectedF = totalExpectedF + expRF;
												totalAcceptedF = totalAcceptedF + accRF;
												totalDamageF = totalDamageF + dmgRF;
												totalMissingF = totalMissingF + misRF;
												totalRecRF = accRF + dmgRF + misRF;
												if(totalRecRF == expRF && accRF == expRF)
												{
													rln.Line_Result="Complete";
													rln.Ready_for_Fulfillment=true;
													readyForFulfillF = readyForFulfillF + 1;
												}
												else
												{
													rln.Line_Result="Incomplete";
													rln.Ready_for_Fulfillment=false;
													incompleteLinesF = incompleteLinesF + 1;
												}
											}
											targetRecvF.Total_Expected_Qty=totalExpectedF;
											targetRecvF.Total_Accepted_Qty=totalAcceptedF;
											targetRecvF.Total_Damage_Qty=totalDamageF;
											targetRecvF.Total_Missing_Qty=totalMissingF;
											targetRecvF.Total_Lines=totalLinesRF;
											targetRecvF.Incomplete_Lines=incompleteLinesF;
											targetRecvF.Ready_for_Fulfillment1=readyForFulfillF;
											if(totalLinesRF == 0 || (totalAcceptedF == 0 && totalDamageF == 0 && totalMissingF == 0))
											{
												targetRecvF.Receive_Status="Pending";
											}
											else if(incompleteLinesF == 0)
											{
												targetRecvF.Receive_Status="Received";
											}
											else
											{
												targetRecvF.Receive_Status="Partial Received";
											}
											shipModeBooksF = "Air Freight";
											for each  poLnBooksF in apoF.PO_Line_Items
											{
												shipLineValF = poLnBooksF.Shipping_Mode + "";
												if(shipLineValF == "LCL")
												{
													shipModeBooksF = "LCL";
												}
												else if(shipLineValF == "FCL")
												{
													shipModeBooksF = "FCL";
												}
												else if(shipLineValF != "" && shipLineValF != "null")
												{
													shipModeBooksF = "Air Freight";
												}
											}
											booksLineItemsF = List();
											prRefListF = List();
											for each  poLnBooksF2 in targetSupPOF2.PO_Line_Items_Supplier1
											{
												prRefListF.add(poLnBooksF2.PR_No_Supplier1);
												bookItemRecsF = Items[SKU == poLnBooksF2.SKU_Supplier1];
												bookItemIdF = "";
												for each  biF in bookItemRecsF
												{
													bookItemIdF = biF.ID1 + "";
												}
												if(bookItemIdF == "null")
												{
													bookItemIdF = "";
												}
												if(bookItemIdF != "")
												{
													effectiveRateF = poLnBooksF2.Final_Price_Supplier1.toDecimal();
													itemPriceStrF = poLnBooksF2.Item_Price_Supplier1 + "";
													if(itemPriceStrF != "null" && itemPriceStrF != "" && itemPriceStrF != "0" && itemPriceStrF.toDecimal() != 0)
													{
														effectiveRateF = itemPriceStrF.toDecimal();
													}
													lineBF = Map();
													lineBF.put("item_id",bookItemIdF);
													lineBF.put("quantity",poLnBooksF2.QTY_Supplier1.toLong());
													lineBF.put("rate",effectiveRateF);
													lineBF.put("warehouse_id","2680178000042173149");
													booksLineItemsF.add(lineBF);
												}
											}
											prRefsStrF = "[";
											prRefCountF = 0;
											for each  prRefItemF in prRefListF
											{
												if(prRefCountF > 0)
												{
													prRefsStrF = prRefsStrF + ",";
												}
												prRefsStrF = prRefsStrF + "\"" + prRefItemF + "\"";
												prRefCountF = prRefCountF + 1;
											}
											prRefsStrF = prRefsStrF + "]";
											cfListBooksF = List();
											cfBF1 = Map();
											cfBF1.put("label","Mode of Shipment");
											cfBF1.put("value",shipModeBooksF);
											cfListBooksF.add(cfBF1);
											cfBF2 = Map();
											cfBF2.put("label","Type of Order");
											cfBF2.put("value","Pre Order");
											cfListBooksF.add(cfBF2);
											cfBF3 = Map();
											cfBF3.put("label","Created by");
											cfBF3.put("value","Procurement");
											cfListBooksF.add(cfBF3);
											cfBF4 = Map();
											cfBF4.put("label","Supplier");
											cfBF4.put("value","Fenteng Lighting");
											cfListBooksF.add(cfBF4);
											cfBF5 = Map();
											cfBF5.put("label","PR References");
											cfBF5.put("value",prRefsStrF);
											cfListBooksF.add(cfBF5);
											existingBooksPOIDF = apoF.Books_PO_ID + "";
											if(existingBooksPOIDF == "null")
											{
												existingBooksPOIDF = "";
											}
											booksPOValidF = false;
											if(existingBooksPOIDF != "")
											{
												checkPORespF = invokeurl
												[
													url :"https://www.zohoapis.com/books/v3/purchaseorders/" + existingBooksPOIDF + "?organization_id=751117756"
													type :GET
													connection:"zhbooks3"
												];
												if(checkPORespF.get("code") == 0 && checkPORespF.get("purchaseorder") != null)
												{
													booksPOValidF = true;
												}
											}
											if(booksPOValidF == true)
											{
												updatePOBodyF = Map();
												updatePOBodyF.put("line_items",booksLineItemsF);
												updatePOBodyF.put("custom_fields",cfListBooksF);
												updatePOBodyStrF = updatePOBodyF.toString();
