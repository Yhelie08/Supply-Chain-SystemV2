			EXC_Status_Timestamps as "EXC_Status_Timestamps"
			{
				type =  form
				form = Exceptions

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === EXC_Status_Timestamps ===
										// Form: Exceptions | Event: Created or Edited | Validations on form submission
										oldRec = Exceptions[ID == input.ID];
										// Resolved_At — kapag bagong naging "Resolved" ang status
										if(input.Exception_Status == "Resolved")
										{
											if(oldRec.Exception_Status != "Resolved")
											{
												Resolved_At = zoho.currenttime;
											}
										}
										// Closed_At — kapag bagong naging "Closed" ang status
										if(input.Exception_Status == "Closed")
										{
											if(oldRec.Exception_Status != "Closed")
											{
												Closed_At = zoho.currenttime;
											}
										}
						)
					}
				}

			}
			EXC_Validate_Status as "EXC_Validate_Status"
			{
				type =  form
				form = Exceptions

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === EXC_Validate_Status ===
										// Form: Exceptions | Event: Created or Edited | Validations on form submission
										// Block "Resolved" if no Resolution_Action
										if(input.Exception_Status == "Resolved")
										{
											if(input.Resolution_Action == null || input.Resolution_Action == "")
											{
												alert "Cannot set status to Resolved — Resolution Action is required before resolving an exception. Please fill in the Resolution Action field.";
												cancel submit;
											}
										}
										// Block "Closed" if not yet Resolved first
										if(input.Exception_Status == "Closed")
										{
											oldRec = Exceptions[ID == input.ID];
											if(oldRec.Exception_Status != "Resolved")
											{
												alert "Cannot set status to Closed — the exception must be Resolved first before it can be Closed.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Receiving_Compute_Totals as "Receiving_Compute_Totals"
			{
				type =  form
				form = Receiving

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											totalExpected = 0;
										totalAccepted = 0;
										totalDamage = 0;
										totalMissing = 0;
										totalLines = 0;
										incompleteLines = 0;
										readyForFulfillment = 0;
										for each  ln in input.Receiving_Line_Items
										{
											totalLines = totalLines + 1;
											totalExpected = totalExpected + ifnull(ln.Expected_Qty,0);
											totalAccepted = totalAccepted + ifnull(ln.Accepted_Qty,0);
											totalDamage = totalDamage + ifnull(ln.Damage_Qty,0);
											totalMissing = totalMissing + ifnull(ln.Missing_Qty,0);
											if(ln.Line_Result == "Incomplete")
											{
												incompleteLines = incompleteLines + 1;
											}
											if(ln.Ready_for_Fulfillment == true)
											{
												readyForFulfillment = readyForFulfillment + 1;
											}
										}
										input.Total_Expected_Qty = totalExpected;
										input.Total_Accepted_Qty = totalAccepted;
										input.Total_Damage_Qty = totalDamage;
										input.Total_Missing_Qty = totalMissing;
										input.Total_Lines = totalLines;
										input.Incomplete_Lines = incompleteLines;
										input.Ready_for_Fulfillment1 = readyForFulfillment;
						)
					}
				}

			}
			Receiving_Set_Line_Result as "Receiving_Set_Line_Result"
			{
				type =  form
				form = Receiving

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  ln in input.Receiving_Line_Items
										{
											accepted = ifnull(ln.Accepted_Qty,0);
											damaged = ifnull(ln.Damage_Qty,0);
											missing = ifnull(ln.Missing_Qty,0);
											expected = ifnull(ln.Expected_Qty,0);
											totalReceived = accepted + damaged + missing;
											if(totalReceived == expected && accepted == expected)
											{
												ln.Line_Result="Complete";
												ln.Ready_for_Fulfillment=true;
											}
											else
											{
												ln.Line_Result="Incomplete";
												ln.Ready_for_Fulfillment=false;
											}
										}
						)
					}
				}

			}
			Receiving_Validate_Qty as "Receiving_Validate_Qty"
			{
				type =  form
				form = Receiving

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  ln in input.Receiving_Line_Items
										{
											accepted = ifnull(ln.Accepted_Qty,0);
											damaged = ifnull(ln.Damage_Qty,0);
											missing = ifnull(ln.Missing_Qty,0);
											expected = ifnull(ln.Expected_Qty,0);
											totalReceived = accepted + damaged + missing;
											// RELAXED 2026-07-30, per user ("we can input below the expected qty but
											// not more than") — was a strict equality block (totalReceived != expected),
											// which made partial receiving impossible: a shipment that only had 5 of 10
											// units arrive couldn't be saved at all until the remaining 5 showed up.
											// Now only blocks a genuine OVER-receive (more than was ever ordered) —
											// under-receiving (a real partial) is allowed and just leaves the line
											// Incomplete (see Receiving_Set_Line_Result above), receivable again later.
											if(expected > 0 && totalReceived > expected)
											{
												alert "Quantity mismatch on line " + ln.PR_No + " — Accepted + Damaged + Missing (" + totalReceived + ") cannot exceed Expected Qty (" + expected + "). Please correct before saving.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Receiving_Auto_Exception as "Receiving_Auto_Exception"
			{
				type =  form
				form = Receiving

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Create_Exception_Requested == true)
										{
											for each  ln in input.Receiving_Line_Items
											{
												damaged = ifnull(ln.Damage_Qty,0);
												missing = ifnull(ln.Missing_Qty,0);
												if(damaged > 0 || missing > 0)
												{
													excExists = false;
													existingEXCId = 0;
													/* CHANGED 2026-10-12, real bug reported live: saving a Receiving without a photo
													   raised EXC-00002, and re-saving after attaching the photo raised EXC-00003 for the
													   same receiving line instead of updating the first one.
													   Cause: this dedup was keyed on ln.PR_No. A Receiving made through the widget's own
													   "Create From Scratch" has no originating PR at all, so its lines carry no PR_No and
													   the criteria matches nothing — the script falls straight through to the insert below
													   on EVERY save.
													   Fix: key on Receive_No + SKU instead, which is always present and always identifies
													   the line. Receiving_Line_ID keeps holding ln.PR_No exactly as before, so everything
													   downstream that reads it (RR_PR_No, Replacement_Summary.PR_No, Shipments) is
													   untouched. Deliberately NOT solved by inventing a PR_No for scratch receivings —
													   that would put a fabricated purchase-request number into records read as real.
													   The old criteria is kept as a fallback so Exceptions raised before this field
													   existed still match, and each one gets stamped with its key on first touch. */
													lineKeyEX = input.Receive_No1 + "||" + ln.SKU;
													for each  excByKey in Exceptions[Exception_Line_Key == lineKeyEX]
													{
														excExists = true;
														existingEXCId = excByKey.ID;
													}
													if(excExists == false)
													{
														prNoEX = ifnull(ln.PR_No,"") + "";
														if(prNoEX.trim() != "")
														{
															existingEXC = Exceptions[Receiving_Line_ID == prNoEX && Receive_No == input.Receive_No1];
															for each  exc in existingEXC
															{
																excExists = true;
																existingEXCId = exc.ID;
																exc.Exception_Line_Key=lineKeyEX;
															}
														}
													}
													if(excExists == false)
													{
														maxNum = 0;
														existingEXCs = Exceptions[ID != 0];
														for each  exc in existingEXCs
														{
															excNoStr = exc.Exception_No;
															if(excNoStr != null && excNoStr != "")
															{
																numPart = excNoStr.removeFirstOccurence("EXC-");
																num = numPart.toLong();
																if(num > maxNum)
																{
																	maxNum = num;
																}
															}
														}
														newNum = maxNum + 1;
														if(newNum < 10)
														{
															newEXCNo = "EXC-0000" + newNum;
														}
														else if(newNum < 100)
														{
															newEXCNo = "EXC-000" + newNum;
														}
														else if(newNum < 1000)
														{
															newEXCNo = "EXC-00" + newNum;
														}
														else if(newNum < 10000)
														{
															newEXCNo = "EXC-0" + newNum;
														}
														else
														{
															newEXCNo = "EXC-" + newNum;
														}
														existingEXCId = insert into Exceptions
														[
															Exception_No=newEXCNo
															Source_Module="Receiving"
															Exception_Status="Open"
															Sales_Order=input.SO_No
															PO_No=input.PO_No
															Shipment_No=input.Shipments.Shipment_No
															Receive_No=input.Receive_No1
															Receiving_Line_ID=ln.PR_No
															Exception_Line_Key=lineKeyEX
															Opened_On=zoho.currentdate.toString("dd-MMM-yyyy")
															Added_User=zoho.loginuser
														];
													}
													ln.Has_Exceptions=true;
												}
											}
											/* One-shot: clear the request so the NEXT ordinary Save does not create again. */
											input.Create_Exception_Requested = false;
										}
										/* OUTSIDE the gate on purpose — Has_Exceptions is persisted on the line, so the count
										   stays correct on every plain Save without re-running any creation. */
										excCount = 0;
										for each  ln in input.Receiving_Line_Items
										{
											if(ln.Has_Exceptions == true)
											{
												excCount = excCount + 1;
											}
										}
										input.Exception_Count = excCount;
						)
					}
				}

			}
			RR_Generate_Number as "RR_Generate_Number"
			{
				type =  form
				form = Replacement_Request

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === RR_Generate_Number ===
										// Form: Replacement_Request | Event: Created | Validations on form submission
										maxNum = 0;
										existingRRs = Replacement_Request[ID != 0];
										for each  rr in existingRRs
										{
											rrNoStr = rr.RR_No;
											if(rrNoStr != null && rrNoStr != "")
											{
												numPart = rrNoStr.removeFirstOccurence("RR-");
												num = numPart.toLong();
												if(num > maxNum)
												{
													maxNum = num;
												}
											}
										}
										newNum = maxNum + 1;
										if(newNum < 10)
										{
											input.RR_No = "RR-0000" + newNum;
										}
										else if(newNum < 100)
										{
											input.RR_No = "RR-000" + newNum;
										}
										else if(newNum < 1000)
										{
											input.RR_No = "RR-00" + newNum;
										}
										else if(newNum < 10000)
										{
											input.RR_No = "RR-0" + newNum;
										}
										else
										{
											input.RR_No = "RR-" + newNum;
										}
						)
					}
				}

			}
