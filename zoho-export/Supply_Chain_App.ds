    			type = image
				displayname = "Actual Photo Upload"
				source  = file
    			file count = 10
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 3
	 			column = 1   
				width = medium
			)
			Actual_Video_Upload
			(
    			type = video
				displayname = "Actual Video Upload"
    			duration=30
	 			row = 3
	 			column = 1   
				width = medium
			)
			Request_Status
			(
				type = picklist
				displayname = "Request Status:"
				maxchar = 100
				values = {"Pending","Done"}
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
