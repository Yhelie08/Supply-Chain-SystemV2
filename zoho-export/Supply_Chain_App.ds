												newCounterTC = 0;
											}
											if(hasChanges == true)
											{
												newStatusTC = "Submit Response";
												newCounterTC = 1;
											}
											if(anySelected == true)
											{
												newStatusTC = "Not Selected";
												newCounterTC = 0;
