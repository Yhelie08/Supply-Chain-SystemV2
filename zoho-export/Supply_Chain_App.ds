			Receiving_Populate_From_S as "Receiving_Populate_From_Shipment"
			{
				type =  form
				form = Receiving

				record event = on add or edit

				on user input of Shipments
				{
					actions 
					{
						custom deluge script
						(
											if(input.Shipments != null)
										{
											shipRec = Shipments[ID == input.Shipments];
											if(shipRec != null)
											{
												input.SO_No = shipRec.Sales_Order;
												input.PO_No = shipRec.PO_No.PO_No;
												input.Customer_Name = shipRec.Customer;
												input.Supplier = shipRec.Supplier;
												orgId = "751117756";
												whId = "2680178000042173149";
												binLocs = List();
												for each  page in {1,2,3,4,5,6}
												{
													binUrl = "https://www.zohoapis.com/books/v3/settings/warehouses/" + whId + "/storagelocations?organization_id=" + orgId + "&page=" + page + "&per_page=200";
													binResp = invokeurl
													[
														url :binUrl
														type :GET
														connection:"zoho_books"
													];
													locs = binResp.get("storage_locations");
													if(locs == null || locs.size() == 0)
													{
														break;
													}
													for each  loc in locs
													{
														binLocs.add(loc);
													}
													hasMore = binResp.get("page_context").get("has_more_page");
													if(hasMore == false)
													{
														break;
													}
												}
												defaultBinNames = {"Package Area","Receiving Area","Default Area"};
												input.Receiving_Line_Items.clear();
												for each  li in shipRec.PO_Shipments
												{
													row = Receiving.Receiving_Line_Items();
													row.PR_No=li.PR_No;
													row.SKU=li.SKU;
													row.Item_Name=li.Item_Name;
													row.Expected_Qty=li.Shipment_QTY;
													input.Receiving_Line_Items.insert(row);
												}
												for each  r in input.Receiving_Line_Items
												{
													itemRecBin = Items[SKU == r.SKU];
													rowCategory = "";
													if(itemRecBin != null)
													{
														rowCategory = itemRecBin.category;
													}
													candidateBins = List();
													if(rowCategory != "")
													{
														for each  loc in binLocs
														{
															zName = loc.get("zone_name") + "";
															if(zName.toLowerCase().contains(rowCategory.toLowerCase()))
															{
																candidateBins.add(loc);
															}
														}
													}
													clear r.Bin_location;
													for each  dName in defaultBinNames
													{
														r.Bin_location:ui.add(dName);
													}
													if(candidateBins.size() > 0)
													{
														for each  cLoc in candidateBins
														{
															r.Bin_location:ui.add(cLoc.get("name"));
														}
													}
													else
													{
														for each  aLoc in binLocs
														{
															r.Bin_location:ui.add(aLoc.get("name"));
														}
													}
													stockedBinName = "";
													if(itemRecBin != null && itemRecBin.ID1 != null && itemRecBin.ID1 != "")
													{
														itemBinResp = invokeurl
														[
															url :"https://www.zohoapis.com/books/v3/settings/warehouses/" + whId + "/storagelocations?organization_id=" + orgId + "&item_id=" + itemRecBin.ID1
															type :GET
															connection:"zoho_books"
														];
														itemBins = itemBinResp.get("storage_locations");
														if(itemBins != null)
														{
															for each  ib in itemBins
															{
																ibQty = ib.get("balance_quantity");
																if(ibQty != null && ibQty > 0 && stockedBinName == "")
																{
																	stockedBinName = ib.get("name") + "";
																}
															}
														}
													}
													if(stockedBinName != "")
													{
														r.Bin_location=stockedBinName;
													}
													else
													{
														r.Bin_location="Receiving Area";
													}
												}
											}
										}
										else
										{
											input.SO_No = "";
											input.PO_No = "";
											input.Customer_Name = "";
											input.Supplier = "";
											input.Receiving_Line_Items.clear();
										}
						)
					}
				}

			}
			Shipment_Edited_Sync_Rece as "Shipment_Edited_Sync_Receiving"
			{
				type =  form
				form = Shipments

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											recvRecs = Receiving[Shipments == input.ID];
										for each  r in recvRecs
										{
											update r
											[
												SO_No=input.Sales_Order
												PO_No=input.PO_No.PO_No
												Customer_Name=input.Customer
												Supplier=input.Supplier
											];
											/* FIXED 2026-07-23, real bug found live ("wait why the expected here became 1
											   this is 2 right?") — this loop used to unconditionally overwrite an
											   ALREADY-EXISTING line's Expected_Qty with li.Shipment_QTY on every single
											   Shipments edit. Harmless historically (one Shipment was always 1:1 with one
											   fresh Receiving line, so Shipment_QTY genuinely WAS the expected qty) — but
											   broke for real the moment the "same RCV, same PO" replacement-recycle
											   architecture (2026-07-20) made it possible for a 2ND Shipment (the cloned
											   replacement, deliberately a SMALLER qty — only the damaged/missing units,
											   not the full original order) to point at the SAME Receiving record. Any
											   edit on that replacement Shipment (e.g. cloneShipmentForReplacement's own
											   `newShipRec.Receiving_Record_Created=true;` write, made right after
											   re-pointing Receiving.Shipments at it) fired THIS workflow, which then
											   clobbered the original line's real Expected_Qty (2) down to the
											   replacement's own smaller Shipment_QTY (1) — confirmed live via direct API
											   diff, 1+0+1 no longer equalled the record's own Expected_Qty, an invariant
											   Receiving_Validate_Qty is supposed to guarantee. This is the EXACT same
											   principle the sibling Created-trigger action (Shipment_Populate_Receiving,
											   right above this one in the same file) already got right in its own 2026-
											   07-20 fix ("Expected_Qty must stay as-is") — just never applied here too.
											   Fixed: an ALREADY-EXISTING line's Expected_Qty is never touched again once
											   set; only a genuinely NEW line (no existing PR_No+SKU match at all) gets
											   Expected_Qty initialized from Shipment_QTY, same as before. */
											for each  li in input.PO_Shipments
											{
												matched = false;
												for each  existingRow in r.Receiving_Line_Items
												{
													if(existingRow.PR_No == li.PR_No && existingRow.SKU == li.SKU)
													{
														matched = true;
													}
												}
												if(matched == false)
												{
													newRow = Receiving.Receiving_Line_Items();
													newRow.PR_No=li.PR_No;
													newRow.SKU=li.SKU;
													newRow.Item_Name=li.Item_Name;
													newRow.Expected_Qty=li.Shipment_QTY;
													r.Receiving_Line_Items.insert(newRow);
												}
											}
										}
						)
					}
				}

			}
			PR_Compute_Priority as "PR_Compute_Priority"
			{
				type =  form
				form = Purchase_Request1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PR_Compute_Priority ===
										// Form: Purchase_Request1 | Event: Created or Edited | Validations on form submission
										score = 0;
										today = zoho.currentdate;
										// === Factor 1: Delivery Urgency — based sa Target_Delivery ===
										if(input.Target_Delivery != null)
										{
											urgencyDiff = (input.Target_Delivery - today);
											daysToDelivery = (urgencyDiff / 86400000).round(0);
											if(daysToDelivery <= 3)
											{
												score = score + 50;
											}
											else if(daysToDelivery <= 7)
											{
												score = score + 30;
											}
											else if(daysToDelivery <= 14)
											{
												score = score + 15;
											}
										}
										// === Factor 2: Order Value — from SO (carried per PR) ===
										orderValue = ifnull(input.Order_Value,0);
										if(orderValue >= 500000)
										{
											score = score + 20;
										}
										// === Factor 3: Has Exception — 0 muna (deferred, Phase 6) ===
										// === Factor 4: Aging — based sa Last_Update DateTime field ===
										if(input.Last_Update != null)
										{
											agingDiff = (today - input.Last_Update.toDate());
											daysIdle = (agingDiff / 86400000).round(0);
											if(daysIdle > 5)
											{
												score = score + 20;
											}
										}
										// === Determine Priority Level ===
										if(score >= 70)
										{
											input.Priority = "High";
										}
										else if(score >= 40)
										{
											input.Priority = "Medium";
										}
										else
										{
											input.Priority = "Low";
										}
										// === Store score for reference ===
										input.Priority_Score = score;
						)
					}
				}

			}
