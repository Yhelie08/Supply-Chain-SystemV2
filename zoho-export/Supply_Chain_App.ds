			Disable_Item_Field_Edit_S1 as "Disable_Item_Field_Edit_Supplier"
			{
				type =  form
				form = Supplier_1

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Response_Status == "Selected")
										{
											if(input.Product_Sample_Supplier == "Completed" && input.D_Image_Supplier == "Completed" && input.Specification_Supplier == "Completed" && input.Technical_Drawing_Supplier == "Completed" && input.Specification_Details_Supplier != null && input.Specification_Details_Supplier != "")
											{
												input.Response_Status = "Completed";
												input.edit_counter = 0;
												recs = Supplier_2[ID == input.ID];
												for each  rec in recs
												{
													rec.Response_Status="Completed";
													rec.edit_counter=0;
												}
											}
										}
										disable INQ_No_Supplier;
										disable SKU_Supplier;
										disable Target_Date_Supplier;
										disable Items_Supplier;
										disable Quantity_Supplier;
										disable Unit_Supplier;
										disable Description_Supplier;
										disable Dropdown1;
										disable Dropdown2;
										disable Date_Created_Supplier;
										disable Open_to_similar_design_Supplier;
										disable Additional_Description_Supplier;
										disable Response_Status;
										disable edit_counter;
										disable Supplier_quotes.SupplierName;
										disable Supplier_quotes.Stage_Supplier;
										disable Supplier_quotes.Selected_Supplier;
										if(input.Response_Status == "Completed")
										{
											disable Supplier_quotes.Availability_Supplier;
											disable Supplier_quotes.Initial_Price_Supplier;
											disable Supplier_quotes.Negotiated_Supplier;
											disable Supplier_quotes.Final_Price_Supplier;
											disable Supplier_quotes.Lead_Time_Supplier;
											disable Product_Sample_Supplier;
											disable D_Image_Supplier;
											disable Specification_Supplier;
											disable Specification_Details_Supplier;
											disable Technical_Drawing_Supplier;
											disable Similar_Design_Photo_Supplier;
										}
										if(input.Response_Status == "Not Selected")
										{
											disable Supplier_quotes.Availability_Supplier;
											disable Supplier_quotes.Initial_Price_Supplier;
											disable Supplier_quotes.Negotiated_Supplier;
											disable Supplier_quotes.Final_Price_Supplier;
											disable Supplier_quotes.Lead_Time_Supplier;
										}
										if(input.Response_Status == "Selected")
										{
											disable Supplier_quotes.Availability_Supplier;
											disable Supplier_quotes.Initial_Price_Supplier;
											disable Supplier_quotes.Negotiated_Supplier;
											disable Supplier_quotes.Final_Price_Supplier;
											disable Supplier_quotes.Lead_Time_Supplier;
										}
										if(input.Response_Status != "Selected" && input.Response_Status != "Completed")
										{
											disable Product_Sample_Supplier;
											disable D_Image_Supplier;
											disable Specification_Supplier;
											disable Specification_Details_Supplier;
											disable Technical_Drawing_Supplier;
											disable Similar_Design_Photo_Supplier;
										}
										// === ADDED 2026-07-08: HideToSupplier override — runs LAST, unconditionally, so it
										// wins over the Selected-based enable above. A field the Inquiry marked HideToSupplier
										// must stay invisible to the supplier even once they're the winning/Selected supplier.
										inqRecsHide = Inquiry_Form[INQ_No == input.INQ_No_Supplier];
										inqProductSampleHide = "";
										inqDImageHide = "";
										inqSpecificationHide = "";
										inqTechnicalDrawingHide = "";
										for each  iqh in inqRecsHide
										{
											inqProductSampleHide = iqh.Product_Sample;
											inqDImageHide = iqh.D_Image;
											inqSpecificationHide = iqh.Specification;
											inqTechnicalDrawingHide = iqh.Technical_Drawing;
										}
										if(inqProductSampleHide == "HideToSupplier")
										{
											hide Product_Sample_Supplier;
											disable Product_Sample_Supplier;
										}
										if(inqDImageHide == "HideToSupplier")
										{
											hide D_Image_Supplier;
											disable D_Image_Supplier;
										}
										if(inqSpecificationHide == "HideToSupplier")
										{
											hide Specification_Supplier;
											disable Specification_Supplier;
											hide Specification_Details_Supplier;
											disable Specification_Details_Supplier;
										}
										if(inqTechnicalDrawingHide == "HideToSupplier")
										{
											hide Technical_Drawing_Supplier;
											disable Technical_Drawing_Supplier;
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Open_to_similar_design_Supplier == true)
										{
											enable Similar_Design_Photo_Supplier;
										}
										else
										{
											disable Similar_Design_Photo_Supplier;
										}
										inqRecords = Inquiry_Form[INQ_No == input.INQ_No_Supplier];
										for each  inq in inqRecords
										{
											if(inq.Product_Sample == "HideToSupplier")
											{
												hide Product_Sample_Supplier;
											}
											if(inq.D_Image == "HideToSupplier")
											{
												hide D_Image_Supplier;
											}
											if(inq.Specification == "HideToSupplier")
											{
												hide Specification_Supplier;
												hide Specification_Details_Supplier;
											}
											if(inq.Technical_Drawing == "HideToSupplier")
											{
												hide Technical_Drawing_Supplier;
											}
											break;
										}
						)
					}
				}

			}
			Stage_Supplier_Changed1 as "Stage_Supplier_Changed"
			{
				type =  form
				form = Supplier_1

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  s2q in input.Supplier_quotes
										{
											nego = s2q.Negotiated_Supplier;
											fp = s2q.Final_Price_Supplier;
											if(nego != null && nego != 0 && fp != null && fp != 0)
											{
												s2q.Stage_Supplier="Final";
											}
											else if(nego != null && nego != 0 || fp != null && fp != 0)
											{
												s2q.Stage_Supplier="Negotiating";
											}
											else
											{
												s2q.Stage_Supplier="Not Selected";
											}
										}
										if(input.Response_Status != "Selected" && input.Response_Status != "Submit Response")
										{
											input.edit_counter = 0;
										}
										if(input.Response_Status == "Selected")
										{
											if(input.Product_Sample_Supplier == "Completed" && input.D_Image_Supplier == "Completed" && input.Specification_Supplier == "Completed" && input.Technical_Drawing_Supplier == "Completed" && input.Specification_Details_Supplier != null && input.Specification_Details_Supplier != "")
											{
												input.Response_Status = "Completed";
												input.edit_counter = 0;
											}
										}
						)
						custom deluge script
						(
											inqNo = input.INQ_No_Supplier;
										inqRecords = Inquiry_Form[INQ_No == inqNo];
										for each  inq in inqRecords
										{
											for each  sq in inq.Supplier_Quotes
											{
												sidRawD2 = sq.Supplier_ID.removeFirstOccurence("[").removeLastOccurence("]");
												quoteBooksIdD2 = "";
												if(sidRawD2 != "")
												{
													for each  supRecD2 in Suppliers
													{
														if(supRecD2.ID + "" == sidRawD2)
														{
															quoteBooksIdD2 = supRecD2.Supplier_ID + "";
														}
													}
												}
												if(quoteBooksIdD2 == "2680178000049168001")
												{
													for each  s2q in input.Supplier_quotes
													{
														sq.Availability=s2q.Availability_Supplier;
														sq.Initial_Price=s2q.Initial_Price_Supplier;
														sq.Negotiated=s2q.Negotiated_Supplier;
														sq.Final_Price=s2q.Final_Price_Supplier;
														sq.Lead_Time=s2q.Lead_Time_Supplier;
														sq.Stage=s2q.Stage_Supplier;
														break;
													}
													break;
												}
											}
											if(inq.Product_Sample != "HideToSupplier")
											{
												inq.Product_Sample=input.Product_Sample_Supplier;
											}
											if(inq.D_Image != "HideToSupplier")
											{
												inq.D_Image=input.D_Image_Supplier;
											}
											if(inq.Specification != "HideToSupplier")
											{
												inq.Specification=input.Specification_Supplier;
												inq.Specification_Details=input.Specification_Details_Supplier;
											}
											if(inq.Technical_Drawing != "HideToSupplier")
											{
												inq.Technical_Drawing=input.Technical_Drawing_Supplier;
											}
											simPhotoStr = input.Similar_Design_Photo_Supplier + "";
											if(input.Similar_Design_Photo_Supplier != null && simPhotoStr != "" && simPhotoStr != "{}" && simPhotoStr != "[]")
											{
												simDesignImgList = List();
												simDesignImgList.add(input.Similar_Design_Photo_Supplier);
												inq.Similar_Design_Photo=simDesignImgList;
											}
											for each  leRow in inq.Supplier_Quotes_Last_Edited
											{
												for each  s2q in input.Supplier_quotes
												{
													if(leRow.Suppliers_Last_Edited == s2q.SupplierName)
													{
														leRow.Availability_Last_Edited=s2q.Availability_Supplier;
														leRow.Initial_Price_Last_Edited=s2q.Initial_Price_Supplier;
														leRow.Negotiated_Last_Edited=s2q.Negotiated_Supplier;
														leRow.Final_Price_Last_Edited=s2q.Final_Price_Supplier;
														leRow.Lead_Time_Last_Edited=s2q.Lead_Time_Supplier;
													}
												}
											}
											break;
										}
										openUrl("#Report:Supplier_1_Report","same window");
						)
					}
				}

			}
			Mandatory_Supplier_Fields1 as "Mandatory_Supplier_Fields"
			{
				type =  form
				form = Supplier_1

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.edit_counter == 0)
										{
											alert "Editing is locked. Wait for inquiry update.";
											cancel submit;
										}
										hasEmpty = false;
										msg = "";
										for each  sq in input.Supplier_quotes
										{
											if(sq.Availability_Supplier == null || sq.Availability_Supplier == "")
											{
												hasEmpty = true;
												msg = msg + "Availability, ";
											}
											if(sq.Availability_Supplier != "Cannot Produce" && sq.Availability_Supplier != "Unavailable" && sq.Availability_Supplier != "Confirmed")
											{
												if(sq.Initial_Price_Supplier == null || sq.Initial_Price_Supplier == 0)
												{
													hasEmpty = true;
													msg = msg + "Initial Price, ";
												}
												if(sq.Final_Price_Supplier == null || sq.Final_Price_Supplier == 0)
												{
													hasEmpty = true;
													msg = msg + "Final Price, ";
												}
											}
											if(sq.Availability_Supplier != "Cannot Produce" && sq.Availability_Supplier != "Unavailable")
											{
												if(sq.Availability_Supplier != "Confirmed")
												{
													if(sq.Lead_Time_Supplier == null || sq.Lead_Time_Supplier == "")
													{
														hasEmpty = true;
														msg = msg + "Lead Time, ";
													}
												}
											}
										}
										if(hasEmpty == true)
										{
											alert "Required fields missing: " + msg.removeLastOccurence(", ");
											cancel submit;
										}
						)
					}
				}

			}
