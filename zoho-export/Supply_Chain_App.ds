			Shipment_Autofill_From_PO1 as "Shipment_Autofill_From_PO"
			{
				type =  form
				form = Shipments

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === Shipment_Autofill_From_PO (DEBUG VERSION) ===
										// Form: Shipments | Event: Created | Validations on form submission
										if(input.PO_No != null)
										{
											info "PO_No raw value: " + input.PO_No;
											info "PO_No.ID: " + input.PO_No.ID;
											poRecord = Purchase_Order[ID == input.PO_No.ID];
											info "poRecord found: " + poRecord;
											if(poRecord != null)
											{
												info "poRecord.SO_No: " + poRecord.SO_No;
												info "poRecord.Customer: " + poRecord.Customer;
												input.Sales_Order = poRecord.SO_No.Sales_Order_Number;
												input.Customer = poRecord.Customer;
												lineItemsList = List();
												suppliers = List();
												lineCount = 0;
												for each  line in poRecord.PO_Line_Items
												{
													lineCount = lineCount + 1;
													lineMap = Map();
													lineMap.put("PR_No",line.PR_No);
													lineMap.put("SKU",line.SKU);
													lineMap.put("Item_Name",line.Item);
													lineMap.put("Ordered_QTY",line.QTY);
													lineMap.put("Shipment_QTY",0);
													lineMap.put("Remaining_QTY",line.QTY);
													lineItemsList.add(lineMap);
													if(!suppliers.contains(line.Supplier))
													{
														suppliers.add(line.Supplier);
													}
												}
												info "Line items processed: " + lineCount;
												Shipment_Line_Items = lineItemsList;
												if(suppliers.size() == 1)
												{
													input.Supplier = suppliers.get(0);
												}
											}
										}
										else
										{
											info "input.PO_No is NULL — dropdown value was not received";
										}
						)
					}
				}

			}
			Shipment_Autofill_From_PO2 as "Shipment_Autofill_From_PO_Live"
			{
				type =  form
				form = Shipments

				record event = on add or edit

				on user input of PO_No
				{
					actions 
					{
						custom deluge script
						(
											// === Shipment_Autofill_From_PO_Live ===
										// Form: Shipments | Event: On User Input of PO No.
										if(input.PO_No != null)
										{
											poRecord = Purchase_Order[ID == input.PO_No.ID];
											if(poRecord != null)
											{
												input.Sales_Order = poRecord.SO_No.Sales_Order_Number;
												input.Customer = poRecord.Customer;
												input.PO_Shipments.clear();
												suppliers = List();
												shippingModes = List();
												for each  line in poRecord.PO_Line_Items
												{
													itemName = "";
													itemIdList = line.Item;
													if(itemIdList != null && itemIdList.toList().size() > 0)
													{
														itemID = itemIdList.toList().get(0);
														itemRec = Items[ID == itemID.toLong()];
														if(itemRec != null)
														{
															itemName = itemRec.item_name;
														}
													}
													row1 = Shipments.PO_Shipments();
													row1.PR_No=line.PR_No;
													row1.SKU=line.SKU;
													row1.Item_Name=itemName;
													row1.Ordered_QTY=line.QTY;
													row1.Shipment_QTY=0;
													row1.Remaining_QTY=line.QTY;
													input.PO_Shipments.insert(row1);
													if(!suppliers.contains(line.Supplier))
													{
														suppliers.add(line.Supplier);
													}
													if(line.Shipping_Mode != null && line.Shipping_Mode != "" && !shippingModes.contains(line.Shipping_Mode))
													{
														shippingModes.add(line.Shipping_Mode);
													}
												}
												if(suppliers.size() == 1)
												{
													input.Supplier = suppliers.get(0);
												}
												if(shippingModes.size() == 1)
												{
													Shipping_Mode = shippingModes.get(0);
												}
											}
										}
						)
					}
				}

			}
