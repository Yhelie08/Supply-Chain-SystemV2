			Acknowledged_PO_Supplier2 as "Acknowledged_PO_Supplier2"
			{
				type =  functions
				form = Tony_Fan_Purchase_Order
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						input.Acknowledge_On_Supplier2 = zoho.currenttime;
										input.PO_Status_Supplier2 = "Confirmed";
										aggPORecsT = Purchase_Order[PO_No == input.PO_No_Supplier2];
										for each  apoT in aggPORecsT
										{
											apoT.Acknowledge_On=zoho.currenttime;
											apoT.PO_Status="Confirmed";
											soNoTextT = apoT.SO_No.Sales_Order_Number;
											matchingShipNoT = "";
											candidateShipmentsT = Shipments[PO_No == apoT.ID && Shipment_Status == "Pending"];
											for each  shT in candidateShipmentsT
											{
												matchingShipNoT = shT.Shipment_No;
											}
											if(matchingShipNoT != "")
											{
												targetShipsT = Shipments[Shipment_No == matchingShipNoT];
												for each  tshT in targetShipsT
												{
													targetShipT = tshT;
												}
											}
											if(apoT.RR_Reference_No != null && apoT.RR_Reference_No != "")
											{
												if(matchingShipNoT == "")
												{
													maxShipNumT = 0;
													existingShipmentsT = Shipments[ID != 0];
													for each  shT in existingShipmentsT
													{
														shipNoStrT = shT.Shipment_No;
														if(shipNoStrT != null && shipNoStrT != "")
														{
															shipNumPartT = shipNoStrT.removeFirstOccurence("SHP-");
															shipNumT = shipNumPartT.toLong();
															if(shipNumT > maxShipNumT)
															{
																maxShipNumT = shipNumT;
															}
														}
													}
													newShipNumT = maxShipNumT + 1;
													if(newShipNumT < 10)
													{
														newShipNoT = "SHP-0000" + newShipNumT;
													}
													else if(newShipNumT < 100)
													{
														newShipNoT = "SHP-000" + newShipNumT;
													}
													else if(newShipNumT < 1000)
													{
														newShipNoT = "SHP-00" + newShipNumT;
													}
													else if(newShipNumT < 10000)
													{
														newShipNoT = "SHP-0" + newShipNumT;
													}
													else
													{
														newShipNoT = "SHP-" + newShipNumT;
													}
													newShipIDT = insert into Shipments
													[
														Shipment_No=newShipNoT
														PO_No=apoT.ID
														Sales_Order=soNoTextT
														Customer=apoT.Customer
														Supplier="Tony"
														Shipment_Status="Pending"
														Added_User=zoho.loginuser
													];
													targetShipT = Shipments[ID == newShipIDT];
												}
												for each  poLnT in apoT.PO_Line_Items
												{
													targetShipT.Required_Days_Lead=poLnT.Required_Days_Lead;
													targetShipT.Remaining_Days=poLnT.Remaining_Days;
													targetShipT.Target_Date=poLnT.Target_Delivery;
													targetShipT.Supplier_Target_Date=poLnT.supplier_target_date;
													targetShipT.Production_Date=poLnT.Production_Date;
													if(poLnT.PR_No != null && poLnT.PR_No != "")
													{
														prLineT = Purchase_Request1[PR_No == poLnT.PR_No];
														targetShipT.Shipment_Days=prLineT.Shipment_Days;
														targetShipT.Sales_Owner=prLineT.Sales_Owner;
													}
													else
													{
														targetShipT.Sales_Owner=apoT.Sales_Owner;
													}
													shipLineExistsT = false;
													for each  existingShipLnT in targetShipT.PO_Shipments
													{
														if(existingShipLnT.PR_No == poLnT.PR_No)
														{
															shipLineExistsT = true;
														}
													}
													if(shipLineExistsT == false)
													{
														newShipLineT = Shipments.PO_Shipments();
														newShipLineT.PR_No=poLnT.PR_No;
														newShipLineT.SKU=poLnT.SKU;
														newShipLineT.Item_Name=poLnT.Item;
														newShipLineT.Ordered_QTY=poLnT.QTY;
														newShipLineT.Shipment_QTY=poLnT.QTY;
														newShipLineT.Remaining_QTY=poLnT.QTY;
														newShipLineT.Shipping_Mode=poLnT.Shipping_Mode;
														targetShipT.PO_Shipments.insert(newShipLineT);
													}
												}
												recvFoundT = false;
												matchingRecvIDT = 0;
												existingRecvT = Receiving[Shipments == targetShipT.ID];
												for each  rcT in existingRecvT
												{
													matchingRecvIDT = rcT.ID;
													recvFoundT = true;
												}
												if(recvFoundT == true)
												{
													targetRecvsT = Receiving[ID == matchingRecvIDT];
													for each  trcT in targetRecvsT
													{
														targetRecvT = trcT;
													}
												}
												else
												{
													maxRecvNumT = 0;
													existingRecvsT = Receiving[ID != 0];
													for each  rcT in existingRecvsT
													{
														recvNoStrT = rcT.Receive_No1;
														if(recvNoStrT != null && recvNoStrT != "")
														{
															recvNumPartT = recvNoStrT.removeFirstOccurence("RCV-");
															recvNumT = recvNumPartT.toLong();
															if(recvNumT > maxRecvNumT)
															{
																maxRecvNumT = recvNumT;
															}
														}
													}
													newRecvNumT = maxRecvNumT + 1;
													if(newRecvNumT < 10)
													{
														newRecvNoT = "RCV-0000" + newRecvNumT;
													}
													else if(newRecvNumT < 100)
													{
														newRecvNoT = "RCV-000" + newRecvNumT;
													}
													else if(newRecvNumT < 1000)
													{
														newRecvNoT = "RCV-00" + newRecvNumT;
													}
													else if(newRecvNumT < 10000)
													{
														newRecvNoT = "RCV-0" + newRecvNumT;
													}
													else
													{
														newRecvNoT = "RCV-" + newRecvNumT;
													}
													newRecvIDT = insert into Receiving
													[
														Receive_No1=newRecvNoT
														Shipments=targetShipT.ID
														SO_No=soNoTextT
														PO_No=apoT.PO_No
														Customer_Name=apoT.Customer
														Supplier="Tony"
														Added_User=zoho.loginuser
													];
													targetRecvT = Receiving[ID == newRecvIDT];
												}
												for each  poLnT in apoT.PO_Line_Items
												{
													if(poLnT.PR_No != null && poLnT.PR_No != "")
													{
														prLineRecvT = Purchase_Request1[PR_No == poLnT.PR_No];
														targetRecvT.Sales_Owner=prLineRecvT.Sales_Owner;
													}
													else
													{
														targetRecvT.Sales_Owner=apoT.Sales_Owner;
													}
													recvLineExistsT = false;
													for each  existingRecvLnT in targetRecvT.Receiving_Line_Items
													{
														if(existingRecvLnT.PR_No == poLnT.PR_No)
														{
															recvLineExistsT = true;
														}
													}
													if(recvLineExistsT == false)
													{
														newRecvLineT = Receiving.Receiving_Line_Items();
														newRecvLineT.PR_No=poLnT.PR_No;
														newRecvLineT.SKU=poLnT.SKU;
														newRecvLineT.Item_Name=poLnT.Item;
														newRecvLineT.Expected_Qty=poLnT.QTY;
														targetRecvT.Receiving_Line_Items.insert(newRecvLineT);
													}
												}
												/* ADDED 2026-07-16 — Tony mirror of the Fenteng block above. */
												totalExpectedT = 0;
												totalAcceptedT = 0;
												totalDamageT = 0;
												totalMissingT = 0;
												totalLinesRT = 0;
												incompleteLinesT = 0;
												readyForFulfillT = 0;
												for each  rln2 in targetRecvT.Receiving_Line_Items
												{
													totalLinesRT = totalLinesRT + 1;
													expRT = ifnull(rln2.Expected_Qty,0);
													accRT = ifnull(rln2.Accepted_Qty,0);
													dmgRT = ifnull(rln2.Damage_Qty,0);
													misRT = ifnull(rln2.Missing_Qty,0);
													totalExpectedT = totalExpectedT + expRT;
													totalAcceptedT = totalAcceptedT + accRT;
													totalDamageT = totalDamageT + dmgRT;
													totalMissingT = totalMissingT + misRT;
													totalRecRT = accRT + dmgRT + misRT;
													if(totalRecRT == expRT && accRT == expRT)
													{
														rln2.Line_Result="Complete";
														rln2.Ready_for_Fulfillment=true;
														readyForFulfillT = readyForFulfillT + 1;
													}
													else
													{
														rln2.Line_Result="Incomplete";
														rln2.Ready_for_Fulfillment=false;
														incompleteLinesT = incompleteLinesT + 1;
													}
												}
												targetRecvT.Total_Expected_Qty=totalExpectedT;
												targetRecvT.Total_Accepted_Qty=totalAcceptedT;
												targetRecvT.Total_Damage_Qty=totalDamageT;
												targetRecvT.Total_Missing_Qty=totalMissingT;
												targetRecvT.Total_Lines=totalLinesRT;
												targetRecvT.Incomplete_Lines=incompleteLinesT;
												targetRecvT.Ready_for_Fulfillment1=readyForFulfillT;
												if(totalLinesRT == 0 || (totalAcceptedT == 0 && totalDamageT == 0 && totalMissingT == 0))
												{
													targetRecvT.Receive_Status="Pending";
												}
												else if(incompleteLinesT == 0)
												{
													targetRecvT.Receive_Status="Received";
												}
												else
												{
													targetRecvT.Receive_Status="Partial Received";
												}
											}
										}
					)
					}
				}
			}
			Acknowledged_PO_Supplier1 as "Acknowledged_PO_Supplier1"
			{
				type =  functions
				form = Fenteng_Lighting_Purchase_Order
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						input.Acknowledge_On_Supplier1 = zoho.currenttime;
										input.PO_Status_Supplier1 = "Confirmed";
										aggPORecsF = Purchase_Order[PO_No == input.PO_No_Supplier1];
										for each  apoF in aggPORecsF
										{
											apoF.Acknowledge_On=zoho.currenttime;
											apoF.PO_Status="Confirmed";
											soNoTextF = apoF.SO_No.Sales_Order_Number;
											matchingShipNoF = "";
											candidateShipmentsF = Shipments[PO_No == apoF.ID && Shipment_Status == "Pending"];
											for each  shF in candidateShipmentsF
											{
												matchingShipNoF = shF.Shipment_No;
											}
											if(matchingShipNoF != "")
											{
												targetShipsF = Shipments[Shipment_No == matchingShipNoF];
												for each  tshF in targetShipsF
												{
													targetShipF = tshF;
												}
											}
											/* Normal (non-replacement) POs: Shipment was already created by PR_Approved, so
											   this native path has nothing to write ETD/ETA onto without its own input source —
											   see the file-level NOTES above. Replacement POs still find-or-create below. */
											if(apoF.RR_Reference_No != null && apoF.RR_Reference_No != "")
											{
												if(matchingShipNoF == "")
												{
													maxShipNumF = 0;
													existingShipmentsF = Shipments[ID != 0];
													for each  shF in existingShipmentsF
													{
														shipNoStrF = shF.Shipment_No;
														if(shipNoStrF != null && shipNoStrF != "")
														{
															shipNumPartF = shipNoStrF.removeFirstOccurence("SHP-");
															shipNumF = shipNumPartF.toLong();
															if(shipNumF > maxShipNumF)
															{
																maxShipNumF = shipNumF;
															}
														}
													}
													newShipNumF = maxShipNumF + 1;
													if(newShipNumF < 10)
													{
														newShipNoF = "SHP-0000" + newShipNumF;
													}
													else if(newShipNumF < 100)
													{
														newShipNoF = "SHP-000" + newShipNumF;
													}
													else if(newShipNumF < 1000)
													{
														newShipNoF = "SHP-00" + newShipNumF;
													}
													else if(newShipNumF < 10000)
													{
														newShipNoF = "SHP-0" + newShipNumF;
													}
													else
													{
														newShipNoF = "SHP-" + newShipNumF;
													}
													newShipIDF = insert into Shipments
													[
														Shipment_No=newShipNoF
														PO_No=apoF.ID
														Sales_Order=soNoTextF
														Customer=apoF.Customer
														Supplier="Fenteng"
														Shipment_Status="Pending"
														Added_User=zoho.loginuser
													];
													targetShipF = Shipments[ID == newShipIDF];
												}
												for each  poLnF in apoF.PO_Line_Items
												{
													targetShipF.Required_Days_Lead=poLnF.Required_Days_Lead;
													targetShipF.Remaining_Days=poLnF.Remaining_Days;
													targetShipF.Target_Date=poLnF.Target_Delivery;
													targetShipF.Supplier_Target_Date=poLnF.supplier_target_date;
													targetShipF.Production_Date=poLnF.Production_Date;
													if(poLnF.PR_No != null && poLnF.PR_No != "")
													{
														prLineF = Purchase_Request1[PR_No == poLnF.PR_No];
														targetShipF.Shipment_Days=prLineF.Shipment_Days;
														targetShipF.Sales_Owner=prLineF.Sales_Owner;
													}
													else
													{
														targetShipF.Sales_Owner=apoF.Sales_Owner;
													}
													shipLineExistsF = false;
													for each  existingShipLnF in targetShipF.PO_Shipments
													{
														if(existingShipLnF.PR_No == poLnF.PR_No)
														{
															shipLineExistsF = true;
														}
													}
													if(shipLineExistsF == false)
													{
														newShipLineF = Shipments.PO_Shipments();
														newShipLineF.PR_No=poLnF.PR_No;
														newShipLineF.SKU=poLnF.SKU;
														newShipLineF.Item_Name=poLnF.Item;
														newShipLineF.Ordered_QTY=poLnF.QTY;
														newShipLineF.Shipment_QTY=poLnF.QTY;
														newShipLineF.Remaining_QTY=poLnF.QTY;
														newShipLineF.Shipping_Mode=poLnF.Shipping_Mode;
														targetShipF.PO_Shipments.insert(newShipLineF);
													}
												}
												recvFoundF = false;
												matchingRecvIDF = 0;
												existingRecvF = Receiving[Shipments == targetShipF.ID];
												for each  rcF in existingRecvF
												{
													matchingRecvIDF = rcF.ID;
													recvFoundF = true;
												}
												if(recvFoundF == true)
												{
													targetRecvsF = Receiving[ID == matchingRecvIDF];
													for each  trcF in targetRecvsF
													{
														targetRecvF = trcF;
													}
												}
												else
												{
													maxRecvNumF = 0;
													existingRecvsF = Receiving[ID != 0];
													for each  rcF in existingRecvsF
													{
														recvNoStrF = rcF.Receive_No1;
														if(recvNoStrF != null && recvNoStrF != "")
														{
															recvNumPartF = recvNoStrF.removeFirstOccurence("RCV-");
															recvNumF = recvNumPartF.toLong();
															if(recvNumF > maxRecvNumF)
															{
																maxRecvNumF = recvNumF;
															}
														}
													}
													newRecvNumF = maxRecvNumF + 1;
													if(newRecvNumF < 10)
													{
														newRecvNoF = "RCV-0000" + newRecvNumF;
													}
													else if(newRecvNumF < 100)
													{
														newRecvNoF = "RCV-000" + newRecvNumF;
													}
													else if(newRecvNumF < 1000)
													{
														newRecvNoF = "RCV-00" + newRecvNumF;
													}
													else if(newRecvNumF < 10000)
													{
														newRecvNoF = "RCV-0" + newRecvNumF;
													}
													else
													{
														newRecvNoF = "RCV-" + newRecvNumF;
													}
													newRecvIDF = insert into Receiving
													[
														Receive_No1=newRecvNoF
														Shipments=targetShipF.ID
														SO_No=soNoTextF
														PO_No=apoF.PO_No
														Customer_Name=apoF.Customer
														Supplier="Fenteng"
														Added_User=zoho.loginuser
													];
													targetRecvF = Receiving[ID == newRecvIDF];
												}
												for each  poLnF in apoF.PO_Line_Items
												{
													if(poLnF.PR_No != null && poLnF.PR_No != "")
													{
														prLineRecvF = Purchase_Request1[PR_No == poLnF.PR_No];
														targetRecvF.Sales_Owner=prLineRecvF.Sales_Owner;
													}
													else
													{
														targetRecvF.Sales_Owner=apoF.Sales_Owner;
													}
													recvLineExistsF = false;
													for each  existingRecvLnF in targetRecvF.Receiving_Line_Items
													{
														if(existingRecvLnF.PR_No == poLnF.PR_No)
														{
															recvLineExistsF = true;
														}
													}
													if(recvLineExistsF == false)
													{
														newRecvLineF = Receiving.Receiving_Line_Items();
														newRecvLineF.PR_No=poLnF.PR_No;
														newRecvLineF.SKU=poLnF.SKU;
														newRecvLineF.Item_Name=poLnF.Item;
														newRecvLineF.Expected_Qty=poLnF.QTY;
														targetRecvF.Receiving_Line_Items.insert(newRecvLineF);
													}
												}
												/* ADDED 2026-07-16, mirrored from pr_to_po_grouping.txt Action 2 — Receiving's
												   own Validations workflows never fire on this cross-form insert either. */
												totalExpectedF = 0;
												totalAcceptedF = 0;
												totalDamageF = 0;
												totalMissingF = 0;
												totalLinesRF = 0;
												incompleteLinesF = 0;
												readyForFulfillF = 0;
												for each  rln in targetRecvF.Receiving_Line_Items
												{
													totalLinesRF = totalLinesRF + 1;
													expRF = ifnull(rln.Expected_Qty,0);
													accRF = ifnull(rln.Accepted_Qty,0);
													dmgRF = ifnull(rln.Damage_Qty,0);
													misRF = ifnull(rln.Missing_Qty,0);
													totalExpectedF = totalExpectedF + expRF;
													totalAcceptedF = totalAcceptedF + accRF;
													totalDamageF = totalDamageF + dmgRF;
													totalMissingF = totalMissingF + misRF;
													totalRecRF = accRF + dmgRF + misRF;
													if(totalRecRF == expRF && accRF == expRF)
													{
														rln.Line_Result="Complete";
														rln.Ready_for_Fulfillment=true;
														readyForFulfillF = readyForFulfillF + 1;
													}
													else
													{
														rln.Line_Result="Incomplete";
														rln.Ready_for_Fulfillment=false;
														incompleteLinesF = incompleteLinesF + 1;
													}
												}
												targetRecvF.Total_Expected_Qty=totalExpectedF;
												targetRecvF.Total_Accepted_Qty=totalAcceptedF;
												targetRecvF.Total_Damage_Qty=totalDamageF;
												targetRecvF.Total_Missing_Qty=totalMissingF;
												targetRecvF.Total_Lines=totalLinesRF;
												targetRecvF.Incomplete_Lines=incompleteLinesF;
												targetRecvF.Ready_for_Fulfillment1=readyForFulfillF;
												if(totalLinesRF == 0 || (totalAcceptedF == 0 && totalDamageF == 0 && totalMissingF == 0))
												{
													targetRecvF.Receive_Status="Pending";
												}
												else if(incompleteLinesF == 0)
												{
													targetRecvF.Receive_Status="Received";
												}
												else
												{
													targetRecvF.Receive_Status="Partial Received";
												}
											}
										}
					)
					}
				}
			}
			Create_Bin_Receiving as "Create_Bin_Receiving"
			{
				type =  functions
				form = Receiving
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						orgId = "751117756";
										/* CHANGED 2026-10-13 — narrowed, NOT removed. This early return is still the only thing
										   keeping a normal HC System (Local) receive out of Books. An HC System REPLACEMENT
										   (Source_Module "Fulfillment EXC") is now let through into the Fulfillment EXC branch
										   just below, which never calls Books (it returns long before the first invokeurl) and
										   is the only place the RR gets closed. Without this, a local replacement stayed Open
										   forever. */
										if(input.Supplier == "HC System" || input.Supplier.contains("HC System") && input.Source_Module != "Fulfillment EXC")
										{
											input.Books_Receive_ID = "";
											input.Books_Receive_No = "N/A (HC System - internal only)";
											info "HC System (Local) receiving - skipped Books, internal only.";
											return;
										}
										/* ADDED 2026-07-27, per user ("dont put it in books") — a Fulfillment-EXC
										   replacement Receiving record (created fresh by clone_shipment_for_replacement.txt,
										   see that file's own NOTES) never sends to Books at all — it's internal-only
										   rework/replace tracking, the real unit was already fully/correctly received and
										   fulfilled once already. SIMPLIFIED 2026-07-27, same day — the original version
										   detected this by matching the linked Shipment's Shipment_No against an
										   Acknowledged RR's Cloned_Shipment_No (a real but indirect proxy). Now that
										   Receiving has its own real Source_Module/Exception_Number fields (per user
										   request, "indicate in shp and rcv that this record is from Fulfillment's
										   Exception" — stamped directly by clone_shipment_for_replacement.txt at
										   creation), this reads them straight off `input` — no Shipments/Replacement_
										   Request lookup needed at all for detection. Completes the moment Accepted_Qty
										   == Expected_Qty on this record's own line(s), per direct user instruction —
										   closes the RR + Exception_Control1 directly, no Books call, no delta
										   computation. */
										fulfillmentExcCheck = input.Source_Module == "Fulfillment EXC";
										fulfillmentExcClosedNo = input.Exception_Number;
										fulfillmentExcClosedRRNo = "";
										if(fulfillmentExcCheck == true)
										{
											if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
											{
												rrLookupCloseF = Fenteng_Lighting_Replacement_Request[Source_Exception_No == fulfillmentExcClosedNo && RR_Status == "Acknowledged"];
												for each  rlcF in rrLookupCloseF
												{
													fulfillmentExcClosedRRNo = rlcF.RR_No;
												}
											}
											else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
											{
												rrLookupCloseT = Tony_Fan_Replacement_Request[Source_Exception_No == fulfillmentExcClosedNo && RR_Status == "Acknowledged"];
												for each  rlcT in rrLookupCloseT
												{
													fulfillmentExcClosedRRNo = rlcT.RR_No;
												}
											}
											/* ADDED 2026-10-13 — HC System has no supplier-side RR form. The local team
											   acknowledges on the MAIN Replacement_Request (Replacement widget, Local tab), so
											   that is the record to find and close. */
											else if(input.Supplier == "HC System" || input.Supplier.contains("HC System"))
											{
												rrLookupCloseH = Replacement_Request[Source_Exception_No == fulfillmentExcClosedNo && RR_Status == "Acknowledged"];
												for each  rlcH in rrLookupCloseH
												{
													fulfillmentExcClosedRRNo = rlcH.RR_No;
												}
											}
											fulfillmentExcExpected = 0;
											fulfillmentExcAccepted = 0;
											for each  rliCheck in input.Receiving_Line_Items
											{
												fulfillmentExcExpected = fulfillmentExcExpected + ifnull(rliCheck.Expected_Qty,0);
												fulfillmentExcAccepted = fulfillmentExcAccepted + ifnull(rliCheck.Accepted_Qty,0);
											}
											if(fulfillmentExcExpected == 0)
											{
												info "No Expected Qty on this replacement receive yet.";
												return;
											}
											if(fulfillmentExcAccepted != fulfillmentExcExpected)
											{
												info "Accepted Qty must equal Expected Qty (" + fulfillmentExcExpected + ") to complete this Fulfillment EXC replacement receive.";
												return;
											}
											// ADDED 2026-08-17, per user report (RR-00001/RR-00002, SO-16489, screenshot
											// of Pre Order Report showing Target Delivery blank) — "target delivery date
											// is based dito", pointing at this exact RR record's own ETA field (the
											// supplier's promised arrival for THIS replacement shipment). Captured here,
											// in the same loop that's already reading this RR record for RR_Status, so
											// no extra fetch is needed — used below to override the Sales_Order_
											// Fulfillment/Pre_Order_FF fallback chain when building poDirectTargetDate,
											// since a replacement's real expected arrival is this shipment's ETA, not
											// the original order's (possibly stale/already-passed) target date.
											ecDirectRR_ETA = "";
											if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
											{
												rrDirectCloseF = Fenteng_Lighting_Replacement_Request[RR_No == fulfillmentExcClosedRRNo];
												for each  rdcF in rrDirectCloseF
												{
													rdcF.RR_Status="Completed";
													rdcFEta = rdcF.ETA + "";
													if(rdcFEta != "" && rdcFEta != "null")
													{
														ecDirectRR_ETA = rdcFEta;
													}
												}
											}
											else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
											{
												rrDirectCloseT = Tony_Fan_Replacement_Request[RR_No == fulfillmentExcClosedRRNo];
												for each  rdcT in rrDirectCloseT
												{
													rdcT.RR_Status="Completed";
													rdcTEta = rdcT.ETA + "";
													if(rdcTEta != "" && rdcTEta != "null")
													{
														ecDirectRR_ETA = rdcTEta;
													}
												}
											}
											/* ADDED 2026-10-13 — same close-out for HC System, on the main Replacement_Request.
											   Its ETA was entered in the Local tab's Acknowledge and drives Target Delivery below,
											   exactly like the supplier's ETA does for Fenteng/Tony. */
											else if(input.Supplier == "HC System" || input.Supplier.contains("HC System"))
											{
												rrDirectCloseH = Replacement_Request[RR_No == fulfillmentExcClosedRRNo];
												for each  rdcH in rrDirectCloseH
												{
													rdcH.RR_Status="Completed";
													rdcHEta = rdcH.ETA + "";
													if(rdcHEta != "" && rdcHEta != "null")
													{
														ecDirectRR_ETA = rdcHEta;
													}
												}
											}
											ecDirectComplete = Exception_Control1[Exception_Number == fulfillmentExcClosedNo];
											ecDirectSO = "";
											ecDirectPAC = "";
											ecDirectItemName = "";
											ecDirectSKU = "";
											ecDirectQty = 1;
											ecDirectPR = "";
											ecDirectRR = "";
											for each  ecdc in ecDirectComplete
											{
												ecDirectSO = ecdc.Sales_Order;
												ecDirectPAC = ecdc.PAC;
												ecDirectItemName = ecdc.Item_Name;
												ecDirectSKU = ecdc.SKU;
												ecDirectQty = ecdc.Qty;
												ecDirectPR = ecdc.PR;
												ecDirectRR = ecdc.RR_No;
												if(ecdc.Status != "Completed")
												{
													ecdc.Status="Completed";
												}
											}
											/* CHANGED 2026-07-27, per user ("change the flow... every completed ->
											   quality check... approved -> aggregate") — this branch used to push
											   straight into Order_Aggregation1 on completion (added 2026-07-27 earlier
											   the same day, see the prior NOTES this replaces). Per the new flow, both
											   the manual Exception Control path AND this Deluge-driven Fulfillment-EXC
											   auto-close now create a Checker_Checklist record (report All_Qc_Reports1)
											   instead — Order Aggregation only ever gets updated once a QC officer sets
											   QC_Status=Approved on that record (UI/FF Widget/QCChecklist's own
											   syncQcApprovedToOrderAggregation()). Same Pre_Order_FF enrichment
											   fallback as before (Exception_Control1 itself doesn't reliably carry
											   Order_Type/Delivery_Type/Target_Delivery/For_Crate/Customer_* — confirmed
											   via the widget's own code, only Sales_Order/PAC/Item_Name/SKU/Qty/PR/
											   RR_No are real there) — richer than the old Order_Aggregation1 push since
											   it also carries RR#, not previously included. New field needed on
											   Checker_Checklist (user creates manually): Exception_Number (Single Line
											   Text) — the only link QCChecklist's own Rejected handler has back to this
											   exception. */
											if(ecDirectSO != "")
											{
												poDirectOrderType = "";
												poDirectDeliveryType = "";
												poDirectTargetDate = "";
												poDirectForCrate = false;
												poDirectCustName = "";
												poDirectCustType = "";
												poDirectCustAddr = "";
												// ADDED 2026-08-06, per user request ("why other fields is not auto
												// populated? like the city email contact") — Pre_Order_FF now carries
												// City/Email/Contact (see so_kanban_sync.txt), relayed onward here so
												// checker_checklist_qc_sync.txt can relay them again into
												// Order_Aggregation1 -> Service_Appointment_Form.
												poDirectCity = "";
												poDirectEmail = "";
												poDirectContact = "";
												// ADDED 2026-08-13, real gap found live — user checked the native Pre_Order_FF
												// record and found Bin Location blank too (same report as the Target Delivery
												// Date gap fixed just above). Bin_Location was never resolved anywhere in this
												// branch at all (not even for the OLD Checker_Checklist insert this branch used
												// to do) — per-SKU, lives on Sales_Order_Fulfillment's own Item_Details1
												// subform (same field/shape so_kanban_sync.txt itself writes), not a header
												// field like the others seeded just below.
												poDirectBinLoc = "";
												// ADDED 2026-08-17 — Payment Status ("Status" field) was never resolved
												// anywhere in this branch at all, same class of gap as Bin_Location above
												// (per user screenshot: Pre Order Report showed this row's Payment Status
												// genuinely blank while sibling rows for the same SO showed "Paid"). No
												// Books/payment lookup needed here — so_kanban_sync.txt's own
												// preOrderData.put("Status", preOrderStatus) is the ONLY place this field
												// is ever computed from Books in the first place; every OTHER Pre_Order_FF
												// row for this same SO already carries that computed value, so it's copied
												// across in the existing Pre_Order_FF fallback loop just below, same
												// pattern as every other field already copied there.
												poDirectStatus = "";
												/* FIXED 2026-08-12, real bug found live (RR-00006 completion, Checker_
												   Checklist row landed with Customer Name/Customer Type/Order Type all
												   blank) — seed from Sales_Order_Fulfillment FIRST, same root cause and
												   fix pattern as clone_shipment_for_replacement.txt's own same-day
												   Customer fix: stock items live in Sales_Order_Fulfillment, not Pre_
												   Order_FF (see that file's writeup). Confirmed field link names via
												   Sales_Order_Fulfillment_Report.txt: order_type/target_delivery_date
												   are genuinely lowercase Field Link Names on this form (not just a
												   REST-API map key), Customer is a lookup (dot-chain .customer_name for
												   display text, same as the Shipment fix), Delivery_Type/For_Crate/
												   Customer_Type match casing elsewhere. City/Email/Contact/Customer_
												   Address are NOT on this form at all — stay Pre_Order_FF-only below.
												   The Pre_Order_FF loop right after is UNCHANGED — for a genuine stock
												   item it still finds nothing so these seeded values survive; for a
												   zero-stock/Pre-Order-type item it still finds its row and overwrites
												   as before, since Pre_Order_FF stays authoritative for that case. */
												sofDirectMatch = Sales_Order_Fulfillment[SO_No == ecDirectSO];
												for each  sofDirect in sofDirectMatch
												{
													sofOrderTypeDirect = sofDirect.order_type + "";
													poDirectOrderType = if(sofOrderTypeDirect == "null","",sofOrderTypeDirect);
													sofDeliveryTypeDirect = sofDirect.Delivery_Type + "";
													poDirectDeliveryType = if(sofDeliveryTypeDirect == "null","",sofDeliveryTypeDirect);
													sofTargetDateDirect = sofDirect.target_delivery_date + "";
													poDirectTargetDate = if(sofTargetDateDirect == "null","",sofTargetDateDirect);
													poDirectForCrate = sofDirect.For_Crate;
													sofCustNameDirect = sofDirect.Customer.customer_name + "";
													poDirectCustName = if(sofCustNameDirect == "null","",sofCustNameDirect);
													sofCustTypeDirect = sofDirect.Customer_Type + "";
													poDirectCustType = if(sofCustTypeDirect == "null","",sofCustTypeDirect);
													for each  sofDirectRow in sofDirect.Item_Details1
													{
														if(sofDirectRow.SKU + "" == ecDirectSKU)
														{
															sofBinDirect = sofDirectRow.Bin_Location + "";
															if(sofBinDirect != "" && sofBinDirect != "null")
															{
																poDirectBinLoc = sofBinDirect;
															}
														}
													}
												}
												poDirectMatch = Pre_Order_FF[SO == ecDirectSO];
												for each  podm in poDirectMatch
												{
													poDirectOrderType = podm.Order_Type;
													poDirectDeliveryType = podm.Delivery_Type;
													poDirectTargetDate = podm.Target_Delivery;
													poDirectForCrate = podm.For_Crate;
													poDirectBinLoc = podm.Bin_Location;
													poDirectCustName = podm.Customer_Name;
													poDirectCustType = podm.Customer_Type;
													poDirectCustAddr = podm.Customer_Address;
													poDirectCity = podm.City;
													poDirectEmail = podm.Email;
													poDirectContact = podm.Contact;
													poDirectStatus = podm.Status;
												}
												// ADDED 2026-08-17, per user — RR's own ETA (captured above, same loop
												// that already reads this RR for RR_Status) takes priority over the
												// Sales_Order_Fulfillment/Pre_Order_FF chain just resolved above, when
												// present — a replacement's real expected arrival is THIS shipment's
												// ETA, not the original order's target date.
												if(ecDirectRR_ETA != "" && ecDirectRR_ETA != "null")
												{
													poDirectTargetDate = ecDirectRR_ETA;
												}
												/* FIXED 2026-08-12, real bug found live (RCV-00006, stock-item Fulfillment
												   EXC receive) — "UnParsable date Line:(141)" / "insert statement is
												   terminated". Same root cause as clone_shipment_for_replacement.txt's own
												   2026-08-12 Customer fix: Pre_Order_FF has no row for an item that already
												   had stock (so_kanban_sync.txt only routes zero-stock/Pre-Order-type items
												   there), so poDirectTargetDate stays "" (its init value) when podm's loop
												   never runs — assigning that blank STRING to a DATE field inside `insert
												   into` crashes the whole statement. Guarded with the same if(cond,a,b)
												   pattern already used elsewhere in this codebase (e.g. this app's own
												   Customer_Name fallback in clone_shipment_for_replacement.txt) — null,
												   not "", so the field is genuinely left unset rather than another blank-
												   string date attempt. */
												// CHANGED 2026-08-13, per user decision ("di na siya babalik sa QC para i-
												// approve, diretso na siya sa Pre Order. wag na siya mag create ng QC. pag
												// ka create ng Receive rekta sa Pre Order") — this branch used to create a
												// Checker_Checklist record here (the "first" QC check, right when the
												// replacement stock is received) and rely on a QC officer manually
												// Approving it to route the item onward (see checker_checklist_qc_sync.txt's
												// own RR-redirect branch history for the full saga this caused: that first
												// QC record kept colliding with the SECOND, genuine physical QC check done
												// later after Pick->Pack, since both shared the same SO+SKU+PAC+RR and the
												// second one kept re-matching/reopening the first one instead of creating
												// its own record). Per user's simplified design, Fulfillment EXC replacement
												// stock skips this first QC check entirely — Create Receive now creates a
												// fresh Pre_Order_FF record directly, same shape checker_checklist_qc_sync.txt
												// itself already creates for a normal RR-driven Pre_Order_FF entry, so the
												// item re-enters the fulfillment pipeline via the Pre Order Report queue
												// exactly the same way. This also fully removes the collision risk at its
												// root — there's no longer a "first" Checker_Checklist record for the later
												// Pack->QC step to ever accidentally re-match against.
												// ADDED 2026-08-13, real gap found live — user checked the native Pre_Order_FF
												// record and found Target Delivery Date blank. poDirectTargetDate was already
												// resolved above (Sales_Order_Fulfillment first, Pre_Order_FF fallback) for the
												// old Checker_Checklist insert this branch used to do, but never actually
												// written onto THIS insert. Same null-vs-blank-string guard already used
												// elsewhere in this file — a blank STRING crashes a DATE field. NOTE: this
												// comment (and the Bin_Location fallback comment above, near poDirectBinLoc)
												// must stay OUTSIDE the insert-into bracket below — a comment placed INSIDE it
												// breaks with a misleading "Improper Statement" reported at an unrelated line
												// (this file's own documented 2026-08-06/2026-08-12 gotcha, re-confirmed live
												// here — first attempt at this exact fix put the comment inside the bracket).
												newPreOrderIdDirect = insert into Pre_Order_FF
												[
													SO=ecDirectSO
													SKU=ecDirectSKU
													Item_Name=ecDirectItemName
													Qty=ecDirectQty + ""
													Pre_Order_Status="Received"
													Customer_Name=poDirectCustName
													Customer_Address=poDirectCustAddr
													Customer_Type=poDirectCustType
													City=poDirectCity
													Email=poDirectEmail
													Contact=poDirectContact
													Order_Type=poDirectOrderType
													PR=ecDirectPR
													RR=ecDirectRR
													Target_Delivery=if(poDirectTargetDate != "" && poDirectTargetDate != null,poDirectTargetDate,null)
													Bin_Location=poDirectBinLoc
													Status=poDirectStatus
													Added_User=zoho.loginuser
												];
												info "Fulfillment EXC replacement received — Pre_Order_FF created directly (no QC), new ID: " + newPreOrderIdDirect + ", SO " + ecDirectSO + " / SKU " + ecDirectSKU + " / RR " + ecDirectRR;
											}
											freshRecvDirect = Receiving[ID == input.ID];
											for each  frd in freshRecvDirect
											{
												frd.Books_Receive_No="N/A (Fulfillment EXC - internal only)";
											}
											success message "Fulfillment EXC replacement received — closed internally, RR and Exception marked Completed. Not sent to Books.";
											return;
										}
										aggPORecsCheck = Purchase_Order[PO_No == input.PO_No];
										isReplacementPO = false;
										rrRefNoCheck = "";
										for each  apoCheck in aggPORecsCheck
										{
											rrValCheck = apoCheck.RR_Reference_No + "";
											if(rrValCheck != "null" && rrValCheck != "")
											{
												isReplacementPO = true;
												rrRefNoCheck = rrValCheck;
											}
										}
										if(isReplacementPO == true)
										{
											rrRecF = List();
											rrRecT = List();
											origPONoRep = "";
											/* FIXED FOR REAL 2026-07-20, mirrored from receiving_widget_custom_api.txt's
											   live-confirmed fix (3-round diagnostic there) — reading `Replacement_Summary`
											   off a queried Fenteng_Lighting_Replacement_Request/Tony_Fan_Replacement_Request
											   record is a genuine, reproducible platform limitation in this context, confirmed
											   via official Zoho Deluge docs: subform access via the `row` keyword is
											   documented as NOT supported in Custom Functions at all, and reading a subform
											   off a criteria-queried (non-`input`) record is undocumented territory entirely —
											   not just an edge case we got unlucky with. WORKAROUND: don't depend on
											   Replacement_Summary for this trace at all — every RR already carries
											   `Source_Exception_No` (a plain HEADER field) pointing at the Exceptions record
											   that raised it, and Exceptions already carries its own `PO_No` (also a plain
											   header field, read constantly elsewhere in this app) — both ordinary field
											   reads, sidestepping the broken path entirely. */
											sourceExcNoRep = "";
											sourceModuleRep = "";
											if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
											{
												rrRecF = Fenteng_Lighting_Replacement_Request[RR_No == rrRefNoCheck];
												for each  rrF in rrRecF
												{
													sourceExcNoRep = rrF.Source_Exception_No;
													sourceModuleRep = rrF.Source_Module;
												}
											}
											else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
											{
												rrRecT = Tony_Fan_Replacement_Request[RR_No == rrRefNoCheck];
												for each  rrT in rrRecT
												{
													sourceExcNoRep = rrT.Source_Exception_No;
													sourceModuleRep = rrT.Source_Module;
												}
											}
											if(sourceExcNoRep != "")
											{
												origExcRep = Exceptions[Exception_No == sourceExcNoRep];
												for each  oeRep in origExcRep
												{
													origPONoRep = oeRep.PO_No;
												}
											}
											/* ADDED 2026-07-27, per user — same Exception_Control1 ("Fulfillment EXC")
											   fallback as clone_shipment_for_replacement.txt's own trace-back, see that
											   file's NOTES for the full reasoning. Gated on sourceModuleRep so a normal
											   Damage/Missing/QC RR never even attempts this branch. */
											if(origPONoRep == "" && sourceModuleRep == "Fulfillment EXC")
											{
												ecMatchRep = Exception_Control1[Exception_Number == sourceExcNoRep];
												ecPrNoRep = "";
												for each  ecmRep in ecMatchRep
												{
													ecPrNoRep = ecmRep.PR;
												}
												if(ecPrNoRep != "")
												{
													pr1MatchRep = Purchase_Request1[PR_No == ecPrNoRep];
													for each  pr1mRep in pr1MatchRep
													{
														origPONoRep = pr1mRep.Link_PO_No;
													}
												}
											}
											if(origPONoRep == "")
											{
												info "Could not trace back to the original PO for this replacement — check Source_Exception_No on the RR and PO_No on the linked Exception (or PR on the linked Exception_Control1 item).";
												return;
											}
											origPOsRep = Purchase_Order[PO_No == origPONoRep];
											origBooksPOId = "";
											for each  opoRep in origPOsRep
											{
												origBooksPOId = opoRep.Books_PO_ID + "";
											}
											/* CHANGED 2026-07-20 — sources Mode of Shipment from THIS Receiving
											   record's own actual Shipment_Mode_When_Received, not the PO's planned
											   Shipping_Mode (was silently falling back to "Air Freight" whenever the
											   PO's planned value was blank). See main CREATE branch's own NOTES. */
											shipModeValRep = "Air Freight";
											for each  rliModeRep in input.Receiving_Line_Items
											{
												shipLineValRep = rliModeRep.Shipment_Mode_When_Received + "";
												if(shipLineValRep == "LCL")
												{
													shipModeValRep = "LCL";
												}
												else if(shipLineValRep == "FCL")
												{
													shipModeValRep = "FCL";
												}
												else if(shipLineValRep != "" && shipLineValRep != "null")
												{
													shipModeValRep = "Air Freight";
												}
											}
											if(origBooksPOId == "" || origBooksPOId == "null")
											{
												info "Original PO " + origPONoRep + " has no Books_PO_ID yet — cannot resolve line_item_ids.";
												return;
											}
											/* CHANGED 2026-07-20, mirrored from receiving_widget_custom_api.txt — since the
											   Books side now creates a brand-new receive instead of updating the
											   original's, the original Receiving record's own Books_Receive_ID is no
											   longer a hard requirement — only origRecvIdRep (for the line reconcile) is.
											   Decoupled: always capture the first matching original Receiving record's own
											   ID regardless of Books send status, only error if none exists at all. */
											origRecvsRep = Receiving[PO_No == origPONoRep];
											origReceiveId = "";
											origReceiveNo = "";
											origRecvIdRep = 0;
											for each  origRecvRep in origRecvsRep
											{
												if(origRecvIdRep == 0)
												{
													origRecvIdRep = origRecvRep.ID;
												}
												candIdRep = origRecvRep.Books_Receive_ID + "";
												if(origReceiveId == "" && candIdRep != "" && candIdRep != "null")
												{
													origReceiveId = candIdRep;
													origReceiveNo = origRecvRep.Books_Receive_No + "";
												}
											}
											if(origRecvIdRep == 0)
											{
												info "No original Receiving record found for PO " + origPONoRep + ".";
												return;
											}
											/* ADDED 2026-07-20, mirrored from receiving_widget_custom_api.txt, per user
											   request ("make it retriggerable") — see that file's own NOTES for the full
											   reasoning. The Books PUT-merge itself must not re-run once this exact
											   replacement record has already been sent once (our "add, don't overwrite"
											   fix means a 2nd PUT would double-add). Everything AFTER the merge (RR
											   completion, Exception resolution, original-line reconcile) is naturally
											   idempotent and safe to re-run — so a retrigger skips the Books call but
											   still falls through to that shared tail using the already-known
											   origReceiveId/origReceiveNo. */
											alreadySentThisRecordRep = false;
											thisRecvBooksIdRep = input.Books_Receive_ID + "";
											if(thisRecvBooksIdRep != "" && thisRecvBooksIdRep != "null")
											{
												alreadySentThisRecordRep = true;
											}
											booksMergeOkRep = false;
											if(alreadySentThisRecordRep == false)
											{
												/* ARCHITECTURE CHANGE 2026-07-20, mirrored from receiving_widget_custom_api.txt
												   — see that file's own NOTES for the full writeup. Real Books rejection
												   hit live: `36510 "bill(s) without receive(s)"` when PUT-updating a
												   receive that already had a Bill against it. Switched to POSTing a
												   brand-new Purchase Receive against the SAME PO instead of editing the
												   old one — Books natively supports multiple receives per PO. Simplified
												   vs. the main CREATE branch further below: no bin/storage assignment. */
												poRespRep = invokeurl
												[
													url :"https://www.zohoapis.com/books/v3/purchaseorders/" + origBooksPOId + "?organization_id=" + orgId
													type :GET
													connection:"zoho_books"
												];
												if(poRespRep.get("purchaseorder") == null)
												{
													info "Could not fetch original Purchase Order — raw resp: " + poRespRep;
													return;
												}
												poLineItemsRep = poRespRep.get("purchaseorder").get("line_items");
												vendorIdRep = "";
												if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
												{
													vendorIdRep = "2680178000049168001";
												}
												else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
												{
													vendorIdRep = "2680178000002735078";
												}
												if(vendorIdRep == "")
												{
													info "Unrecognized Supplier — cannot determine Zoho Books vendor.";
													return;
												}
												newReceiveLineItemsRep = List();
												for each  rliRep in input.Receiving_Line_Items
												{
													if(rliRep.Accepted_Qty == null || rliRep.Accepted_Qty <= 0)
													{
														continue;
													}
													matchedLineItemIdRep = "";
													for each  poliRep in poLineItemsRep
													{
														if(poliRep.get("sku") + "" == rliRep.SKU + "")
														{
															matchedLineItemIdRep = poliRep.get("line_item_id") + "";
														}
													}
													if(matchedLineItemIdRep == "")
													{
														continue;
													}
													newLineMapRep = Map();
													newLineMapRep.put("line_item_id",matchedLineItemIdRep);
													newLineMapRep.put("quantity",rliRep.Accepted_Qty);
													newReceiveLineItemsRep.add(newLineMapRep);
												}
												if(newReceiveLineItemsRep.size() == 0)
												{
													info "No lines with Accepted Qty > 0 matched the original Purchase Order.";
													return;
												}
												shipNoValRep = "";
												if(input.Shipments != null)
												{
													shipRecRep = Shipments[ID == input.Shipments];
													if(shipRecRep != null)
													{
														shipNoValRep = shipRecRep.Shipment_No + "";
													}
												}
												cfListRep = List();
												cfRep1 = Map();
												cfRep1.put("label","PO #");
												cfRep1.put("value",origPONoRep);
												cfListRep.add(cfRep1);
												cfRep2 = Map();
												cfRep2.put("label","Mode of Shipment");
												cfRep2.put("value",shipModeValRep);
												cfListRep.add(cfRep2);
												cfRep3 = Map();
												cfRep3.put("label","Shipment #");
												cfRep3.put("value",shipNoValRep);
												cfListRep.add(cfRep3);
												/* TODO 2026-07-27 — deliberately NOT implemented yet, per user's own explicit
												   scoping ("i'll just add the needed fields"): once Shipments and Receiving
												   each get their own Source_Module (+ Exception_Number) fields (the user is
												   adding these separately), a Fulfillment-EXC-sourced replacement receive
												   should SKIP this whole Books Purchase Receive POST entirely — a Fulfillment
												   EXC item's replacement was never a real Books-costed purchase, it's an
												   internal rework/replace loop. Until those fields exist there is no reliable
												   signal to gate on here (sourceModuleRep is known further up this same
												   function, but Shipments/Receiving themselves don't carry it yet, and this
												   branch can be reached without a Replacement_Request in scope at all on a
												   plain resave) — so this still unconditionally sends to Books for now. When
												   the fields land: gate this whole invokeurl block on
												   `Shipments[ID==input.Shipments].Source_Module != "Fulfillment EXC"`. */
												newReceiveBodyRep = Map();
												newReceiveBodyRep.put("vendor_id",vendorIdRep);
												newReceiveBodyRep.put("date",zoho.currentdate.toString("yyyy-MM-dd"));
												newReceiveBodyRep.put("line_items",newReceiveLineItemsRep);
												newReceiveBodyRep.put("custom_fields",cfListRep);
												createNewRespRep = invokeurl
												[
													url :"https://www.zohoapis.com/books/v3/purchasereceives?organization_id=" + orgId + "&purchaseorder_id=" + origBooksPOId
													type :POST
													parameters:newReceiveBodyRep.toString()
													headers:{"Content-Type":"application/json"}
													connection:"zoho_books"
												];
												info "Replacement new receive create resp: " + createNewRespRep;
												if(createNewRespRep.get("purchasereceive") != null)
												{
													newRepReceiveIdRep = createNewRespRep.get("purchasereceive").get("receive_id") + "";
													newRepReceiveNoRep = createNewRespRep.get("purchasereceive").get("receive_number") + "";
													if(newRepReceiveIdRep == "" || newRepReceiveIdRep == "null" || newRepReceiveNoRep == "" || newRepReceiveNoRep == "null")
													{
														info "Books returned a purchasereceive object but id/number came back blank.";
														return;
													}
													origReceiveId = newRepReceiveIdRep;
													origReceiveNo = newRepReceiveNoRep;
													booksMergeOkRep = true;
												}
												else
												{
													info "Failed to create new Books receive for replacement — check logs.";
													return;
												}
											}
											else
											{
												booksMergeOkRep = true;
											}
											if(booksMergeOkRep == true)
											{
												for each  opoClearRep in origPOsRep
												{
													opoClearRep.Missing_SKUs="";
													opoClearRep.Completed_On=zoho.currenttime;
												}
												for each  apoRepClear in aggPORecsCheck
												{
													apoRepClear.Completed_On=zoho.currenttime;
												}
												closedSourceExcNoRep = "";
												closedRRNoRep = "";
												closedSourceModuleRep = "";
												if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
												{
													supOrigPOsRep = Fenteng_Lighting_Purchase_Order[PO_No_Supplier1 == origPONoRep];
													for each  supOrigRep in supOrigPOsRep
													{
														supOrigRep.Missing_SKUs_Supplier1="";
													}
													for each  rrFClose in rrRecF
													{
														rrFClose.RR_Status="Completed";
														closedSourceExcNoRep = rrFClose.Source_Exception_No;
														closedRRNoRep = rrFClose.RR_No;
														closedSourceModuleRep = rrFClose.Source_Module;
													}
												}
												else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
												{
													supOrigPOsRepT = Tony_Fan_Purchase_Order[PO_No_Supplier2 == origPONoRep];
													for each  supOrigRepT in supOrigPOsRepT
													{
														supOrigRepT.Missing_SKUs_Supplier2="";
													}
													for each  rrTClose in rrRecT
													{
														rrTClose.RR_Status="Completed";
														closedSourceExcNoRep = rrTClose.Source_Exception_No;
														closedRRNoRep = rrTClose.RR_No;
														closedSourceModuleRep = rrTClose.Source_Module;
													}
												}
												/* ADDED 2026-07-20, per user request ("resolve the original Exception too") —
												   only resolves once EVERY RR tied to this Exception (across both supplier
												   forms — an Exception can carry multiple items, e.g. one Damage + one
												   Missing) has reached "Completed". Never clobbers a manually
												   Resolved/Closed Exception. FIXED same day: the fresh re-query below may
												   not see the write just made above in the same execution (same read-lag
												   class hit repeatedly this session) — trust our own write for the RR we
												   JUST closed (closedRRNoRep) instead of re-verifying it via query. */
												if(closedSourceExcNoRep != "")
												{
													allItemsDoneRep = true;
													rrsCheckFRep = Fenteng_Lighting_Replacement_Request[Source_Exception_No == closedSourceExcNoRep];
													for each  rcFRep in rrsCheckFRep
													{
														if(rcFRep.RR_Status != "Completed" && rcFRep.RR_No != closedRRNoRep)
														{
															allItemsDoneRep = false;
														}
													}
													rrsCheckTRep = Tony_Fan_Replacement_Request[Source_Exception_No == closedSourceExcNoRep];
													for each  rcTRep in rrsCheckTRep
													{
														if(rcTRep.RR_Status != "Completed" && rcTRep.RR_No != closedRRNoRep)
														{
															allItemsDoneRep = false;
														}
													}
													if(allItemsDoneRep == true)
													{
														/* BRANCHED 2026-07-27, per user — a Fulfillment-EXC-sourced RR has no
														   native Exceptions record behind it at all (Exception_Control1 is a
														   separate form), so resolving Exceptions here would silently no-op
														   (0 matches) and never actually close the loop for these items.
														   closedSourceModuleRep is read straight off the RR we just closed,
														   same safe-header-field pattern as everything else in this block. */
														if(closedSourceModuleRep == "Fulfillment EXC")
														{
															ecToCompleteRep = Exception_Control1[Exception_Number == closedSourceExcNoRep];
															for each  ecCompleteRep in ecToCompleteRep
															{
																if(ecCompleteRep.Status != "Completed")
																{
																	ecCompleteRep.Status="Completed";
																}
															}
														}
														else
														{
															excToResolveRep = Exceptions[Exception_No == closedSourceExcNoRep];
															for each  exResolveRep in excToResolveRep
															{
																if(exResolveRep.Exception_Status != "Resolved" && exResolveRep.Exception_Status != "Closed")
																{
																	exResolveRep.Exception_Status="Resolved";
																}
															}
														}
													}
												}
												freshRecvRep = Receiving[ID == input.ID];
												for each  frRep in freshRecvRep
												{
													frRep.Books_Receive_ID=origReceiveId;
													frRep.Books_Receive_No=origReceiveNo;
													// ADDED 2026-07-30 — see the main CREATE branch's own NOTES for the
													// full reasoning (SKU_Receive_History, append-only per-SKU Books
													// receive-event log).
													skuHistCountMapRep = Map();
													for each  existSKURowRep in frRep.SKU_Receive_History
													{
														skuHistKeyRep = existSKURowRep.SKU + "";
														if(skuHistCountMapRep.containKey(skuHistKeyRep))
														{
															skuHistCountMapRep.put(skuHistKeyRep,skuHistCountMapRep.get(skuHistKeyRep) + 1);
														}
														else
														{
															skuHistCountMapRep.put(skuHistKeyRep,1);
														}
													}
													for each  rliRepTL in input.Receiving_Line_Items
													{
														if(rliRepTL.Accepted_Qty != null && rliRepTL.Accepted_Qty > 0)
														{
															newPRTRep = Receiving.Partial_Receive_Timeline();
															newPRTRep.RR_No=frRep.Receive_No1;
															newPRTRep.Supplier=input.Supplier;
															newPRTRep.SKU=rliRepTL.SKU;
															newPRTRep.Item=rliRepTL.Item_Name;
															newPRTRep.Quantity=rliRepTL.Accepted_Qty + "";
															newPRTRep.Shipment_Mode=rliRepTL.Shipment_Mode_When_Received;
															newPRTRep.Date_Time=zoho.currenttime;
															frRep.Partial_Receive_Timeline.insert(newPRTRep);
															skuHistKeyInsRep = rliRepTL.SKU + "";
															if(skuHistCountMapRep.containKey(skuHistKeyInsRep))
															{
																nextSkuHistCountRep = skuHistCountMapRep.get(skuHistKeyInsRep) + 1;
															}
															else
															{
																nextSkuHistCountRep = 1;
															}
															skuHistCountMapRep.put(skuHistKeyInsRep,nextSkuHistCountRep);
															newSRHRep = Receiving.SKU_Receive_History();
															newSRHRep.Item=rliRepTL.Item_Name;
															newSRHRep.SKU=rliRepTL.SKU;
															newSRHRep.Item_QTY=rliRepTL.Accepted_Qty;
															newSRHRep.Receive_Count=nextSkuHistCountRep;
															newSRHRep.Books_Receive_No=origReceiveNo;
															newSRHRep.Books_Receive_ID=origReceiveId;
															frRep.SKU_Receive_History.insert(newSRHRep);
														}
													}
												}
												/* ADDED 2026-07-20, mirrored from receiving_widget_custom_api.txt — see that
												   file's own NOTES for the full reasoning (reconciles the ORIGINAL Receiving
												   record's line: moves qty from Damage into Accepted once the replacement is
												   merged, via the proven clear+rebuild subform pattern, never in-place
												   mutation). FIXED live 2026-07-20: first version held the raw subform-row
												   object in a List (`existingRowsRep.add(olRep)`) then read `.field` off it
												   later outside its own loop — errored "Invalid collection object found", a
												   documented Deluge Gotcha in this codebase. Fixed by extracting plain field
												   VALUES into a Map the moment each row is visited, never holding the row
												   object itself past its own loop iteration. */
												if(origRecvIdRep > 0)
												{
													origRecvFullRep = Receiving[ID == origRecvIdRep];
													for each  origFullRep in origRecvFullRep
													{
														existingRowsRep = List();
														for each  olRep in origFullRep.Receiving_Line_Items
														{
															rowMapRep = Map();
															rowMapRep.put("PR_No",olRep.PR_No);
															rowMapRep.put("RR_No",olRep.RR_No);
															rowMapRep.put("SKU",olRep.SKU);
															rowMapRep.put("Single_Line",olRep.Single_Line);
															rowMapRep.put("Item_Name",olRep.Item_Name);
															rowMapRep.put("Expected_Qty",olRep.Expected_Qty);
															rowMapRep.put("Accepted_Qty",olRep.Accepted_Qty);
															rowMapRep.put("Damage_Qty",olRep.Damage_Qty);
															rowMapRep.put("Missing_Qty",olRep.Missing_Qty);
															rowMapRep.put("Bin_location",olRep.Bin_location);
															rowMapRep.put("Shipment_Mode_When_Received",olRep.Shipment_Mode_When_Received);
															rowMapRep.put("Line_Result",olRep.Line_Result);
															rowMapRep.put("Has_Exceptions",olRep.Has_Exceptions);
															rowMapRep.put("Ready_for_Fulfillment",olRep.Ready_for_Fulfillment);
															rowMapRep.put("Label_Ready",olRep.Label_Ready);
															rowMapRep.put("Label_Printed",olRep.Label_Printed);
															existingRowsRep.add(rowMapRep);
														}
														origFullRep.Receiving_Line_Items.clear();
														deltaAcceptedRep = 0;
														deltaDamageRep = 0;
														for each  oldRowMapRep in existingRowsRep
														{
															oldSkuRep = oldRowMapRep.get("SKU") + "";
															replQtyForSkuRep = 0;
															for each  rliRep2 in input.Receiving_Line_Items
															{
																if(rliRep2.SKU + "" == oldSkuRep && rliRep2.Accepted_Qty != null && rliRep2.Accepted_Qty > 0)
																{
																	replQtyForSkuRep = replQtyForSkuRep + rliRep2.Accepted_Qty;
																}
															}
															newRowRep = Receiving.Receiving_Line_Items();
															newRowRep.PR_No=oldRowMapRep.get("PR_No");
															newRowRep.RR_No=oldRowMapRep.get("RR_No");
															newRowRep.SKU=oldRowMapRep.get("SKU");
															newRowRep.Single_Line=oldRowMapRep.get("Single_Line");
															newRowRep.Item_Name=oldRowMapRep.get("Item_Name");
															newRowRep.Expected_Qty=oldRowMapRep.get("Expected_Qty");
															newRowRep.Bin_location=oldRowMapRep.get("Bin_location");
															newRowRep.Shipment_Mode_When_Received=oldRowMapRep.get("Shipment_Mode_When_Received");
															newRowRep.Line_Result=oldRowMapRep.get("Line_Result");
															newRowRep.Has_Exceptions=oldRowMapRep.get("Has_Exceptions");
															newRowRep.Ready_for_Fulfillment=oldRowMapRep.get("Ready_for_Fulfillment");
															newRowRep.Label_Ready=oldRowMapRep.get("Label_Ready");
															newRowRep.Label_Printed=oldRowMapRep.get("Label_Printed");
															if(replQtyForSkuRep > 0)
															{
																oldAcceptedRep = ifnull(oldRowMapRep.get("Accepted_Qty"),0);
																oldDamageRep = ifnull(oldRowMapRep.get("Damage_Qty"),0);
																appliedRep = replQtyForSkuRep;
																if(appliedRep > oldDamageRep)
																{
																	appliedRep = oldDamageRep;
																}
																newRowRep.Accepted_Qty=oldAcceptedRep + appliedRep;
																newRowRep.Damage_Qty=oldDamageRep - appliedRep;
																newRowRep.Missing_Qty=ifnull(oldRowMapRep.get("Missing_Qty"),0);
																deltaAcceptedRep = deltaAcceptedRep + appliedRep;
																deltaDamageRep = deltaDamageRep + appliedRep;
															}
															else
															{
																newRowRep.Accepted_Qty=oldRowMapRep.get("Accepted_Qty");
																newRowRep.Damage_Qty=oldRowMapRep.get("Damage_Qty");
																newRowRep.Missing_Qty=oldRowMapRep.get("Missing_Qty");
															}
															origFullRep.Receiving_Line_Items.insert(newRowRep);
														}
														if(deltaAcceptedRep > 0)
														{
															origFullRep.Total_Accepted_Qty=ifnull(origFullRep.Total_Accepted_Qty,0) + deltaAcceptedRep;
															origFullRep.Total_Damage_Qty=ifnull(origFullRep.Total_Damage_Qty,0) - deltaDamageRep;
														}
													}
												}
												successSuffixRep = "";
												if(alreadySentThisRecordRep == true)
												{
													successSuffixRep = " (re-synced RR/Exception/reconcile only — Books already had this qty.)";
												}
												success message "Replacement received — new Books receive " + origReceiveNo + " created against the original PO, RR marked Completed." + successSuffixRep;
											}
											return;
										}
										if(input.Books_Receive_ID != null && input.Books_Receive_ID != "")
										{
											/* CHANGED 2026-07-20, per user — real architecture simplification. This branch
											   used to be Missing-only. Generalized to ALSO cover Damage (Missing_SKUs OR
											   Damage_SKUs on the linked PO), since Damage/QC/Complaint replacements no
											   longer spin up a separate Creator-only PO (see create_rr_button.txt's own
											   NOTES) — they recycle through this SAME record/SAME PO exactly like Missing
											   always has. */
											/* GATE REMOVED 2026-07-30, per user request ("i just wanna create receive
											   for example item 1. then next day item 2 is in warehouse and accepted
											   -> create receive btn will create new PR for that item too") — this
											   used to hard-stop here ("Already sent to Zoho Books") unless
											   Missing_SKUs/Damage_SKUs happened to be set on the linked PO, meaning a
											   perfectly ordinary "a different line just became ready" 2nd click did
											   NOTHING at all. The per-line DELTA computation a few lines below
											   (sentDeltaMapUpd/newLineItemsUpd, added 2026-07-20) already generically
											   handles "any line whose Accepted_Qty exceeds what's already logged in
											   Partial_Receive_Timeline for it" — completely independent of Missing/
											   Damage flags, which only ever existed to gate ENTRY into this branch,
											   not to select which lines get sent. Removing the gate lets that already
											   generic delta logic run on every click; `missingSKU`/`damageSKU` are no
											   longer used for anything (grepped — only ever fed this one gate), the
											   real no-op guard is now purely `newLineItemsUpd.size() == 0` below
											   ("No lines with Accepted Qty > 0 to send"), which already existed. */
											linkedPOsCheck = Purchase_Order[PO_No == input.PO_No];
											booksPOIdUpd = "";
											for each  lpoId in linkedPOsCheck
											{
												booksPOIdUpd = lpoId.Books_PO_ID + "";
											}
											/* CHANGED 2026-07-20 — same fix as the replacement branch: sources Mode of
											   Shipment from THIS Receiving record's own actual
											   Shipment_Mode_When_Received, not the PO's planned Shipping_Mode. */
											shipModeValUpd = "Air Freight";
											for each  rliModeUpd in input.Receiving_Line_Items
											{
												shipLineValUpd = rliModeUpd.Shipment_Mode_When_Received + "";
												if(shipLineValUpd == "LCL")
												{
													shipModeValUpd = "LCL";
												}
												else if(shipLineValUpd == "FCL")
												{
													shipModeValUpd = "FCL";
												}
												else if(shipLineValUpd != "" && shipLineValUpd != "null")
												{
													shipModeValUpd = "Air Freight";
												}
											}
											if(booksPOIdUpd == "" || booksPOIdUpd == "null")
											{
												info "Linked Purchase_Order has no Books_PO_ID — cannot resolve PO line_item_ids.";
												return;
											}
											/* ARCHITECTURE CHANGE 2026-07-20, mirrored from receiving_widget_custom_api.txt —
											   same real 36510 "bill(s) without receive(s)" rejection risk as the replacement
											   branch above applies here too (this record's own Books_Receive_ID may already
											   be billed). Switched from PUT-updating the existing receive to POSTing a
											   brand-new Purchase Receive against the same PO — deliberately does NOT
											   overwrite input.Books_Receive_ID/No, those keep pointing at the original
											   receive; the new receive exists independently in Books tied to the same PO. */
											poRespUpd = invokeurl
											[
												url :"https://www.zohoapis.com/books/v3/purchaseorders/" + booksPOIdUpd + "?organization_id=" + orgId
												type :GET
												connection:"zoho_books"
											];
											if(poRespUpd.get("purchaseorder") == null)
											{
												info "Could not fetch linked Purchase Order — raw resp: " + poRespUpd;
												return;
											}
											poLineItemsUpd = poRespUpd.get("purchaseorder").get("line_items");
											vendorIdUpd = "";
											if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
											{
												vendorIdUpd = "2680178000049168001";
											}
											else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
											{
												vendorIdUpd = "2680178000002735078";
											}
											if(vendorIdUpd == "")
											{
												info "Unrecognized Supplier — cannot determine Zoho Books vendor.";
												return;
											}
											/* ADDED 2026-07-27, per user ("real fix" — option 2 of 2 offered) — a
											   Fulfillment-EXC replacement (UI/FF Widget/ExceptionControl) is a genuinely
											   different case than Damage/Missing: the original Receiving line was already
											   FULLY and CORRECTLY accepted at fulfillment time (Accepted_Qty already
											   matches Expected_Qty, Damage/Missing both 0) — the defect surfaced LATER,
											   post-delivery, via Exception Control. There is no "under-received" line to
											   top up, so the delta-against-Accepted_Qty math below (built for Damage/
											   Missing, where Accepted_Qty genuinely needs to climb toward Expected_Qty as
											   replacement stock arrives) always computes 0 for these — confirmed live,
											   real bug found on RR-00004/EXC-FF-00004: Accepted_Qty stayed "2" (unchanged
											   since 2026-07-24), Partial_Receive_Timeline already showed 2 sent, delta=0,
											   the whole POST got skipped ("No lines with Accepted Qty > 0 to send"),
											   Damage_SKUs/RR/Exception_Control1 never advanced. Fixed: any Acknowledged
											   "QC Failure"/"Fulfillment EXC" RR tied to this PO sends its OWN
											   `RR_Qty_Value` directly, bypassing the Accepted_Qty/delta computation for
											   that SKU entirely — same Exception_Control1 trace-back chain used
											   everywhere else this session. */
											fulfillmentExcQtyMap = Map();
											rrCandF = Fenteng_Lighting_Replacement_Request[Source_Type == "QC Failure" && Source_Module == "Fulfillment EXC" && RR_Status == "Acknowledged"];
											for each  fecF in rrCandF
											{
												fecOrigPOF = "";
												fecExcMatchF = Exception_Control1[Exception_Number == fecF.Source_Exception_No];
												fecPrNoF = "";
												for each  fecmF in fecExcMatchF
												{
													fecPrNoF = fecmF.PR;
												}
												if(fecPrNoF != "")
												{
													fecPr1MatchF = Purchase_Request1[PR_No == fecPrNoF];
													for each  fecpr1F in fecPr1MatchF
													{
														fecOrigPOF = fecpr1F.Link_PO_No;
													}
												}
												if(fecOrigPOF == input.PO_No)
												{
													/* FIXED 2026-07-27, real bug found live — RR_SKU/RR_Qty_Value are
													   mirror fields that only ever get set on the AGGREGATE
													   Replacement_Request (same convention create_rr_button.txt's own
													   native supplier-form inserts already follow — they never set these on
													   the supplier form either), confirmed live blank on the Tony supplier
													   record. Look up the aggregate by RR_No to get the real values. */
													fecAggMatchF = Replacement_Request[RR_No == fecF.RR_No];
													for each  fecAggF in fecAggMatchF
													{
														fulfillmentExcQtyMap.put(fecAggF.RR_SKU + "",fecAggF.RR_Qty_Value);
													}
												}
											}
											rrCandT = Tony_Fan_Replacement_Request[Source_Type == "QC Failure" && Source_Module == "Fulfillment EXC" && RR_Status == "Acknowledged"];
											for each  fecT in rrCandT
											{
												fecOrigPOT = "";
												fecExcMatchT = Exception_Control1[Exception_Number == fecT.Source_Exception_No];
												fecPrNoT = "";
												for each  fecmT in fecExcMatchT
												{
													fecPrNoT = fecmT.PR;
												}
												if(fecPrNoT != "")
												{
													fecPr1MatchT = Purchase_Request1[PR_No == fecPrNoT];
													for each  fecpr1T in fecPr1MatchT
													{
														fecOrigPOT = fecpr1T.Link_PO_No;
													}
												}
												if(fecOrigPOT == input.PO_No)
												{
													fecAggMatchT = Replacement_Request[RR_No == fecT.RR_No];
													for each  fecAggT in fecAggMatchT
													{
														fulfillmentExcQtyMap.put(fecAggT.RR_SKU + "",fecAggT.RR_Qty_Value);
													}
												}
											}
											/* ADDED 2026-07-20 — DELTA computation, needed now that this branch also covers
											   Damage (which, unlike Missing, already had SOME qty sent on the original
											   Create Receive click). Sending the full current Accepted_Qty again would
											   double-count what Books already has for that SKU — exactly the real 36012
											   "Quantity recorded cannot be more than quantity ordered" error hit earlier
											   this session. Fixed by subtracting whatever this SKU already logged in
											   Partial_Receive_Timeline (this record's own subform, safe to read off
											   `input` directly — unlike a subform on a different, criteria-queried
											   record) and only sending the remainder. For Missing, prior-sent is always 0
											   (that line was skipped entirely on the first click), so this reduces to the
											   same full-qty behavior as before — no change for that case. Fulfillment-EXC
											   SKUs (fulfillmentExcQtyMap) skip this whole delta computation, see above. */
											sentDeltaMapUpd = Map();
											newLineItemsUpd = List();
											for each  poli in poLineItemsUpd
											{
												matchedNewQty = 0;
												hasQty = false;
												poliSkuUpd = poli.get("sku") + "";
												if(fulfillmentExcQtyMap.containKey(poliSkuUpd))
												{
													matchedNewQty = fulfillmentExcQtyMap.get(poliSkuUpd);
													hasQty = true;
												}
												else
												{
													for each  rli in input.Receiving_Line_Items
													{
														if(rli.SKU + "" == poli.get("sku") + "" && rli.Accepted_Qty != null && rli.Accepted_Qty > 0)
														{
															priorSentQtyUpd = 0;
															for each  ptRowUpd in input.Partial_Receive_Timeline
															{
																if(ptRowUpd.SKU + "" == rli.SKU + "")
																{
																	priorSentQtyUpd = priorSentQtyUpd + ifnull((ptRowUpd.Quantity + "").toLong(),0);
																}
															}
															deltaQtyUpd = rli.Accepted_Qty - priorSentQtyUpd;
															if(deltaQtyUpd > 0)
															{
																matchedNewQty = deltaQtyUpd;
																hasQty = true;
															}
														}
													}
												}
												if(hasQty == false)
												{
													continue;
												}
												sentDeltaMapUpd.put(poli.get("sku") + "",matchedNewQty);
												newLineMapUpd = Map();
												newLineMapUpd.put("line_item_id",poli.get("line_item_id") + "");
												newLineMapUpd.put("quantity",matchedNewQty);
												newLineItemsUpd.add(newLineMapUpd);
											}
											if(newLineItemsUpd.size() == 0)
											{
												info "No lines with Accepted Qty > 0 to send.";
												return;
											}
											shipNoValUpd = "";
											if(input.Shipments != null)
											{
												shipRecUpd = Shipments[ID == input.Shipments];
												if(shipRecUpd != null)
												{
													shipNoValUpd = shipRecUpd.Shipment_No + "";
												}
											}
											cfListUpd = List();
											cfUpd1 = Map();
											cfUpd1.put("label","PO #");
											cfUpd1.put("value",input.PO_No);
											cfListUpd.add(cfUpd1);
											cfUpd2 = Map();
											cfUpd2.put("label","Mode of Shipment");
											cfUpd2.put("value",shipModeValUpd);
											cfListUpd.add(cfUpd2);
											cfUpd3 = Map();
											cfUpd3.put("label","Shipment #");
											cfUpd3.put("value",shipNoValUpd);
											cfListUpd.add(cfUpd3);
											newReceiveBodyUpd = Map();
											newReceiveBodyUpd.put("vendor_id",vendorIdUpd);
											newReceiveBodyUpd.put("date",zoho.currentdate.toString("yyyy-MM-dd"));
											newReceiveBodyUpd.put("line_items",newLineItemsUpd);
											newReceiveBodyUpd.put("custom_fields",cfListUpd);
											/* TODO 2026-07-27 — same deliberate non-implementation as the "Rep" branch's own
											   marker above: once Shipments/Receiving get their own Source_Module field, gate
											   this whole Books POST on it being != "Fulfillment EXC". Not gated yet. */
											updateResp = invokeurl
											[
												url :"https://www.zohoapis.com/books/v3/purchasereceives?organization_id=" + orgId + "&purchaseorder_id=" + booksPOIdUpd
												type :POST
												parameters:newReceiveBodyUpd.toString()
												headers:{"Content-Type":"application/json"}
												connection:"zoho_books"
											];
											info "New Books receive create resp (missing-item branch): " + updateResp;
											if(updateResp.get("purchasereceive") != null)
											{
												// ADDED 2026-07-30 — captured for SKU_Receive_History below, since this
												// branch deliberately never overwrites the record's own header
												// Books_Receive_ID/No (those still point at the ORIGINAL receive).
												newUpdReceiveId = updateResp.get("purchasereceive").get("receive_id") + "";
												newUpdReceiveNo = updateResp.get("purchasereceive").get("receive_number") + "";
												for each  lpoClear in linkedPOsCheck
												{
													/* CHANGED 2026-07-20 — clears whichever flag(s) were actually set
													   (Missing_SKUs and/or Damage_SKUs), not just Missing_SKUs. */
													lpoClear.Missing_SKUs="";
													lpoClear.Damage_SKUs="";
													lpoClear.Completed_On=zoho.currenttime;
													/* ADDED 2026-07-20 — same PO Completion Check as the main CREATE branch,
													   see that block's own NOTES. This is the branch that actually closes
													   the loop for a real recycle — the whole point of this redesign. */
													if(lpoClear.PO_Status != "Completed")
													{
														allLinesFullUpd = true;
														for each  poLnCompUpd in lpoClear.PO_Line_Items
														{
															skuAcceptedSumUpd = 0;
															for each  rliCompUpd in input.Receiving_Line_Items
															{
																if(rliCompUpd.SKU == poLnCompUpd.SKU)
																{
																	skuAcceptedSumUpd = skuAcceptedSumUpd + ifnull(rliCompUpd.Accepted_Qty,0);
																}
															}
															if(skuAcceptedSumUpd < poLnCompUpd.QTY)
															{
																allLinesFullUpd = false;
															}
														}
														if(allLinesFullUpd == true)
														{
															openExcCompCheckUpd = Exceptions[PO_No == lpoClear.PO_No && Exception_Status == "Open"];
															if(openExcCompCheckUpd.count() == 0)
															{
																lpoClear.PO_Status="Completed";
															}
														}
													}
												}
												// ADDED 2026-07-30, per user request — mirrors the main CREATE branch's own
												// per-line Pre_Order_FF completeness flip (see that block's own comment for
												// the full reasoning). Real gap found live: this Upd/delta branch never had
												// it, so a line that only reaches Accepted==Expected via THIS branch (not
												// the original CREATE click — e.g. "item 2 became ready the next day" now
												// routes through here since the isReplacementUpdate gate was removed the
												// same day) stayed stuck on Pre_Order_Status="Pending" forever, even though
												// its Books receive genuinely succeeded. Confirmed live on SO-16335/
												// Aelornyrae — needed a manual patch before this fix existed.
												for each  rliPoStatUpd in input.Receiving_Line_Items
												{
													rliPoStatCompleteUpd = ifnull(rliPoStatUpd.Accepted_Qty,0) == ifnull(rliPoStatUpd.Expected_Qty,0) && ifnull(rliPoStatUpd.Damage_Qty,0) == 0 && ifnull(rliPoStatUpd.Missing_Qty,0) == 0 && ifnull(rliPoStatUpd.Expected_Qty,0) > 0;
													if(rliPoStatCompleteUpd == true)
													{
														for each  pofRecStatUpd in Pre_Order_FF[SO == input.SO_No && SKU == rliPoStatUpd.SKU && Pre_Order_Status != "Received"]
														{
															pofRecStatUpd.Pre_Order_Status="Received";
														}
													}
												}
												closedSourceExcNoUpd = "";
												closedRRNoUpd = "";
												closedSourceModuleUpd = "";
												/* FIXED 2026-07-20 — matchOrigPOUpdF/T used to read
												   rrcUpdF/T.Replacement_Summary, a subform off a criteria-queried record —
												   the same confirmed-unreliable platform limitation already fixed in the
												   trace-back block above (see that block's own NOTES). Replaced with the
												   same header-field workaround: RR's own Source_Exception_No ->
												   Exceptions.PO_No, both plain field reads. */
												if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
												{
													supPOsClearF = Fenteng_Lighting_Purchase_Order[PO_No_Supplier1 == input.PO_No];
													for each  spClearF in supPOsClearF
													{
														spClearF.Missing_SKUs_Supplier1="";
														spClearF.Damage_SKUs_Supplier1="";
													}
												}
												else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
												{
													supPOsClearT = Tony_Fan_Purchase_Order[PO_No_Supplier2 == input.PO_No];
													for each  spClearT in supPOsClearT
													{
														spClearT.Missing_SKUs_Supplier2="";
														spClearT.Damage_SKUs_Supplier2="";
													}
												}
												/* CHANGED 2026-10-13 — the RR close-out no longer follows the RECEIVING's supplier.
												   A Proc RR can be routed to a different supplier (Exceptions widget, Create RR) while
												   the replacement is still received on the ORIGINAL Receiving and into the ORIGINAL
												   PO in Books (no new PO — it completes the qty the damage left short). The supplier
												   PO clean-up above stays keyed on the original supplier, because it is their PO; the
												   RR to close is wherever it was routed — Fenteng, Tony, or the MAIN
												   Replacement_Request for HC System (which has no supplier-side form). All three are
												   matched on the same thing as before: the RR's exception points at THIS PO. */
												/* CHANGED 2026-07-20 — now closes both Missing AND Damage RRs (this
												   branch handles both now, see the generalized gate above). CHANGED
												   2026-07-27, per user's Fulfillment EXC ask — also closes "QC Failure"
												   RRs (the Source_Type ExceptionControl's Create RR uses, see that
												   widget's own row) — this filter had silently excluded them entirely,
												   real bug found live on RR-00004/EXC-FF-00004 (Books receive succeeded
												   but RR_Status/Exception_Control1.Status never advanced, traced to this
												   exact query never matching). */
												rrToCloseUpdF = Fenteng_Lighting_Replacement_Request[Source_Type == "Receiving Missing" || Source_Type == "Receiving Damage" || Source_Type == "QC Failure" && RR_Status == "Acknowledged"];
												for each  rrcUpdF in rrToCloseUpdF
												{
													matchOrigPOUpdF = "";
													matchModuleUpdF = rrcUpdF.Source_Module;
													excCheckUpdF = Exceptions[Exception_No == rrcUpdF.Source_Exception_No];
													for each  ecUpdF in excCheckUpdF
													{
														matchOrigPOUpdF = ecUpdF.PO_No;
													}
													/* ADDED 2026-07-27 — same Exception_Control1 fallback as the "Rep"
													   branch and clone_shipment_for_replacement.txt, see those files'
													   own NOTES for the full reasoning. */
													if(matchOrigPOUpdF == "" && matchModuleUpdF == "Fulfillment EXC")
													{
														ecMatchUpdF = Exception_Control1[Exception_Number == rrcUpdF.Source_Exception_No];
														ecPrNoUpdF = "";
														for each  ecmUpdF in ecMatchUpdF
														{
															ecPrNoUpdF = ecmUpdF.PR;
														}
														if(ecPrNoUpdF != "")
														{
															pr1MatchUpdF = Purchase_Request1[PR_No == ecPrNoUpdF];
															for each  pr1mUpdF in pr1MatchUpdF
															{
																matchOrigPOUpdF = pr1mUpdF.Link_PO_No;
															}
														}
													}
													if(matchOrigPOUpdF == input.PO_No)
													{
														rrcUpdF.RR_Status="Completed";
														closedSourceExcNoUpd = rrcUpdF.Source_Exception_No;
														closedRRNoUpd = rrcUpdF.RR_No;
														closedSourceModuleUpd = matchModuleUpdF;
													}
												}
												rrToCloseUpdT = Tony_Fan_Replacement_Request[Source_Type == "Receiving Missing" || Source_Type == "Receiving Damage" || Source_Type == "QC Failure" && RR_Status == "Acknowledged"];
												for each  rrcUpdT in rrToCloseUpdT
												{
													matchOrigPOUpdT = "";
													matchModuleUpdT = rrcUpdT.Source_Module;
													excCheckUpdT = Exceptions[Exception_No == rrcUpdT.Source_Exception_No];
													for each  ecUpdT in excCheckUpdT
													{
														matchOrigPOUpdT = ecUpdT.PO_No;
													}
													if(matchOrigPOUpdT == "" && matchModuleUpdT == "Fulfillment EXC")
													{
														ecMatchUpdT = Exception_Control1[Exception_Number == rrcUpdT.Source_Exception_No];
														ecPrNoUpdT = "";
														for each  ecmUpdT in ecMatchUpdT
														{
															ecPrNoUpdT = ecmUpdT.PR;
														}
														if(ecPrNoUpdT != "")
														{
															pr1MatchUpdT = Purchase_Request1[PR_No == ecPrNoUpdT];
															for each  pr1mUpdT in pr1MatchUpdT
															{
																matchOrigPOUpdT = pr1mUpdT.Link_PO_No;
															}
														}
													}
													if(matchOrigPOUpdT == input.PO_No)
													{
														rrcUpdT.RR_Status="Completed";
														closedSourceExcNoUpd = rrcUpdT.Source_Exception_No;
														closedRRNoUpd = rrcUpdT.RR_No;
														closedSourceModuleUpd = matchModuleUpdT;
													}
												}
												rrToCloseUpdH = Replacement_Request[RR_Supplier == "HC System" && RR_Status == "Acknowledged"];
												for each  rrcUpdH in rrToCloseUpdH
												{
													matchOrigPOUpdH = "";
													excCheckUpdH = Exceptions[Exception_No == rrcUpdH.Source_Exception_No];
													for each  ecUpdH in excCheckUpdH
													{
														matchOrigPOUpdH = ecUpdH.PO_No;
													}
													if(matchOrigPOUpdH != "" && matchOrigPOUpdH == input.PO_No)
													{
														rrcUpdH.RR_Status="Completed";
														closedSourceExcNoUpd = rrcUpdH.Source_Exception_No;
														closedRRNoUpd = rrcUpdH.RR_No;
														closedSourceModuleUpd = rrcUpdH.Source_Module;
													}
												}
												/* ADDED 2026-07-20, per user request ("resolve the original Exception too") —
												   the Missing-path branch never advanced its own RR's status before (unlike
												   the Damage/replacement branch, which already did) — real gap, fixed here.
												   Same "only resolve once every item on this Exception is Completed" guard as
												   the replacement branch, see that one's own comment — including the same
												   read-lag fix (trust our own write for closedRRNoUpd, don't require the
												   fresh re-query to already reflect it). */
												if(closedSourceExcNoUpd != "")
												{
													allItemsDoneUpd = true;
													rrsCheckFUpd = Fenteng_Lighting_Replacement_Request[Source_Exception_No == closedSourceExcNoUpd];
													for each  rcFUpd in rrsCheckFUpd
													{
														if(rcFUpd.RR_Status != "Completed" && rcFUpd.RR_Status != "Cancelled" && rcFUpd.RR_No != closedRRNoUpd)
														{
															allItemsDoneUpd = false;
														}
													}
													rrsCheckTUpd = Tony_Fan_Replacement_Request[Source_Exception_No == closedSourceExcNoUpd];
													for each  rcTUpd in rrsCheckTUpd
													{
														if(rcTUpd.RR_Status != "Completed" && rcTUpd.RR_Status != "Cancelled" && rcTUpd.RR_No != closedRRNoUpd)
														{
															allItemsDoneUpd = false;
														}
													}
													// ADDED 2026-10-13 — HC System RRs live only on the main Replacement_Request.
													rrsCheckHUpd = Replacement_Request[Source_Exception_No == closedSourceExcNoUpd && RR_Supplier == "HC System"];
													for each  rcHUpd in rrsCheckHUpd
													{
														if(rcHUpd.RR_Status != "Completed" && rcHUpd.RR_Status != "Cancelled" && rcHUpd.RR_No != closedRRNoUpd)
														{
															allItemsDoneUpd = false;
														}
													}
													if(allItemsDoneUpd == true)
													{
														/* BRANCHED 2026-07-27, per user — mirrors the "Rep" branch's own
														   same-day branch, see that one's comment for the full reasoning. */
														if(closedSourceModuleUpd == "Fulfillment EXC")
														{
															ecToCompleteUpd = Exception_Control1[Exception_Number == closedSourceExcNoUpd];
															for each  ecCompleteUpd in ecToCompleteUpd
															{
																if(ecCompleteUpd.Status != "Completed")
																{
																	ecCompleteUpd.Status="Completed";
																}
															}
														}
														else
														{
															excToResolveUpd = Exceptions[Exception_No == closedSourceExcNoUpd];
															for each  exResolveUpd in excToResolveUpd
															{
																if(exResolveUpd.Exception_Status != "Resolved" && exResolveUpd.Exception_Status != "Closed")
																{
																	exResolveUpd.Exception_Status="Resolved";
																}
															}
														}
													}
												}
												freshRecvUpd = Receiving[ID == input.ID];
												for each  fruUpd in freshRecvUpd
												{
													// ADDED 2026-07-30 — see the main CREATE branch's own NOTES for the
													// full reasoning (SKU_Receive_History, append-only per-SKU Books
													// receive-event log). Item_QTY here = deltaSentTL (the same delta
													// already computed/logged into Partial_Receive_Timeline below), not
													// the line's full current Accepted_Qty.
													skuHistCountMapUpd = Map();
													for each  existSKURowUpd in fruUpd.SKU_Receive_History
													{
														skuHistKeyUpd = existSKURowUpd.SKU + "";
														if(skuHistCountMapUpd.containKey(skuHistKeyUpd))
														{
															skuHistCountMapUpd.put(skuHistKeyUpd,skuHistCountMapUpd.get(skuHistKeyUpd) + 1);
														}
														else
														{
															skuHistCountMapUpd.put(skuHistKeyUpd,1);
														}
													}
													for each  rliUpdTL in input.Receiving_Line_Items
													{
														/* CHANGED 2026-07-20 — logs the DELTA actually sent to Books this
														   click (sentDeltaMapUpd, computed above), not the line's full
														   current Accepted_Qty. This subform IS the ledger the delta
														   computation reads from on the NEXT recycle click — logging the
														   full qty here would make a 3rd click under-count/over-subtract. */
														deltaSentTL = sentDeltaMapUpd.get(rliUpdTL.SKU + "");
														if(deltaSentTL != null && deltaSentTL > 0)
														{
															newPRTUpd = Receiving.Partial_Receive_Timeline();
															newPRTUpd.RR_No=fruUpd.Receive_No1;
															newPRTUpd.Supplier=input.Supplier;
															newPRTUpd.SKU=rliUpdTL.SKU;
															newPRTUpd.Item=rliUpdTL.Item_Name;
															newPRTUpd.Quantity=deltaSentTL + "";
															newPRTUpd.Shipment_Mode=rliUpdTL.Shipment_Mode_When_Received;
															newPRTUpd.Date_Time=zoho.currenttime;
															fruUpd.Partial_Receive_Timeline.insert(newPRTUpd);
															skuHistKeyInsUpd = rliUpdTL.SKU + "";
															if(skuHistCountMapUpd.containKey(skuHistKeyInsUpd))
															{
																nextSkuHistCountUpd = skuHistCountMapUpd.get(skuHistKeyInsUpd) + 1;
															}
															else
															{
																nextSkuHistCountUpd = 1;
															}
															skuHistCountMapUpd.put(skuHistKeyInsUpd,nextSkuHistCountUpd);
															newSRHUpd = Receiving.SKU_Receive_History();
															newSRHUpd.Item=rliUpdTL.Item_Name;
															newSRHUpd.SKU=rliUpdTL.SKU;
															newSRHUpd.Item_QTY=deltaSentTL;
															newSRHUpd.Receive_Count=nextSkuHistCountUpd;
															newSRHUpd.Books_Receive_No=newUpdReceiveNo;
															newSRHUpd.Books_Receive_ID=newUpdReceiveId;
															fruUpd.SKU_Receive_History.insert(newSRHUpd);
														}
													}
												}
												success message "New Books receive created for the replacement item(s) against PO " + input.PO_No + " — resolved.";
											}
											else
											{
												info "Failed to create new Books receive for the replacement item(s). Raw: " + updateResp;
											}
											return;
										}
										if(input.Receiving_Line_Items == null || input.Receiving_Line_Items.count() == 0)
										{
											info "No line items to receive.";
											return;
										}
										vendorId = "";
										if(input.Supplier == "Fenteng" || input.Supplier.contains("Fenteng"))
										{
											vendorId = "2680178000049168001";
										}
										else if(input.Supplier == "Tony" || input.Supplier.contains("Tony"))
										{
											vendorId = "2680178000002735078";
										}
										if(vendorId == "")
										{
											info "Unrecognized Supplier — cannot determine Zoho Books vendor.";
											return;
										}
										aggPORecs = Purchase_Order[PO_No == input.PO_No];
										booksPOId = "";
										for each  apo in aggPORecs
										{
											booksPOId = apo.Books_PO_ID + "";
											break;
										}
										/* CHANGED 2026-07-20, per user — was sourcing Mode of Shipment from the PO's
										   own PLANNED Shipping_Mode (often blank, silently fell back to the "Air
										   Freight" default regardless of what was actually received). Now sources
										   from THIS Receiving record's own ACTUAL Shipment_Mode_When_Received per
										   line — the field this whole feature exists for, distinct from the PO's
										   planned value by design. Mirrored into the replacement/missing branches
										   above/below and into receiving_widget_custom_api.txt. */
										shipModeVal = "Air Freight";
										for each  rliMode in input.Receiving_Line_Items
										{
											shipLineVal = rliMode.Shipment_Mode_When_Received + "";
											if(shipLineVal == "LCL")
											{
												shipModeVal = "LCL";
											}
											else if(shipLineVal == "FCL")
											{
												shipModeVal = "FCL";
											}
											else if(shipLineVal != "" && shipLineVal != "null")
											{
												shipModeVal = "Air Freight";
											}
										}
										if(booksPOId == "" || booksPOId == "null")
										{
											info "Linked Purchase_Order has no Books_PO_ID yet — acknowledge the supplier PO first.";
											return;
										}
										shipNoVal = "";
										if(input.Shipments != null)
										{
											shipRec = Shipments[ID == input.Shipments];
											if(shipRec != null)
											{
												shipNoVal = shipRec.Shipment_No + "";
											}
										}
										booksPOResp = invokeurl
										[
											url :"https://www.zohoapis.com/books/v3/purchaseorders/" + booksPOId + "?organization_id=" + orgId
											type :GET
											connection:"zoho_books"
										];
										booksPOLineItems = List();
										if(booksPOResp.get("purchaseorder") != null)
										{
											booksPOLineItems = booksPOResp.get("purchaseorder").get("line_items");
										}
										binLocsRecv = List();
										for each  page in {1,2,3,4,5,6}
										{
											binUrlRecv = "https://www.zohoapis.com/books/v3/settings/warehouses/2680178000042173149/storagelocations?organization_id=" + orgId + "&page=" + page + "&per_page=200";
											binRespRecv = invokeurl
											[
												url :binUrlRecv
												type :GET
												connection:"zoho_books"
											];
											locsRecv = binRespRecv.get("storage_locations");
											if(locsRecv == null || locsRecv.size() == 0)
											{
												break;
											}
											for each  locRecv in locsRecv
											{
												binLocsRecv.add(locRecv);
											}
											hasMoreRecv = binRespRecv.get("page_context").get("has_more_page");
											if(hasMoreRecv == false)
											{
												break;
											}
										}
										receiveLineItems = List();
										for each  rli in input.Receiving_Line_Items
										{
											if(rli.Accepted_Qty == null || rli.Accepted_Qty == 0)
											{
												continue;
											}
											matchedLineItemId = "";
											matchedItemId = "";
											for each  bpoLi in booksPOLineItems
											{
												if(bpoLi.get("sku") + "" == rli.SKU + "")
												{
													matchedLineItemId = bpoLi.get("line_item_id") + "";
													matchedItemId = bpoLi.get("item_id") + "";
												}
											}
											if(matchedLineItemId == "")
											{
												continue;
											}
											lineMap = Map();
											lineMap.put("line_item_id",matchedLineItemId);
											lineMap.put("quantity",rli.Accepted_Qty);
											lineMap.put("warehouse_id","2680178000042173149");
											itemIsBinTracked = false;
											if(matchedItemId != "")
											{
												itemDetailResp = invokeurl
												[
													url :"https://www.zohoapis.com/books/v3/items/" + matchedItemId + "?organization_id=" + orgId
													type :GET
													connection:"zoho_books"
												];
												if(itemDetailResp.get("item") != null)
												{
													itemWarehouses = itemDetailResp.get("item").get("warehouses");
													if(itemWarehouses != null)
													{
														for each  iwh in itemWarehouses
														{
															info "SKU " + rli.SKU + " warehouse check: whId=" + iwh.get("warehouse_id") + " | is_storage_location_enabled=" + iwh.get("is_storage_location_enabled");
															if(iwh.get("warehouse_id") + "" == "2680178000042173149" && iwh.get("is_storage_location_enabled") == true || iwh.get("is_storage_location_enabled") + "" == "true")
															{
																itemIsBinTracked = true;
															}
														}
													}
												}
											}
											info "SKU " + rli.SKU + " itemIsBinTracked: " + itemIsBinTracked;
											if(itemIsBinTracked == true && rli.Bin_location != null && rli.Bin_location != "")
											{
												matchedStorageId = "";
												matchedStorageName = "";
												for each  bl in binLocsRecv
												{
													if(bl.get("name") + "" == rli.Bin_location + "")
													{
														matchedStorageId = bl.get("storage_id") + "";
														matchedStorageName = bl.get("name") + "";
													}
												}
												info "SKU " + rli.SKU + " bin match: Bin_location=" + rli.Bin_location + " -> matchedStorageId=" + matchedStorageId;
												if(matchedStorageId != "")
												{
													storageRow = Map();
													storageRow.put("storage_id",matchedStorageId);
													storageRow.put("in_quantity",rli.Accepted_Qty);
													storageList = List();
													storageList.add(storageRow);
													lineMap.put("storages",storageList);
												}
											}
											receiveLineItems.add(lineMap);
										}
										if(receiveLineItems.size() == 0)
										{
											info "No lines with Accepted Qty > 0 matched the linked Books Purchase Order.";
											return;
										}
										cfList = List();
										cf1 = Map();
										cf1.put("label","Shipment #");
										cf1.put("value",shipNoVal);
										cfList.add(cf1);
										cf2 = Map();
										cf2.put("label","PO #");
										cf2.put("value",input.PO_No);
										cfList.add(cf2);
										cf3 = Map();
										cf3.put("label","Mode of Shipment");
										cf3.put("value",shipModeVal);
										cfList.add(cf3);
										receiveBody = Map();
										receiveBody.put("vendor_id",vendorId);
										receiveBody.put("date",zoho.currentdate.toString("yyyy-MM-dd"));
										receiveBody.put("line_items",receiveLineItems);
										receiveBody.put("custom_fields",cfList);
										createRespRecv = invokeurl
										[
											url :"https://www.zohoapis.com/books/v3/purchasereceives?organization_id=" + orgId + "&purchaseorder_id=" + booksPOId
											type :POST
											parameters:receiveBody.toString()
											headers:{"Content-Type":"application/json"}
											connection:"zoho_books"
										];
										info "createRespRecv: " + createRespRecv;
										if(createRespRecv.get("purchasereceive") != null)
										{
											/* FIXED FOR REAL 2026-07-20, mirrored from receiving_widget_custom_api.txt —
											   ROOT CAUSE of the whole "null" saga: these key names were simply wrong.
											   Books' real keys are `receive_id`/`receive_number`, confirmed via a real
											   captured raw response (a genuinely successful create, PR-06372). The old
											   keys silently returned null every time (no error, since "purchasereceive"
											   itself was always non-null), producing the literal string "null" that kept
											   getting written into Books_Receive_ID/No. */
											newReceiveId = createRespRecv.get("purchasereceive").get("receive_id") + "";
											newReceiveNo = createRespRecv.get("purchasereceive").get("receive_number") + "";
											freshRecv = Receiving[ID == input.ID];
											for each  fr in freshRecv
											{
												fr.Books_Receive_ID=newReceiveId;
												fr.Books_Receive_No=newReceiveNo;
												// ADDED 2026-07-30, per user request — SKU_Receive_History is a new
												// append-only per-SKU log of every real Books receive-event created
												// against this Receiving record (a single RCV can now legitimately
												// get multiple real Books Purchase Receives over time — partial
												// delta/replacement recycle/missing-SKU updates all POST a brand-new
												// receive each time, see this file's own 2026-07-20 redesign notes).
												// Item_QTY = qty actually sent to Books THIS event (not cumulative).
												// Receive_Count = per-SKU sequence number within this record, seeded
												// from whatever's already logged before this event's own inserts.
												skuHistCountMap = Map();
												for each  existSKURow in fr.SKU_Receive_History
												{
													skuHistKey = existSKURow.SKU + "";
													if(skuHistCountMap.containKey(skuHistKey))
													{
														skuHistCountMap.put(skuHistKey,skuHistCountMap.get(skuHistKey) + 1);
													}
													else
													{
														skuHistCountMap.put(skuHistKey,1);
													}
												}
												for each  rliTL in input.Receiving_Line_Items
												{
													if(rliTL.Accepted_Qty != null && rliTL.Accepted_Qty > 0)
													{
														newPRT = Receiving.Partial_Receive_Timeline();
														newPRT.RR_No=fr.Receive_No1;
														newPRT.Supplier=input.Supplier;
														newPRT.SKU=rliTL.SKU;
														newPRT.Item=rliTL.Item_Name;
														newPRT.Quantity=rliTL.Accepted_Qty + "";
														newPRT.Shipment_Mode=rliTL.Shipment_Mode_When_Received;
														newPRT.Date_Time=zoho.currenttime;
														fr.Partial_Receive_Timeline.insert(newPRT);
														skuHistKeyIns = rliTL.SKU + "";
														if(skuHistCountMap.containKey(skuHistKeyIns))
														{
															nextSkuHistCount = skuHistCountMap.get(skuHistKeyIns) + 1;
														}
														else
														{
															nextSkuHistCount = 1;
														}
														skuHistCountMap.put(skuHistKeyIns,nextSkuHistCount);
														newSRH = Receiving.SKU_Receive_History();
														newSRH.Item=rliTL.Item_Name;
														newSRH.SKU=rliTL.SKU;
														newSRH.Item_QTY=rliTL.Accepted_Qty;
														newSRH.Receive_Count=nextSkuHistCount;
														newSRH.Books_Receive_No=newReceiveNo;
														newSRH.Books_Receive_ID=newReceiveId;
														fr.SKU_Receive_History.insert(newSRH);
													}
												}
											}
											// ADDED 2026-07-29, per user request ("create receive success will send
											// bin location into -> these two forms too") — pushes the REAL bin
											// location actually used at receiving time into Sales_Order_Fulfillment
											// (Item_Details1 subform, per-row SKU) and Pre_Order_FF (plain header
											// Bin_Location field, one record per item). Best-effort — a miss on
											// either form is a silent no-op, never blocks/fails the receive itself
											// (matches this app's own established "secondary sync, don't roll back
											// the primary success" convention). Sales_Order_Fulfillment write uses
											// the proven full-subform-rebuild pattern (no-ID clear+insert) since a
											// plain in-place row mutation is documented-unreliable in this codebase.
											// FIXED 2026-07-29, real bug found live (RCV-00007, both forms' own
											// Bin_Location stayed blank despite the receive succeeding): the original
											// match criteria (PR_No/PR == rliBin.PR_No) never matches anything — a
											// live pull confirmed BOTH forms genuinely have PR_No/PR blank on every
											// real record (Sales_Order_Fulfillment is populated by so_kanban_sync.txt,
											// which never sets PR_No at all; same for Pre_Order_FF's own PR field).
											// Switched to matching by SO_No/SO instead (input.SO_No, a real reliably-
											// populated header field on Receiving, confirmed via live schema pull)
											// combined with the existing per-row/per-record SKU match.
											for each  rliBin in input.Receiving_Line_Items
											{
												if(rliBin.Bin_location == null || rliBin.Bin_location == "")
												{
													continue;
												}
												for each  sofRec in Sales_Order_Fulfillment[SO_No == input.SO_No]
												{
													sofRowMapsBin = List();
													sofRowMatchedBin = false;
													for each  sofRowBin in sofRec.Item_Details1
													{
														sofRm = Map();
														sofRm.put("Item",sofRowBin.Item);
														sofRm.put("SKU",sofRowBin.SKU);
														sofRm.put("Quantity",sofRowBin.Quantity);
														if(sofRowBin.SKU + "" == rliBin.SKU + "")
														{
															sofRm.put("Bin_Location",rliBin.Bin_location + "");
															sofRowMatchedBin = true;
														}
														else
														{
															sofRm.put("Bin_Location",sofRowBin.Bin_Location);
														}
														sofRowMapsBin.add(sofRm);
													}
													if(sofRowMatchedBin == true)
													{
														sofRec.Item_Details1.clear();
														for each  sofRmRow in sofRowMapsBin
														{
															newSofBinRow = Sales_Order_Fulfillment.Item_Details1();
															newSofBinRow.Item=sofRmRow.get("Item");
															newSofBinRow.SKU=sofRmRow.get("SKU");
															newSofBinRow.Quantity=sofRmRow.get("Quantity");
															newSofBinRow.Bin_Location=sofRmRow.get("Bin_Location");
															sofRec.Item_Details1.insert(newSofBinRow);
														}
													}
												}
												for each  pofRecBin in Pre_Order_FF[SO == input.SO_No && SKU == rliBin.SKU]
												{
													pofRecBin.Bin_Location=rliBin.Bin_location + "";
												}
											}
											// ADDED 2026-07-30, per user request ("if create receive in receiving and
											// the item is complete. flip the status on pre order report's same item
											// only") — per-LINE completeness flip, distinct from the widget's own
											// client-side loadDeliveredSOsAndHeal() heuristic (which heals off the
											// WHOLE PO's aggregate Receiving fulfillment, not per line). "Complete"
											// mirrors native Receiving_Set_Line_Result's own formula exactly
											// (Accepted==Expected, zero Damage, zero Missing). Matches by SO+SKU, same
											// key pair already proven for the bin-location push right above — only
											// ever advances Pending -> Received, never reverts an already-Received row.
											for each  rliPoStat in input.Receiving_Line_Items
											{
												rliPoStatComplete = ifnull(rliPoStat.Accepted_Qty,0) == ifnull(rliPoStat.Expected_Qty,0) && ifnull(rliPoStat.Damage_Qty,0) == 0 && ifnull(rliPoStat.Missing_Qty,0) == 0 && ifnull(rliPoStat.Expected_Qty,0) > 0;
												if(rliPoStatComplete == true)
												{
													for each  pofRecStat in Pre_Order_FF[SO == input.SO_No && SKU == rliPoStat.SKU && Pre_Order_Status != "Received"]
													{
														pofRecStat.Pre_Order_Status="Received";
													}
												}
											}
											for each  apoComplete in aggPORecs
											{
												apoComplete.Completed_On=zoho.currenttime;
												/* ADDED 2026-07-20, per user — real PO-completion gate. PO_Status="Completed"
												   is checked in 6+ other places across this codebase (pr_to_po_grouping.txt,
												   pr_sync_supplier_load_balancing.txt, pr_approve_po_custom_api.txt) but was
												   never actually SET anywhere (confirmed via grep before building this) —
												   this closes that real gap. Sums Accepted_Qty across THIS Receiving
												   record's own lines (safe read off `input`) per SKU, compares to each
												   PO_Line_Items row's ordered QTY, requires zero Open Exceptions tied to
												   this PO before flipping PO_Status. */
												if(apoComplete.PO_Status != "Completed")
												{
													allLinesFullComp = true;
													for each  poLnComp in apoComplete.PO_Line_Items
													{
														skuAcceptedSumComp = 0;
														for each  rliComp in input.Receiving_Line_Items
														{
															if(rliComp.SKU == poLnComp.SKU)
															{
																skuAcceptedSumComp = skuAcceptedSumComp + ifnull(rliComp.Accepted_Qty,0);
															}
														}
														if(skuAcceptedSumComp < poLnComp.QTY)
														{
															allLinesFullComp = false;
														}
													}
													if(allLinesFullComp == true)
													{
														openExcCompCheck = Exceptions[PO_No == apoComplete.PO_No && Exception_Status == "Open"];
														if(openExcCompCheck.count() == 0)
														{
															apoComplete.PO_Status="Completed";
														}
													}
												}
											}
											if(shipRec != null)
											{
												shipRec.Arrival_Date=zoho.currentdate;
												shipRec.Receiving_Record_Created=true;
											}
											success message "Sent to Zoho Books — " + newReceiveNo;
										}
										else
										{
											info "Failed to create Books Purchase Receive — check logs.";
										}
					)
					}
				}
			}
			Create_RR as "Create_RR"
			{
				type =  functions
				form = Exceptions
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// === Create RR button — sa Exceptions form/report ===
										// Groups Product_Context1 rows by SKU + Type_field ("item") — each distinct group gets
										// its OWN Replacement_Request (RR1 item1, RR2 item2, ...), all sharing the same
										// Source_Exception_No (grouped under the same source Exception). Damage rows of the
										// SAME SKU are per-unit (Qty=1 each) and get summed into one RR_Qty per item; Missing's
										// single bare row already carries its own total Qty.
										excRec = Exceptions[ID == input.ID];
										groupKeys = List();
										groupSku = Map();
										groupItem = Map();
										groupSupplier = Map();
										groupType = Map();
										groupQty = Map();
										// ADDED 2026-08-08, per user request ("if it is damaged and sparepart include
										// details of sparepart... send the RR to supplier with details of sparepart") —
										// aggregated the same way groupQty already aggregates Qty across a group's rows.
										// FIXED same day, code review: RR_Spare_Parts must hold a PAIRED "Type: Qty"
										// string (comma-joined across rows) — same shape checker_checklist_qc_sync.txt's
										// own QC-side aggregation already produces and Fenteng-RR/Tony-RR/ExceptionControl
										// already parse (split on "," then ":" per segment). Building the pair per-row,
										// inside this same loop where both values are known together, also avoids any
										// positional misalignment between type and qty across multiple physical units of
										// the same SKU. groupSpareType is kept too (bare type names only, no qty) for
										// RR_Item_to_Replace — useful extra context, not required by the parser.
										groupSpareType = Map();
										groupSparePairs = Map();
										// ADDED 2026-10-12, per user request ("before creating RR. dapat meron kung same
										// supplier ba or pipili ng ibang supplier... kung si Tony ang supplier nakatag parin
										// siya pero pwede parin mamili ng ibang supplier") — the officer now confirms the
										// supplier on the Exception Control widget BEFORE this runs, and the choice lands in
										// the new Exceptions header field RR_Supplier_Override. Read once here, used in the
										// grouping loop below.
										//   blank  = use the supplier already tagged on the exception line (today's behaviour,
										//            unchanged — which is why this is safe to paste before any widget is live)
										//   filled = that supplier instead
										// A header field is deliberately used rather than a new argument: a Report Action Item
										// can't show a modal or take one, so this is the only thing BOTH this native button and
										// the createRRMain Custom Function mirror can read. Product_Context1.Supplier itself is
										// never overwritten — the Exception keeps showing who it originally was.
										rrSupOverride = ifnull(input.RR_Supplier_Override,"") + "";
										rrSupOverride = rrSupOverride.trim();
										for each  pc in excRec.Product_Context1
										{
											/* ADDED 2026-07-21, per user (repair-tracking feature) — a Damage row still
											   under in-house repair (Repairable=Yes, Repair_Outcome not yet "Not Fixed")
											   is excluded from RR creation entirely, not just disabled in the widget's UI.
											   This is the real backend gate — the widget's own canCreateRR() disables the
											   button, but that alone can't stop this native Action or its Custom Function
											   mirror being called directly. Missing rows are unaffected (no Repairable
											   concept). */
											if(pc.Type_field == "Damage" && pc.Repairable == "Yes" && pc.Repair_Outcome != "Not Fixed")
											{
												continue;
											}
											gKey = pc.SKU + "||" + pc.Type_field;
											if(!groupKeys.contains(gKey))
											{
												groupKeys.add(gKey);
												groupSku.put(gKey,pc.SKU);
												groupItem.put(gKey,pc.Item);
												if(rrSupOverride != "")
												{
													groupSupplier.put(gKey,rrSupOverride);
												}
												else
												{
													groupSupplier.put(gKey,pc.Supplier);
												}
												groupType.put(gKey,pc.Type_field);
												groupQty.put(gKey,0);
												groupSpareType.put(gKey,"");
												groupSparePairs.put(gKey,"");
											}
											groupQty.put(gKey,groupQty.get(gKey) + ifnull(pc.Qty,0));
											pcQtyRaw = pc.Quantity_of_damage_spare_s + "";
											if(pcQtyRaw != "" && pcQtyRaw != "null")
											{
												// CHANGED 2026-08-08d, per user request ("separate quantities per sparepart
												// needed, per line item") — Quantity_of_damage_spare_s now holds the FULL
												// "Type: Qty, Type: Qty" pairs directly (the widget builds one qty box per
												// checked spare-part type), so this row's own contribution is parsed
												// straight out of it instead of reconstructed from one shared qty.
												// "Others" is still resolved to the officer's own typed
												// Spare_Part_Type_Other text per segment.
												pcOtherText = pc.Spare_Part_Type_Other + "";
												segs = pcQtyRaw.toList(",");
												pcSpareType = "";
												pcPairsThisRow = "";
												for each  seg in segs
												{
													segTrim = seg.trim();
													segType = segTrim.getPrefix(":").trim();
													segQty = segTrim.getSuffix(":").trim();
													if(segQty == "" || segQty == "null")
													{
														segQty = "—";
													}
													if(segType == "Others" && pcOtherText != "" && pcOtherText != "null")
													{
														segType = pcOtherText;
													}
													if(pcSpareType == "")
													{
														pcSpareType = segType;
													}
													else
													{
														pcSpareType = pcSpareType + ", " + segType;
													}
													segPair = segType + ": " + segQty;
													if(pcPairsThisRow == "")
													{
														pcPairsThisRow = segPair;
													}
													else
													{
														pcPairsThisRow = pcPairsThisRow + ", " + segPair;
													}
												}
												existingSpareType = groupSpareType.get(gKey);
												if(existingSpareType == "")
												{
													groupSpareType.put(gKey,pcSpareType);
												}
												else
												{
													groupSpareType.put(gKey,existingSpareType + ", " + pcSpareType);
												}
												existingPair = groupSparePairs.get(gKey);
												if(existingPair == "")
												{
													groupSparePairs.put(gKey,pcPairsThisRow);
												}
												else
												{
													groupSparePairs.put(gKey,existingPair + ", " + pcPairsThisRow);
												}
											}
										}
										// dedup: an RR already covering this exact SKU+Source_Type combo, under this Exception
										existingPairs = List();
										existingRRsForExc = Replacement_Request[Source_Exception_No == input.Exception_No];
										for each  exrr in existingRRsForExc
										{
											for each  srow in exrr.Replacement_Summary
											{
												existingPairs.add(srow.SKU + "||" + exrr.Source_Type);
											}
										}
										maxNum = 0;
										existingRRsAll = Replacement_Request[ID != 0];
										for each  rr in existingRRsAll
										{
											rrNoStr = rr.RR_No;
											if(rrNoStr != null && rrNoStr != "")
											{
												numPart = rrNoStr.removeFirstOccurence("RR-");
												num = numPart.toLong();
												if(num > maxNum)
												{
													maxNum = num;
												}
											}
										}
										anyCreated = false;
										for each  gKey in groupKeys
										{
											gSku = groupSku.get(gKey);
											gType = groupType.get(gKey);
											sourceType = "";
											if(input.Source_Module == "Receiving")
											{
												if(gType == "Damage")
												{
													sourceType = "Receiving Damage";
												}
												else
												{
													sourceType = "Receiving Missing";
												}
											}
											else if(input.Source_Module == "Fulfillment QC")
											{
												sourceType = "QC Failure";
											}
											else
											{
												sourceType = "Management Decision";
											}
											pairKey = gSku + "||" + sourceType;
											if(existingPairs.contains(pairKey))
											{
												continue;
											}
											maxNum = maxNum + 1;
											newNum = maxNum;
											if(newNum < 10)
											{
												newRRNo = "RR-0000" + newNum;
											}
											else if(newNum < 100)
											{
												newRRNo = "RR-000" + newNum;
											}
											else if(newNum < 1000)
											{
												newRRNo = "RR-00" + newNum;
											}
											else if(newNum < 10000)
											{
												newRRNo = "RR-0" + newNum;
											}
											else
											{
												newRRNo = "RR-" + newNum;
											}
											/* ADDED 2026-07-20, per user — new plain header fields (NOT the Replacement_Summary
											   subform) mirroring Supplier/SKU/Item/RR_Qty, so the new Clone Shipment mechanism
											   can read them safely later without touching a subform on a criteria-queried
											   record (the confirmed-broken pattern from this whole session's own debug saga).
											   Same "mirror field to route around a platform limit" convention as
											   Sales_Order_Display elsewhere in this app.
											   ADDED 2026-07-23, real bug found live ("some datas are missing" on a cloned
											   Shipment's own PO_Shipments line — PR_No/Ordered_QTY both came back blank) —
											   RR_PR_No is a 5th mirror field, same reasoning, same source as
											   Replacement_Summary.PR_No a few lines below (input.Receiving_Line_ID — this
											   app's own established source for a PR number on an Exception-derived record,
											   despite the field's own name). clone_shipment_for_replacement.txt now reads
											   this to stamp the new Shipment line's own PR_No correctly. */
											newRRID = insert into Replacement_Request
											[
												RR_No=newRRNo
												RR_Date=zoho.currentdate
												RR_Status="Open"
												Source_Type=sourceType
												Source_Exception_No=input.Exception_No
												Last_Updated=zoho.currenttime
												Added_User=zoho.loginuser
												RR_Supplier=groupSupplier.get(gKey)
												RR_SKU=gSku
												RR_Item_Name=groupItem.get(gKey)
												RR_Qty_Value=groupQty.get(gKey)
												RR_PR_No=input.Receiving_Line_ID
												RR_Item_to_Replace=groupSpareType.get(gKey)
												RR_Damage_Qty=groupQty.get(gKey)
												RR_Spare_Parts=groupSparePairs.get(gKey)
											];
											newRR = Replacement_Request[ID == newRRID];
											newRow = Replacement_Request.Replacement_Summary();
											newRow.PR_No=input.Receiving_Line_ID;
											newRow.Supplier=groupSupplier.get(gKey);
											newRow.SKU=gSku;
											newRow.Item=groupItem.get(gKey);
											newRow.SO_No=input.Sales_Order;
											newRow.Original_PO_No=input.PO_No;
											newRow.Priority=input.Priority;
											newRow.RR_Qty=groupQty.get(gKey);
											newRR.Replacement_Summary.insert(newRow);
											anyCreated = true;
											/* ADDED 2026-07-20, per user request ("let's not be dependent on supplier, their
											   only job is to approve and populate ETA/ETD") — the Missing_SKUs stamp / new
											   replacement PO creation used to happen on the SUPPLIER's own "Approve RR" click
											   (approve_rr_supplier.txt). Moved here, to the OFFICER's Create RR click, so the
											   recycle/replacement path no longer depends on the supplier ever clicking
											   anything — it fires the moment the RR itself is raised. See that file's NOTES
											   for the full before/after. */
											if(sourceType == "Receiving Missing")
											{
												targetPOsRR = Purchase_Order[PO_No == input.PO_No];
												for each  poRR in targetPOsRR
												{
													poRR.Missing_SKUs=gSku;
												}
											}
											else
											{
												/* CHANGED 2026-07-20, per user request — real architecture simplification.
												   Damage/QC/Complaint used to spin up a brand-new Creator-only Purchase_Order
												   (RR_Reference_No-tagged) — replaced entirely with the same "stamp a flag on
												   the ORIGINAL PO" pattern the Missing branch already used above. New field
												   Damage_SKUs (mirrors Missing_SKUs) drives the recycle in
												   receiving_create_bin_receiving.txt (generalized to check Missing_SKUs OR
												   Damage_SKUs). The replacement now flows back through a cloned Shipment +
												   the SAME original Receiving record — no second PO, no cross-PO trace-back,
												   no separate Books PO. See CLAUDE.md for the full before/after. */
												targetPOsRRDmg = Purchase_Order[PO_No == input.PO_No];
												for each  poRRDmg in targetPOsRRDmg
												{
													poRRDmg.Damage_SKUs=gSku;
												}
											}
										}
										if(anyCreated == true)
										{
											input.Exception_Status = "Under Review";
											success message "RR(s) created successfully for Exception " + input.Exception_No + ".";
										}
										else
										{
											info "No new RR needed — every item on this Exception already has an RR.";
										}
					)
					}
					actions 
					{
					on click
					(
						excRecF = Exceptions[ID == input.ID];
										groupKeysF = List();
										groupSkuF = Map();
										groupItemF = Map();
										groupSupplierF = Map();
										groupTypeF = Map();
										groupQtyF = Map();
										// ADDED 2026-08-08 — same spare-part aggregation as Action 1, see that block's
										// own comment for the full reasoning. FIXED same day, code review: paired
										// "Type: Qty" string, see Action 1's own comment for the full explanation.
										groupSpareTypeF = Map();
										groupSparePairsF = Map();
										// ADDED 2026-10-12 — the officer confirms the supplier on the Exception Control
										// widget before Create RR runs, and the choice lands in the Exceptions header field
										// RR_Supplier_Override. Blank = use the supplier tagged on the exception line, i.e.
										// exactly today's behaviour. This is what makes the supplier gate below test the
										// CHOSEN supplier rather than the tagged one, so an overridden RR routes to the
										// right supplier and only to that one. Mirrors createRRFenteng/createRRTony.
										rrSupOverrideF = ifnull(input.RR_Supplier_Override,"") + "";
										rrSupOverrideF = rrSupOverrideF.trim();
										for each  pc in excRecF.Product_Context1
										{
											/* ADDED 2026-07-21 — same repair-tracking gate as Action 1, see that block's
											   own comment. */
											if(pc.Type_field == "Damage" && pc.Repairable == "Yes" && pc.Repair_Outcome != "Not Fixed")
											{
												continue;
											}
											gKeyF = pc.SKU + "||" + pc.Type_field;
											if(!groupKeysF.contains(gKeyF))
											{
												groupKeysF.add(gKeyF);
												groupSkuF.put(gKeyF,pc.SKU);
												groupItemF.put(gKeyF,pc.Item);
												if(rrSupOverrideF != "")
												{
													groupSupplierF.put(gKeyF,rrSupOverrideF);
												}
												else
												{
													groupSupplierF.put(gKeyF,pc.Supplier);
												}
												groupTypeF.put(gKeyF,pc.Type_field);
												groupQtyF.put(gKeyF,0);
												groupSpareTypeF.put(gKeyF,"");
												groupSparePairsF.put(gKeyF,"");
											}
											groupQtyF.put(gKeyF,groupQtyF.get(gKeyF) + ifnull(pc.Qty,0));
											pcQtyRawF = pc.Quantity_of_damage_spare_s + "";
											if(pcQtyRawF != "" && pcQtyRawF != "null")
											{
												// CHANGED 2026-08-08d — see the plain Action's own comment above for the
												// full per-type-qty reasoning.
												pcOtherTextF = pc.Spare_Part_Type_Other + "";
												segsF = pcQtyRawF.toList(",");
												pcSpareTypeF = "";
												pcPairsThisRowF = "";
												for each  segF in segsF
												{
													segTrimF = segF.trim();
													segTypeF = segTrimF.getPrefix(":").trim();
													segQtyF = segTrimF.getSuffix(":").trim();
													if(segQtyF == "" || segQtyF == "null")
													{
														segQtyF = "—";
													}
													if(segTypeF == "Others" && pcOtherTextF != "" && pcOtherTextF != "null")
													{
														segTypeF = pcOtherTextF;
													}
													if(pcSpareTypeF == "")
													{
														pcSpareTypeF = segTypeF;
													}
													else
													{
														pcSpareTypeF = pcSpareTypeF + ", " + segTypeF;
													}
													segPairF = segTypeF + ": " + segQtyF;
													if(pcPairsThisRowF == "")
													{
														pcPairsThisRowF = segPairF;
													}
													else
													{
														pcPairsThisRowF = pcPairsThisRowF + ", " + segPairF;
													}
												}
												existingSpareTypeF = groupSpareTypeF.get(gKeyF);
												if(existingSpareTypeF == "")
												{
													groupSpareTypeF.put(gKeyF,pcSpareTypeF);
												}
												else
												{
													groupSpareTypeF.put(gKeyF,existingSpareTypeF + ", " + pcSpareTypeF);
												}
												existingPairF = groupSparePairsF.get(gKeyF);
												if(existingPairF == "")
												{
													groupSparePairsF.put(gKeyF,pcPairsThisRowF);
												}
												else
												{
													groupSparePairsF.put(gKeyF,existingPairF + ", " + pcPairsThisRowF);
												}
											}
										}
										existingSupPairsF = List();
										existingSupRRsF = Fenteng_Lighting_Replacement_Request[Source_Exception_No == input.Exception_No];
										for each  esrF in existingSupRRsF
										{
											for each  ssrowF in esrF.Replacement_Summary
											{
												existingSupPairsF.add(ssrowF.SKU + "||" + esrF.Source_Type);
											}
										}
										for each  gKeyF in groupKeysF
										{
											// FIXED 2026-08-07, real bug confirmed live: Production's real
											// Receiving.Supplier value is "Tony Fan"/"Fenteng Lighting" (the
											// Suppliers form's own full display name), not the bare "Fenteng"/"Tony"
											// this strict equality expected — only Dev's own test data happened to
											// use the bare literal, masking this in every prior test. Zero supplier
											// RRs were ever created in Production as a result. Matches the defensive
											// == || .contains() pattern already used elsewhere in this codebase for
											// the same field (see receiving_widget_custom_api.txt/
											// receiving_create_bin_receiving.txt). Mirrored from create_rr_custom_api.txt.
											supplierValF = groupSupplierF.get(gKeyF) + "";
											if(supplierValF != "Fenteng" && !supplierValF.contains("Fenteng"))
											{
												continue;
											}
											gSkuF = groupSkuF.get(gKeyF);
											gTypeF = groupTypeF.get(gKeyF);
											sourceTypeF = "";
											if(input.Source_Module == "Receiving")
											{
												if(gTypeF == "Damage")
												{
													sourceTypeF = "Receiving Damage";
												}
												else
												{
													sourceTypeF = "Receiving Missing";
												}
											}
											else if(input.Source_Module == "Fulfillment QC")
											{
												sourceTypeF = "QC Failure";
											}
											else
											{
												sourceTypeF = "Management Decision";
											}
											pairKeyF = gSkuF + "||" + sourceTypeF;
											if(existingSupPairsF.contains(pairKeyF))
											{
												continue;
											}
											parentRRNoF = "";
											parentRRSupF = "";
											parentRRsF = Replacement_Request[Source_Exception_No == input.Exception_No];
											for each  prrF in parentRRsF
											{
												if(prrF.Source_Type == sourceTypeF)
												{
													for each  prsRowF in prrF.Replacement_Summary
													{
														if(prsRowF.SKU == gSkuF)
														{
															parentRRNoF = prrF.RR_No;
															parentRRSupF = prrF.RR_Supplier + "";
														}
													}
												}
											}
											/* ADDED 2026-10-12, real bug found in live testing (EXC-00001): the officer
											   changed the supplier on an Exception that ALREADY had RR-00001 routed to
											   Tony and acknowledged by him. Action 1 correctly deduped and did not create
											   a new parent, so RR_Supplier stayed "Tony" — but this action deduped only
											   against its OWN form, found nothing, passed the overridden gate, and attached
											   a record to that same RR-00001. Both suppliers ended up holding the same RR.
											   A supplier-side record must never disagree with its parent. A BLANK parent
											   supplier is allowed through deliberately: RR_Supplier only exists from
											   2026-07-20, so older parents genuinely have none and must keep working. */
											if(parentRRNoF != "" && parentRRSupF.trim() != "" && parentRRSupF != "Fenteng" && !parentRRSupF.contains("Fenteng"))
											{
												continue;
											}
											if(parentRRNoF != "")
											{
												newSupRRIDF = insert into Fenteng_Lighting_Replacement_Request
												[
													RR_No=parentRRNoF
													RR_Date=zoho.currentdate
													RR_Status="Open"
													Source_Type=sourceTypeF
													Source_Exception_No=input.Exception_No
													Last_Updated=zoho.currenttime
													RR_Item_to_Replace=groupSpareTypeF.get(gKeyF)
													RR_Damage_Qty=groupQtyF.get(gKeyF)
													RR_Spare_Parts=groupSparePairsF.get(gKeyF)
													Added_User=zoho.loginuser
												];
												newSupRRF = Fenteng_Lighting_Replacement_Request[ID == newSupRRIDF];
												newSupRowF = Fenteng_Lighting_Replacement_Request.Replacement_Summary();
												newSupRowF.PR_No=input.Receiving_Line_ID;
												newSupRowF.Supplier=groupSupplierF.get(gKeyF);
												newSupRowF.SKU=gSkuF;
												newSupRowF.Item=groupItemF.get(gKeyF);
												newSupRowF.SO_No=input.Sales_Order;
												newSupRowF.Original_PO_No=input.PO_No;
												newSupRowF.Priority=input.Priority;
												newSupRowF.RR_Qty=groupQtyF.get(gKeyF);
												newSupRRF.Replacement_Summary.insert(newSupRowF);
												/* ADDED 2026-07-20 — supplier-side counterpart of Action 1's Missing_SKUs
												   stamp / new PO creation, see that Action's own comment for why this moved
												   here instead of approve_rr_supplier.txt. */
												if(sourceTypeF == "Receiving Missing")
												{
													targetSupPOsF2 = Fenteng_Lighting_Purchase_Order[PO_No_Supplier1 == input.PO_No];
													for each  spoF2 in targetSupPOsF2
													{
														spoF2.Missing_SKUs_Supplier1=gSkuF;
													}
												}
												else
												{
													/* CHANGED 2026-07-20 — supplier-side counterpart of Action 1's Damage_SKUs
													   change above. No new supplier PO created — stamps the new
													   Damage_SKUs_Supplier1 field on the EXISTING supplier PO instead. */
													targetSupPOsDmgF2 = Fenteng_Lighting_Purchase_Order[PO_No_Supplier1 == input.PO_No];
													for each  spoDmgF2 in targetSupPOsDmgF2
													{
														spoDmgF2.Damage_SKUs_Supplier1=gSkuF;
													}
												}
											}
										}
					)
					}
					actions 
					{
					on click
					(
						excRecT = Exceptions[ID == input.ID];
										groupKeysT = List();
										groupSkuT = Map();
										groupItemT = Map();
										groupSupplierT = Map();
										groupTypeT = Map();
										groupQtyT = Map();
										// ADDED 2026-08-08 — same spare-part aggregation as Action 1, see that block's
										// own comment for the full reasoning. FIXED same day, code review: paired
										// "Type: Qty" string, see Action 1's own comment for the full explanation.
										groupSpareTypeT = Map();
										groupSparePairsT = Map();
										// ADDED 2026-10-12 — the officer confirms the supplier on the Exception Control
										// widget before Create RR runs, and the choice lands in the Exceptions header field
										// RR_Supplier_Override. Blank = use the supplier tagged on the exception line, i.e.
										// exactly today's behaviour. This is what makes the supplier gate below test the
										// CHOSEN supplier rather than the tagged one, so an overridden RR routes to the
										// right supplier and only to that one. Mirrors createRRFenteng/createRRTony.
										rrSupOverrideT = ifnull(input.RR_Supplier_Override,"") + "";
										rrSupOverrideT = rrSupOverrideT.trim();
										for each  pc in excRecT.Product_Context1
										{
											/* ADDED 2026-07-21 — same repair-tracking gate as Action 1, see that block's
											   own comment. */
											if(pc.Type_field == "Damage" && pc.Repairable == "Yes" && pc.Repair_Outcome != "Not Fixed")
											{
												continue;
											}
											gKeyT = pc.SKU + "||" + pc.Type_field;
											if(!groupKeysT.contains(gKeyT))
											{
												groupKeysT.add(gKeyT);
												groupSkuT.put(gKeyT,pc.SKU);
												groupItemT.put(gKeyT,pc.Item);
												if(rrSupOverrideT != "")
												{
													groupSupplierT.put(gKeyT,rrSupOverrideT);
												}
												else
												{
													groupSupplierT.put(gKeyT,pc.Supplier);
												}
												groupTypeT.put(gKeyT,pc.Type_field);
												groupQtyT.put(gKeyT,0);
												groupSpareTypeT.put(gKeyT,"");
												groupSparePairsT.put(gKeyT,"");
											}
											groupQtyT.put(gKeyT,groupQtyT.get(gKeyT) + ifnull(pc.Qty,0));
											pcQtyRawT = pc.Quantity_of_damage_spare_s + "";
											if(pcQtyRawT != "" && pcQtyRawT != "null")
											{
												// CHANGED 2026-08-08d — see the plain Action's own comment above for the
												// full per-type-qty reasoning.
												pcOtherTextT = pc.Spare_Part_Type_Other + "";
												segsT = pcQtyRawT.toList(",");
												pcSpareTypeT = "";
												pcPairsThisRowT = "";
												for each  segT in segsT
												{
													segTrimT = segT.trim();
													segTypeT = segTrimT.getPrefix(":").trim();
													segQtyT = segTrimT.getSuffix(":").trim();
													if(segQtyT == "" || segQtyT == "null")
													{
														segQtyT = "—";
													}
													if(segTypeT == "Others" && pcOtherTextT != "" && pcOtherTextT != "null")
													{
														segTypeT = pcOtherTextT;
													}
													if(pcSpareTypeT == "")
													{
														pcSpareTypeT = segTypeT;
													}
													else
													{
														pcSpareTypeT = pcSpareTypeT + ", " + segTypeT;
													}
													segPairT = segTypeT + ": " + segQtyT;
													if(pcPairsThisRowT == "")
													{
														pcPairsThisRowT = segPairT;
													}
													else
													{
														pcPairsThisRowT = pcPairsThisRowT + ", " + segPairT;
													}
												}
												existingSpareTypeT = groupSpareTypeT.get(gKeyT);
												if(existingSpareTypeT == "")
												{
													groupSpareTypeT.put(gKeyT,pcSpareTypeT);
												}
												else
												{
													groupSpareTypeT.put(gKeyT,existingSpareTypeT + ", " + pcSpareTypeT);
												}
												existingPairT = groupSparePairsT.get(gKeyT);
												if(existingPairT == "")
												{
													groupSparePairsT.put(gKeyT,pcPairsThisRowT);
												}
												else
												{
													groupSparePairsT.put(gKeyT,existingPairT + ", " + pcPairsThisRowT);
												}
											}
										}
										existingSupPairsT = List();
										existingSupRRsT = Tony_Fan_Replacement_Request[Source_Exception_No == input.Exception_No];
										for each  esrT in existingSupRRsT
										{
											for each  ssrowT in esrT.Replacement_Summary
											{
												existingSupPairsT.add(ssrowT.SKU + "||" + esrT.Source_Type);
											}
										}
										for each  gKeyT in groupKeysT
										{
											// FIXED 2026-08-07 — same real bug/fix as the Fenteng loop above.
											supplierValT = groupSupplierT.get(gKeyT) + "";
											if(supplierValT != "Tony" && !supplierValT.contains("Tony"))
											{
												continue;
											}
											gSkuT = groupSkuT.get(gKeyT);
											gTypeT = groupTypeT.get(gKeyT);
											sourceTypeT = "";
											if(input.Source_Module == "Receiving")
											{
												if(gTypeT == "Damage")
												{
													sourceTypeT = "Receiving Damage";
												}
												else
												{
													sourceTypeT = "Receiving Missing";
												}
											}
											else if(input.Source_Module == "Fulfillment QC")
											{
												sourceTypeT = "QC Failure";
											}
											else
											{
												sourceTypeT = "Management Decision";
											}
											pairKeyT = gSkuT + "||" + sourceTypeT;
											if(existingSupPairsT.contains(pairKeyT))
											{
												continue;
											}
											parentRRNoT = "";
											parentRRSupT = "";
											parentRRsT = Replacement_Request[Source_Exception_No == input.Exception_No];
											for each  prrT in parentRRsT
											{
												if(prrT.Source_Type == sourceTypeT)
												{
													for each  prsRowT in prrT.Replacement_Summary
													{
														if(prsRowT.SKU == gSkuT)
														{
															parentRRNoT = prrT.RR_No;
															parentRRSupT = prrT.RR_Supplier + "";
														}
													}
												}
											}
											/* ADDED 2026-10-12, real bug found in live testing (EXC-00001): the officer
											   changed the supplier on an Exception that ALREADY had RR-00001 routed to
											   Tony and acknowledged by him. Action 1 correctly deduped and did not create
											   a new parent, so RR_Supplier stayed "Tony" — but this action deduped only
											   against its OWN form, found nothing, passed the overridden gate, and attached
											   a record to that same RR-00001. Both suppliers ended up holding the same RR.
											   A supplier-side record must never disagree with its parent. A BLANK parent
											   supplier is allowed through deliberately: RR_Supplier only exists from
											   2026-07-20, so older parents genuinely have none and must keep working. */
											if(parentRRNoT != "" && parentRRSupT.trim() != "" && parentRRSupT != "Tony" && !parentRRSupT.contains("Tony"))
											{
												continue;
											}
											if(parentRRNoT != "")
											{
												newSupRRIDT = insert into Tony_Fan_Replacement_Request
												[
													RR_No=parentRRNoT
													RR_Date=zoho.currentdate
													RR_Status="Open"
													Source_Type=sourceTypeT
													Source_Exception_No=input.Exception_No
													Last_Updated=zoho.currenttime
													RR_Item_to_Replace=groupSpareTypeT.get(gKeyT)
													RR_Damage_Qty=groupQtyT.get(gKeyT)
													RR_Spare_Parts=groupSparePairsT.get(gKeyT)
													Added_User=zoho.loginuser
												];
												newSupRRT = Tony_Fan_Replacement_Request[ID == newSupRRIDT];
												newSupRowT = Tony_Fan_Replacement_Request.Replacement_Summary();
												newSupRowT.PR_No=input.Receiving_Line_ID;
												newSupRowT.Supplier=groupSupplierT.get(gKeyT);
												newSupRowT.SKU=gSkuT;
												newSupRowT.Item=groupItemT.get(gKeyT);
												newSupRowT.SO_No=input.Sales_Order;
												newSupRowT.Original_PO_No=input.PO_No;
												newSupRowT.Priority=input.Priority;
												newSupRowT.RR_Qty=groupQtyT.get(gKeyT);
												newSupRRT.Replacement_Summary.insert(newSupRowT);
												/* ADDED 2026-07-20 — supplier-side counterpart of Action 1's Missing_SKUs
												   stamp / new PO creation, see that Action's own comment for why this moved
												   here instead of approve_rr_supplier.txt. */
												if(sourceTypeT == "Receiving Missing")
												{
													targetSupPOsT2 = Tony_Fan_Purchase_Order[PO_No_Supplier2 == input.PO_No];
													for each  spoT2 in targetSupPOsT2
													{
														spoT2.Missing_SKUs_Supplier2=gSkuT;
													}
												}
												else
												{
													/* CHANGED 2026-07-20 — supplier-side counterpart of Action 1's Damage_SKUs
													   change above. No new supplier PO created — stamps the new
													   Damage_SKUs_Supplier2 field on the EXISTING supplier PO instead. */
													targetSupPOsDmgT2 = Tony_Fan_Purchase_Order[PO_No_Supplier2 == input.PO_No];
													for each  spoDmgT2 in targetSupPOsDmgT2
													{
														spoDmgT2.Damage_SKUs_Supplier2=gSkuT;
													}
												}
											}
										}
					)
					}
				}
			}
			Approve_RR_Supplier1 as "Approve_RR_Supplier1"
			{
				type =  functions
				form = Fenteng_Lighting_Replacement_Request
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						/* SLIMMED 2026-07-20, per user request ("let's not be dependent on supplier — their
										   only job is to approve and populate ETA/ETD"): every bit of Missing_SKUs stamping /
										   new replacement PO creation that used to live here moved to create_rr_button.txt
										   (officer-triggered Create RR, fires the moment the RR is raised — no longer waits
										   on the supplier clicking anything). This button's only remaining job is the status
										   + audit-date flip. ETA/Expected_Ship_Date themselves are NOT written here — the
										   native Action Item has no click-time input to collect them with (same limitation
										   already documented for PO Acknowledge); they're entered via the widget's own
										   "Update Progress" fields, and the widget-side Approve flow (approve_rr_custom_api.txt)
										   requires both to be filled before it'll call this same logic. This native copy is
										   reference/parity only — this whole app is confirmed widget-only in deployment. */
										if(input.RR_Status != "Open")
										{
											info "Already approved.";
											return;
										}
										input.RR_Status = "Acknowledged";
										input.Supplier_Acknowledgement1 = true;
										input.Supplier_Acknowledge_Date = zoho.currenttime;
										input.Last_Updated = zoho.currenttime;
										success message "Replacement Request approved.";
					)
					}
				}
			}
			Approve_RR_Supplier2 as "Approve_RR_Supplier2"
			{
				type =  functions
				form = Tony_Fan_Replacement_Request
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						/* SLIMMED 2026-07-20 — see Approve_RR_Supplier1's matching comment above. */
										if(input.RR_Status != "Open")
										{
											info "Already approved.";
											return;
										}
										input.RR_Status = "Acknowledged";
										input.Supplier_Acknowledgement1 = true;
										input.Supplier_Acknowledge_Date = zoho.currenttime;
										input.Last_Updated = zoho.currenttime;
										success message "Replacement Request approved.";
					)
					}
				}
			}
			Re_Schedule as "Re_Schedule"
			{
				type =  functions
				form = Service_Appointment_Form
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						rsOut = thisapp.dmsScheduleSlot(input.ID.toString(),true);
					)
					}
				}
			}
			Create_Package_FF as "Create_Package_FF"
			{
				type =  functions
				form = Pre_Order_FF
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// ===============================================================================
										// NATIVE REPORT ACTION ITEM (debug/test copy) â€” createPackageFF_native, 2026-08-15
										// ===============================================================================
										// Built per user request ("create new deluge script na naka base dito... para
										// matest ko siya sa native at madebug natin") â€” same logic as the createPackageFF
										// Custom Function (Widget path), adapted to run as a plain Report Action Item body
										// so results show via a native "success message" popup instead of a widget/
										// Network-tab JSON response.
										//
										// PASTE INTO: Pre_Order1_Report -> On click of action item -> (new action item,
										// e.g. name it "Test_Create_Package_Native") -- NOT the empty "Create_Package_FF"
										// action item already in the app (that one is unrelated/unused).
										// CONDITION (recommended, same as the widget's own readiness filter):
										//   Select_To_Package == true
										//
										// REGENERATED 2026-08-15 (3rd time), per user ("maglagay ka ng logs") â€” added
										// `info "RR-DEBUG step1..7: ..."` checkpoints throughout the real-Books-package
										// attempt (SO lookup, SKU/line match, Books package-list lookup, package detail
										// fetch, original line qty check, the PUT itself, the follow-up POST itself) so
										// Execution History shows a full step-by-step trace even if something crashes
										// mid-script before the final success message is ever reached. These are on the
										// MASTER file (`preorder_create_package.txt`/`PASTE_createPackageFF.txt`) too,
										// not just this native copy â€” same `info` calls work in both contexts.
										//
										// Earlier revisions, kept for context:
										// - Omits the SAME `r.Last_Package_Result = ...` line the widget-path script has
										//   (that field was never added to Pre_Order_FF in Zoho, user chose not to add it
										//   for now â€” this native copy needs no field at all, the success message below
										//   already carries the same text).
										// - Uses `success message`, NOT `alert` â€” `alert` only works in FORM client
										//   scripts (on load/validate/change); report/record action items are
										//   server-side with no browser, `alert` throws "'ALERT' task can be used only
										//   in on load, on validate and on change actions" there.
										//
										// HOW THIS DIFFERS FROM THE WIDGET PATH:
										// - No recordIdsCsv/deliveryType params from a widget call â€” instead auto-detects
										//   every OTHER Select_To_Package==true row sharing the CLICKED record's own SO.
										// - deliveryType is read straight off the clicked record's own Delivery_Type field.
										// - Ends with `success message`, showing every record's own result message
										//   (including the same rrFallbackReason detail for RR rows the widget path now
										//   returns) directly in Zoho's native UI.
										// - Step-by-step RR-DEBUG `info` lines land in this action item's OWN Execution
										//   History (Deluge editor toolbar, usually a small icon/menu near top-right) â€”
										//   use this if the final success message alone isn't enough to see WHERE it
										//   stopped (e.g. if the whole thing errors out before reaching the end).
										orgId = "751117756";
										resultList = List();
										// Native-context input resolution, ADDED 2026-08-15.
										deliveryType = input.Delivery_Type + "";
										if(deliveryType == "null")
										{
											deliveryType = "";
										}
										soForExpand = input.SO + "";
										nativeIdList = List();
										nativeIdList.add(input.ID + "");
										for each  sibRec in Pre_Order_FF[SO == soForExpand && Select_To_Package == true && ID != input.ID]
										{
											nativeIdList.add(sibRec.ID + "");
										}
										recordIdsCsv = "";
										for each  nid in nativeIdList
										{
											if(recordIdsCsv == "")
											{
												recordIdsCsv = nid;
											}
											else
											{
												recordIdsCsv = recordIdsCsv + "," + nid;
											}
										}
										// ==== createPackageFF's own body starts here, VERBATIM except the omitted
										// Last_Package_Result write noted above ====
										orgId = "751117756";
										resultList = List();
										// fetch every requested record, group by SO
										// DEDUPED 2026-07-29, real bug found live: 2 Books packages both errored
										// with the SAME recordId listed twice in one call's own result â€” traced to
										// the SAME so_line_item_id being sent twice in one POST (qty summed above
										// what's actually left to pack, e.g. 3+3 on a line only 3 remain on),
										// which only happens if this function processed the same Pre_Order_FF
										// record twice within one run. Root cause upstream (client CSV / a double
										// click) unconfirmed, but never assume the input is clean â€” dedupe here
										// so a repeated ID can never double-count a line item regardless of why
										// it arrived twice.
										idListRaw = recordIdsCsv.toList(",");
										idList = List();
										for each  ridDedupe in idListRaw
										{
											ridD = ridDedupe.trim();
											if(ridD != "" && !idList.contains(ridD))
											{
												idList.add(ridD);
											}
										}
										// ADDED 2026-08-13, per user request ("hindi na sa Pre Order mapupunta, sa
										// Sales Order Readiness na siya mapupunta... kasama yung RR# pati yung
										// orginal package number") â€” RR-tagged Pre_Order_FF rows (own
										// Replacement_Request subform non-empty) never have real headroom on the
										// ORIGINAL Books SO line â€” it was already fully packed/shipped once
										// already. Same class of "no headroom for a replacement" gap already
										// fixed on the Purchasing/Receiving side in
										// clone_shipment_for_replacement.txt (real Books rejection there too,
										// code 36012). Confirmed live here as well: SO-16468/JF-001 errored
										// "Only 0 left to pack on SO SO-16468 (requested 1)" when run through the
										// normal Books path below. These rows now skip the Books package call
										// entirely (no new package created) and go straight into
										// Sales_Order_Readiness_Gate instead â€” referencing the SAME package
										// number the item's ORIGINAL (non-RR) shipment already used (read off
										// Sales_Order_Fulfillment), marked Paid, tagged with its own RR#. Split
										// off BEFORE soGroups/the Books path below so an RR row can never enter
										// that path, whether hand-picked by the widget or auto-expanded onto a
										// sibling's SO group (see the matching guard added to that expand query
										// further down).
										rrIdList = List();
										normalIdList = List();
										for each  ridSplit in idList
										{
											isRrRow = false;
											for each  rSplit in Pre_Order_FF[ID == ridSplit.toLong()]
											{
												// FIXED 2026-08-13, real bug found live (SO-16468, Aqi/JF-001) â€” this
												// record's RR tag lives on a PLAIN "RR" header field (checker_checklist_
												// qc_sync.txt's own RR-driven Pre_Order_FF insert sets RR=rrValCC directly,
												// no subform), but this check only ever looked at a "Replacement_Request"
												// subform (used by a DIFFERENT, older creation path per preorder_to_
												// readiness_gate.txt). Since the subform was never populated by THIS
												// record's actual creation path, isRrRow stayed false â€” the row fell
												// through to the normal Books path and hit "Only 0 left to pack" again.
												// Checks both possible representations now, whichever is actually populated.
												rrPlainCheck = rSplit.RR + "";
												if(rrPlainCheck != "" && rrPlainCheck != "null")
												{
													isRrRow = true;
												}
												for each  rrCheckRow in rSplit.Replacement_Request
												{
													isRrRow = true;
												}
											}
											if(isRrRow == true)
											{
												rrIdList.add(ridSplit);
											}
											else
											{
												normalIdList.add(ridSplit);
											}
										}
										for each  ridRr in rrIdList
										{
											for each  r in Pre_Order_FF[ID == ridRr.toLong()]
											{
												rrJoined = "";
												rrPlainVal = r.RR + "";
												if(rrPlainVal != "" && rrPlainVal != "null")
												{
													rrJoined = rrPlainVal;
												}
												for each  rrRow in r.Replacement_Request
												{
													rrVal = rrRow.RR + "";
													if(rrVal != "" && rrVal != "null" && !rrJoined.contains(rrVal))
													{
														if(rrJoined == "")
														{
															rrJoined = rrVal;
														}
														else
														{
															rrJoined = rrJoined + ", " + rrVal;
														}
													}
												}
												rrSO = r.SO + "";
												rrSKU = r.SKU + "";
												if(rrJoined == "")
												{
													resultList.add({"recordId":ridRr,"status":"error","message":"Replacement_Request subform present but no RR# found on it â€” cannot tag Readiness Gate"});
												}
												else
												{
													origPkgNo = "";
													// ALSO grabs Bin_Location/target_delivery_date off this SAME
													// Sales_Order_Fulfillment lookup (ADDED 2026-08-13, real gap found live
													// â€” user asked "complete details ba ito? Bin location at RR# as in
													// complete detail lahat target date") â€” the NEW direct Create Receive
													// insert (receiving_create_bin_receiving.txt, this same day) never sets
													// Bin_Location/Target_Delivery on the Pre_Order_FF row at all, so
													// r.Bin_Location/r.Target_Delivery below are genuinely blank on this
													// specific record. Falls back to the ORIGINAL item's own values here,
													// same source already used for origPkgNo, only when this record's own
													// value is blank.
													origBinLocRr = "";
													origTargetDelivRr = null;
													sofMatchesRr = Sales_Order_Fulfillment[SO_No == rrSO];
													for each  sofRecRr in sofMatchesRr
													{
														for each  sofRowRr in sofRecRr.Item_Details1
														{
															if(sofRowRr.SKU + "" == rrSKU && sofRecRr.Package + "" != "")
															{
																origPkgNo = sofRecRr.Package + "";
															}
															if(sofRowRr.SKU + "" == rrSKU)
															{
																sofBinRr = sofRowRr.Bin_Location + "";
																if(sofBinRr != "" && sofBinRr != "null")
																{
																	origBinLocRr = sofBinRr;
																}
															}
														}
														if(sofRecRr.target_delivery_date != null)
														{
															origTargetDelivRr = sofRecRr.target_delivery_date;
														}
													}
													if(origPkgNo == "")
													{
														resultList.add({"recordId":ridRr,"status":"error","message":"No original package number found on Sales_Order_Fulfillment for SKU " + rrSKU + " â€” cannot link RR replacement"});
													}
													else
													{
														// REFINED 2026-08-14, real live bug found via this exact RR branch
														// (RR-00005/PR test, "Linked to original package PAC-16497... no new
														// Books package created") â€” per user, RR replacements should follow
														// the SAME rule just added to the normal (non-RR) branch above: reusing
														// the ORIGINAL package# as a pure reference is fine while that original
														// item is still Pending/not yet shipped, but once it's actually
														// Dispatched, a genuinely separate LABEL is needed so this replacement
														// doesn't silently merge into an already-completed delivery's own
														// tracking. Still explicitly does NOT create a real new Books package
														// here â€” Books' side is unchanged (pure reference, no POST) â€” only the
														// text label used for this app's own Package_Number/Package_Order
														// changes, same disambiguation approach (bare or "-N" suffix) as the
														// normal branch.
														origIsDispatched = false;
														for each  aggCheckRecRr in Order_Aggregation1[SO == rrSO]
														{
															for each  aggCheckRowRr in aggCheckRecRr.Item_Details
															{
																if(aggCheckRowRr.SKU + "" == rrSKU && aggCheckRowRr.PAC + "" == origPkgNo && aggCheckRowRr.Dispatched == true)
																{
																	origIsDispatched = true;
																}
															}
														}
														origPkgNoForRr = origPkgNo;
														realBooksPkgCreated = false;
														rrFallbackReason = "";
														if(origIsDispatched == true)
														{
															// ATTEMPT ADDED 2026-08-15, per user direction change ("dapat create
															// new package sa zoho books. then the existing package... mag
															// babawas yung isang item then ng 1 qty" / "kasi sa DMS per package
															// ang paglabas ng Item. kaya hindi pwede same package parin sila") â€”
															// a text-only label (the disambiguation fallback below) has NO real
															// Books object behind it, confirmed live: this exact RR-00005/
															// PR-00006 record's own Books_Package_ID was blank before this fix,
															// since the RR branch never called Books at all. DMS dispatch needs
															// a REAL package per delivery event, so we now try to get one: first
															// reduce the ORIGINAL package's own recorded qty in Books (the SO
															// line itself shows 0 remaining while the original package still
															// holds the full packed qty â€” same "Only 0 left to pack" constraint
															// this whole RR branch was built to route around), then create a
															// genuinely new package for just the replacement qty.
															// UNCONFIRMED LIVE: Books' `PUT /packages/{id}` shape below is not
															// documented in Books' current public API reference (checked
															// 2026-08-15, WebSearch/WebFetch both came up empty) â€” mirrored off
															// the confirmed-live-working POST shape on the assumption update
															// accepts the same body. This is the first live run of this exact
															// code. Every step checks Books' own response before proceeding;
															// any failure at any point falls through to the proven-safe
															// label-only path further below â€” Books_Package_ID stays untouched
															// (blank) whenever that happens, nothing is left half-done.
															rrQtyDec = r.Qty.toDecimal();
															rrBinForPkg = r.Bin_Location + "";
															if(rrBinForPkg == "null" || rrBinForPkg == "")
															{
																rrBinForPkg = origBinLocRr;
															}
															if(rrBinForPkg == "")
															{
																rrBinForPkg = "Receiving Area";
															}
															soListRr = invokeurl
															[
																url :"https://www.zohoapis.com/books/v3/salesorders?organization_id=" + orgId + "&salesorder_number=" + rrSO.toString().replaceAll(" ","%20")
																type :GET
																connection:"zhbooks3"
															];
															soArrRr = soListRr.get("salesorders");
															soArrFoundRr = false;
															if(soArrRr != null && soArrRr.size() > 0)
															{
																soArrFoundRr = true;
															}
															info "RR-DEBUG step1: SO lookup for " + rrSO + " -> found=" + soArrFoundRr;
															if(soArrRr == null || soArrRr.size() == 0)
															{
																rrFallbackReason = "SO " + rrSO + " not found in Books";
															}
															if(soArrRr != null && soArrRr.size() > 0)
															{
																soIdRr = soArrRr.get(0).get("salesorder_id");
																soDetRespRr = invokeurl
																[
																	url :"https://www.zohoapis.com/books/v3/salesorders/" + soIdRr + "?organization_id=" + orgId
																	type :GET
																	connection:"zhbooks3"
																];
																bookLinesRr = soDetRespRr.get("salesorder").get("line_items");
																soLineIdRr = "";
																whIdRr = "";
																itemIdRr = "";
																for each  blRr in bookLinesRr
																{
																	if(blRr.get("sku") == rrSKU)
																	{
																		soLineIdRr = blRr.get("line_item_id");
																		whIdRr = blRr.get("warehouse_id");
																		itemIdRr = blRr.get("item_id");
																		break;
																	}
																}
																info "RR-DEBUG step2: SKU " + rrSKU + " on SO " + rrSO + " -> soLineIdRr=" + soLineIdRr + " whIdRr=" + whIdRr + " itemIdRr=" + itemIdRr;
																// FIXED 2026-08-15, real gap found live â€” Pre_Order_FF.Books_Package_ID
																// turned out blank on the ORIGINAL (non-RR) records too (PR-00003/4/5,
																// packaged 2026-08-14 before this whole disambiguation saga even
																// started, confirmed live via PR-00003's own edit form), so the first
																// version of this fix (sourcing origBooksPkgId from that Creator field)
																// always came up empty and silently fell through to the label-only path
																// every single time, regardless of whether Books itself could actually
																// support the real-package flow. Resolved directly from Books instead â€”
																// lists this SO's own packages and matches by the display package_number
																// (origPkgNo, already known from Sales_Order_Fulfillment) â€” no dependency
																// on any Creator-side field at all. Also confirmed live (native Books UI)
																// that PAC-16497's real status is "Not Shipped" â€” lower actual risk than
																// originally feared, no Shipment/Invoice is linked to it yet.
																origBooksPkgId = "";
																pkgListRespRr = invokeurl
																[
																	url :"https://www.zohoapis.com/books/v3/packages?organization_id=" + orgId + "&salesorder_id=" + soIdRr
																	type :GET
																	connection:"zhbooks3"
																];
																pkgListArrRr = pkgListRespRr.get("packages");
																if(pkgListArrRr != null)
																{
																	for each  pkgListItemRr in pkgListArrRr
																	{
																		if(pkgListItemRr.get("package_number") + "" == origPkgNo)
																		{
																			origBooksPkgId = pkgListItemRr.get("package_id") + "";
																		}
																	}
																}
																pkgListCountRr = 0;
																if(pkgListArrRr != null)
																{
																	pkgListCountRr = pkgListArrRr.size();
																}
																info "RR-DEBUG step3: looking for package_number=" + origPkgNo + " among " + pkgListCountRr + " Books packages on SO " + rrSO + " -> origBooksPkgId=" + origBooksPkgId;
																if(soLineIdRr == "")
																{
																	rrFallbackReason = "SKU " + rrSKU + " not found on SO " + rrSO + "'s Books line items";
																}
																if(soLineIdRr != "" && origBooksPkgId == "")
																{
																	rrFallbackReason = "original package " + origPkgNo + " not found in Books' package list for SO " + rrSO;
																}
																if(soLineIdRr != "" && origBooksPkgId != "")
																{
																	origPkgGetResp = invokeurl
																	[
																		url :"https://www.zohoapis.com/books/v3/packages/" + origBooksPkgId + "?organization_id=" + orgId
																		type :GET
																		connection:"zhbooks3"
																	];
																	origPkgObjGet = origPkgGetResp.get("package");
																	origPkgObjFoundRr = false;
																	if(origPkgObjGet != null)
																	{
																		origPkgObjFoundRr = true;
																	}
																	info "RR-DEBUG step4: fetched original package " + origBooksPkgId + " -> found=" + origPkgObjFoundRr + " raw=" + origPkgGetResp.toString();
																	if(origPkgObjGet == null)
																	{
																		rrFallbackReason = "could not fetch original package " + origBooksPkgId + " detail from Books";
																	}
																	if(origPkgObjGet != null)
																	{
																		origLineItemsGet = origPkgObjGet.get("line_items");
																		origLineQtyFound = -1;
																		newOrigLineItemsRr = List();
																		for each  opLineRr in origLineItemsGet
																		{
																			opSoLineIdRr = opLineRr.get("so_line_item_id") + "";
																			opQtyRr = opLineRr.get("quantity").toString().toDecimal();
																			// FIXED 2026-08-15, real Books rejection found live via RR-DEBUG step6:
																			// code 76014 "Associate bin details for item Baltazar..." â€” the PUT body
																			// only ever carried so_line_item_id+quantity for every line, dropping
																			// the "storages" (bin) array Books already had on file for every
																			// OTHER bin-tracked line on this same package (Baltazar/Andres, not
																			// just the CUSTOMIZED FLOOR LAMP line being reduced). Books validates
																			// the WHOLE line_items array on a PUT, not just the changed line, so a
																			// bin-tracked line submitted with no storages rejects the entire
																			// request. Fix: carry over each line's own existing "storages" from
																			// the GET response verbatim for untouched lines, and â€” for the line
																			// actually being reduced â€” carry over the same storage_id(s) with
																			// out_quantity scaled down to match the new (reduced) quantity, same
																			// single-bin-per-line assumption this whole app already uses
																			// everywhere else (Receiving/Create Package never split one line
																			// across 2 bins).
																			opStoragesRr = opLineRr.get("storages");
																			if(opSoLineIdRr == soLineIdRr)
																			{
																				origLineQtyFound = opQtyRr;
																				remainOrigRr = opQtyRr - rrQtyDec;
																				if(remainOrigRr > 0)
																				{
																					opMapRr = Map();
																					opMapRr.put("so_line_item_id",opSoLineIdRr);
																					opMapRr.put("quantity",remainOrigRr);
																					if(opStoragesRr != null && opStoragesRr.size() > 0)
																					{
																						newStoragesRr = List();
																						for each  opStRr in opStoragesRr
																						{
																							newStMapRr = Map();
																							newStMapRr.put("storage_id",opStRr.get("storage_id"));
																							newStMapRr.put("out_quantity",remainOrigRr);
																							newStoragesRr.add(newStMapRr);
																						}
																						opMapRr.put("storages",newStoragesRr);
																					}
																					newOrigLineItemsRr.add(opMapRr);
																				}
																			}
																			else
																			{
																				opMapRr2 = Map();
																				opMapRr2.put("so_line_item_id",opSoLineIdRr);
																				opMapRr2.put("quantity",opQtyRr);
																				if(opStoragesRr != null && opStoragesRr.size() > 0)
																				{
																					opMapRr2.put("storages",opStoragesRr);
																				}
																				newOrigLineItemsRr.add(opMapRr2);
																			}
																		}
																		info "RR-DEBUG step5: original package line for so_line_item_id=" + soLineIdRr + " -> origLineQtyFound=" + origLineQtyFound + ", need=" + rrQtyDec;
																		if(origLineQtyFound >= rrQtyDec)
																		{
																			origPutBodyRr = Map();
																			origPutBodyRr.put("date",origPkgObjGet.get("date"));
																			origPutBodyRr.put("line_items",newOrigLineItemsRr);
																			origPutRespRr = invokeurl
																			[
																				url :"https://www.zohoapis.com/books/v3/packages/" + origBooksPkgId + "?organization_id=" + orgId
																				type :PUT
																				parameters:origPutBodyRr.toString()
																				connection:"zhbooks3"
																			];
																			info "RR-DEBUG step6: PUT to reduce original package " + origBooksPkgId + " -> raw response=" + origPutRespRr.toString();
																			if(origPutRespRr.get("code") == 0)
																			{
																				itemRespRr = invokeurl
																				[
																					url :"https://www.zohoapis.com/books/v3/items/" + itemIdRr + "?organization_id=" + orgId
																					type :GET
																					connection:"zhbooks3"
																				];
																				itemObjRr = itemRespRr.get("item");
																				binTrackedRr = false;
																				if(itemObjRr != null)
																				{
																					whListRr = itemObjRr.get("warehouses");
																					for each  wRr in whListRr
																					{
																						if(wRr.get("warehouse_id") == whIdRr)
																						{
																							binTrackedRr = wRr.get("is_storage_location_enabled");
																							break;
																						}
																					}
																				}
																				newLineMapRr = Map();
																				newLineMapRr.put("so_line_item_id",soLineIdRr);
																				newLineMapRr.put("quantity",rrQtyDec);
																				binOkRr = true;
																				if(binTrackedRr == true)
																				{
																					storageIdRr = "";
																					stRespRr = invokeurl
																					[
																						url :"https://www.zohoapis.com/books/v3/settings/warehouses/" + whIdRr + "/storagelocations?organization_id=" + orgId
																						type :GET
																						connection:"zhbooks3"
																					];
																					stLocsRr = stRespRr.get("storage_locations");
																					for each  stRr in stLocsRr
																					{
																						if(stRr.get("name") == rrBinForPkg)
																						{
																							storageIdRr = stRr.get("storage_id");
																							break;
																						}
																					}
																					if(storageIdRr != "")
																					{
																						storagesListRr = List();
																						storagesListRr.add({"storage_id":storageIdRr,"out_quantity":rrQtyDec});
																						newLineMapRr.put("storages",storagesListRr);
																					}
																					else
																					{
																						binOkRr = false;
																						rrFallbackReason = "item is bin-tracked but no '" + rrBinForPkg + "' bin found at this warehouse";
																						info "RR replacement: item is bin-tracked but no '" + rrBinForPkg + "' bin found at this warehouse â€” falling back to label-only reference, Books left untouched beyond the already-reduced original.";
																					}
																				}
																				if(binOkRr == true)
																				{
																					newLineItemsListRr = List();
																					newLineItemsListRr.add(newLineMapRr);
																					newPkgBodyRr = Map();
																					newPkgBodyRr.put("date",zoho.currentdate.toString("yyyy-MM-dd"));
																					newPkgBodyRr.put("line_items",newLineItemsListRr);
																					newPkgRespRr = invokeurl
																					[
																						url :"https://www.zohoapis.com/books/v3/packages?organization_id=" + orgId + "&salesorder_id=" + soIdRr
																						type :POST
																						parameters:newPkgBodyRr.toString()
																						connection:"zhbooks3"
																					];
																					info "RR-DEBUG step7: POST to create new package for so_line_item_id=" + soLineIdRr + " qty=" + rrQtyDec + " -> raw response=" + newPkgRespRr.toString();
																					newPkgObjRr = newPkgRespRr.get("package");
																					if(newPkgObjRr != null)
																					{
																						origPkgNoForRr = newPkgObjRr.get("package_number");
																						r.Books_Package_ID=newPkgObjRr.get("package_id") + "";
																						realBooksPkgCreated = true;
																						info "RR replacement: reduced original Books package " + origBooksPkgId + " (" + origPkgNo + ") by " + rrQtyDec + ", created genuine new package " + origPkgNoForRr + " for SO " + rrSO + " / SKU " + rrSKU + ".";
																					}
																					else
																					{
																						rrFallbackReason = "original package ALREADY reduced by " + rrQtyDec + " but NEW package creation FAILED (NEEDS MANUAL CHECK in Books): " + newPkgRespRr.toString();
																						info "RR replacement: original Books package " + origBooksPkgId + " (" + origPkgNo + ") was ALREADY reduced by " + rrQtyDec + ", but creating the new package FAILED: " + newPkgRespRr.toString() + " â€” NEEDS MANUAL CHECK in Books, original package qty may now be understated. Falling back to label-only tracking for this app's own display.";
																					}
																				}
																			}
																			else
																			{
																				rrFallbackReason = "Books rejected reducing original package: " + origPutRespRr.toString();
																				info "RR replacement: could not reduce original Books package " + origBooksPkgId + " (" + origPkgNo + "): " + origPutRespRr.toString() + " â€” falling back to label-only reference, Books left untouched.";
																			}
																		}
																		else
																		{
																			rrFallbackReason = "original package line only has " + origLineQtyFound + ", less than the " + rrQtyDec + " needed";
																			info "RR replacement: original Books package " + origBooksPkgId + " line for SKU " + rrSKU + " only has " + origLineQtyFound + ", less than the " + rrQtyDec + " needed â€” falling back to label-only reference.";
																		}
																	}
																}
															}
														}
														if(realBooksPkgCreated == false && origIsDispatched == true)
														{
															rrPkgCollisionCount = 0;
															for each  otherPoRecRr in Pre_Order_FF[SO == rrSO && SKU == rrSKU && ID != r.ID]
															{
																otherPkgStrRr = otherPoRecRr.Package_Number + "";
																if(otherPkgStrRr == origPkgNo || otherPkgStrRr.startsWith(origPkgNo + "-"))
																{
																	rrPkgCollisionCount = rrPkgCollisionCount + 1;
																}
															}
															origPkgNoForRr = origPkgNo + "-" + (rrPkgCollisionCount + 1);
															info "RR replacement's original package " + origPkgNo + " already has a DISPATCHED item on it (SO " + rrSO + " / SKU " + rrSKU + ") â€” disambiguated to " + origPkgNoForRr + " for this app's own tracking, no new Books package created.";
														}
														r.Package_Number=origPkgNoForRr;
														r.Select_To_Package=false;
														if(deliveryType != null && deliveryType != "")
														{
															r.Delivery_Type=deliveryType;
														}
														rrOrderType = r.Order_Type + "";
														rrDeliveryType = r.Delivery_Type + "";
														rrPR = r.PR + "";
														rrCustName = r.Customer_Name + "";
														rrCustType = r.Customer_Type + "";
														rrCustAddress = r.Customer_Address + "";
														rrItemName = r.Item_Name + "";
														rrQty = r.Qty + "";
														rrBin = r.Bin_Location + "";
														if(rrBin == "null" || rrBin == "")
														{
															rrBin = origBinLocRr;
														}
														rrForCrate = r.For_Crate;
														rrTargetDelivery = r.Target_Delivery;
														if(rrTargetDelivery == null)
														{
															rrTargetDelivery = origTargetDelivRr;
														}
														// Matched on SO+SKU+rr_number (NOT Package_Order) so this never
														// collides with/overwrites the ORIGINAL shipment's own gate row
														// for the same SO+SKU+Package_Order â€” this is a distinct RR
														// event referencing that package, not an edit of the original.
														matchingGateRr = Sales_Order_Readiness_Gate[sales_order_number == rrSO && SKU == rrSKU && rr_number == rrJoined];
														foundExistingRr = false;
														for each  gateRecRr in matchingGateRr
														{
															update gateRecRr
															[
																Order_Type=rrOrderType
																Package_Order=origPkgNoForRr
																Delivery_Type=rrDeliveryType
																For_Crate=rrForCrate
																payment_status="Yes"
																customer_name=rrCustName
																customer_type=rrCustType
																customer_address=rrCustAddress
																pr_number=rrPR
																rr_number=rrJoined
																Item_Name=rrItemName
																Quantity=rrQty
																Bin_Location=rrBin
																Target_Delivery_Date=rrTargetDelivery
															];
															foundExistingRr = true;
														}
														if(foundExistingRr == false)
														{
															insert into Sales_Order_Readiness_Gate
															[
																sales_order_number=rrSO
																Order_Type=rrOrderType
																Package_Order=origPkgNoForRr
																Delivery_Type=rrDeliveryType
																For_Crate=rrForCrate
																payment_status="Yes"
																customer_name=rrCustName
																customer_type=rrCustType
																customer_address=rrCustAddress
																pr_number=rrPR
																rr_number=rrJoined
																Item_Name=rrItemName
																SKU=rrSKU
																Quantity=rrQty
																Bin_Location=rrBin
																Target_Delivery_Date=rrTargetDelivery
																Added_User=zoho.loginuser
															]
														}
														rrResultMsg = "Linked to original package " + origPkgNoForRr + " (RR " + rrJoined + ") â€” no new Books package created";
														// ADDED 2026-08-15, per user report ("still error") after the first
														// direct-Books-lookup fix still fell through with no way to tell WHY from
														// the widget's own toast/Network response alone (only Execution History
														// shows `info` lines, and that's proven hard for the user to locate/use
														// live). rrFallbackReason is set at every single point the real-package
														// attempt can give up, so the actual API response itself is now
														// self-diagnosing â€” no more guessing rounds needed.
														if(origIsDispatched == true && rrFallbackReason != "")
														{
															rrResultMsg = rrResultMsg + " [real Books package skipped: " + rrFallbackReason + "]";
														}
														if(realBooksPkgCreated == true)
														{
															rrResultMsg = "Created NEW Books package " + origPkgNoForRr + " for RR " + rrJoined + " (original package " + origPkgNo + " reduced accordingly)";
														}
														// ADDED 2026-08-15, per user request ("can u create a report... para
														// makita natin yung logs") â€” writes the exact same result message
														// (including rrFallbackReason above) directly onto this record's own
														// new Last_Package_Result field, so it's readable straight from the
														// Pre Order Report list/record (add as a column via Configure Fields)
														// with zero need for DevTools Network tab or Zoho's Execution History,
														// both already proven hard to use live this session.
														resultList.add({"recordId":ridRr,"status":"success","message":rrResultMsg});
													}
												}
											}
										}
										// CHANGED 2026-07-29, real bug found live: "Error at line number: 74
										// Invalid collection object found" â€” soGroups originally held actual
										// Pre_Order_FF RECORD OBJECTS (`grpList.add(r)`), then a later dedup check
										// read a field off one of those held objects (`rCheck.ID`) several nested
										// loop boundaries away from where it was fetched â€” the exact documented
										// "exotic object lifetime" Deluge gotcha already hit once before in this
										// codebase (clone_shipment_for_replacement.txt's own "Invalid collection
										// object found"): a query-result record held across 2+ nested loop
										// boundaries then dot-read later. Fixed the proven way â€” never hold the
										// record itself, only its plain ID STRING; soGroups now maps SO -> List of
										// ID strings, and every place that needs real field data does a FRESH
										// `Pre_Order_FF[ID==...]` fetch scoped to its own `for each` loop (same
										// pattern the "apply Package_Number" block below already used safely).
										soGroups = Map();
										seenSoForExpand = List();
										for each  ridRaw in normalIdList
										{
											rid = ridRaw.trim();
											if(rid == "")
											{
												continue;
											}
											for each  r in Pre_Order_FF[ID == rid.toLong()]
											{
												soVal = r.SO;
												rIdForGroup = r.ID + "";
												if(soVal == null || soVal == "")
												{
													resultList.add({"recordId":rIdForGroup,"status":"error","message":"Missing SO number on this record"});
												}
												else
												{
													grpList = List();
													if(soGroups.containKey(soVal))
													{
														grpList = soGroups.get(soVal);
													}
													if(!grpList.contains(rIdForGroup))
													{
														grpList.add(rIdForGroup);
													}
													soGroups.put(soVal,grpList);
													// ADDED 2026-07-29, per user ("only one created... they should both
													// inside PAC-16341") â€” auto-include every OTHER not-yet-packaged item
													// on this SAME SO via a FRESH server-side query, not just the exact
													// IDs the client happened to send. Confirmed via live debugging: the
													// widget-side "auto-expand to same SO" fix alone wasn't reliable
													// enough â€” it depends on the WIDGET'S OWN cached record list being
													// current at click time, which can lag behind real Creator data
													// (browser caching, a list not yet re-fetched since a data patch,
													// etc). Doing the expansion here instead â€” a live query at the exact
													// moment the function runs â€” removes that whole class of staleness
													// risk. `seenSoForExpand` guards against running this same expand
													// query twice if 2 explicit IDs for the same SO were both in the
													// input CSV.
													if(!seenSoForExpand.contains(soVal))
													{
														seenSoForExpand.add(soVal);
														for each  rExpand in Pre_Order_FF[SO == soVal && Package_Number == "" && Pre_Order_Status == "Received"]
														{
															// ADDED 2026-08-13 â€” never auto-sweep an RR-tagged sibling into
															// the Books group (see the RR split block above); it would hit
															// the exact same "no headroom" rejection this whole change
															// exists to avoid.
															rExpandIsRr = false;
															for each  rExpandRrRow in rExpand.Replacement_Request
															{
																rExpandIsRr = true;
															}
															if(rExpandIsRr == true)
															{
																continue;
															}
															rExpandIdStr = rExpand.ID + "";
															grpListCheck = soGroups.get(soVal);
															if(!grpListCheck.contains(rExpandIdStr))
															{
																grpListCheck.add(rExpandIdStr);
																soGroups.put(soVal,grpListCheck);
															}
														}
													}
												}
											}
										}
										// process each SO group
										for each  soNo in soGroups.keys()
										{
											grpRecs = soGroups.get(soNo);
											// List of ID strings now, not record objects â€” see the note above
											soListResp = invokeurl
											[
												url :"https://www.zohoapis.com/books/v3/salesorders?organization_id=" + orgId + "&salesorder_number=" + soNo.toString().replaceAll(" ","%20")
												type :GET
												connection:"zhbooks3"
											];
											soList = soListResp.get("salesorders");
											if(soList == null || soList.size() == 0)
											{
												for each  ridInGrp in grpRecs
												{
													resultList.add({"recordId":ridInGrp,"status":"error","message":"SO " + soNo + " not found in Books"});
												}
												continue;
											}
											soId = soList.get(0).get("salesorder_id");
											soDetResp = invokeurl
											[
												url :"https://www.zohoapis.com/books/v3/salesorders/" + soId + "?organization_id=" + orgId
												type :GET
												connection:"zhbooks3"
											];
											soDetail = soDetResp.get("salesorder");
											bookLines = soDetail.get("line_items");
											lineItemsPayload = List();
											matchedIds = List();
											errMap = Map();
											binCache = Map();
											// (warehouse_id|bin_name) -> storage_id, resolved once per combo per run
											seenInGroup = List();
											// 2nd layer of dedup insurance â€” belt-and-suspenders on top of the idList dedupe above
											for each  ridInGrp2 in grpRecs
											{
												if(seenInGroup.contains(ridInGrp2))
												{
													continue;
												}
												seenInGroup.add(ridInGrp2);
												for each  r in Pre_Order_FF[ID == ridInGrp2.toLong()]
												{
													skuVal = r.SKU;
													qtyVal = r.Qty.toDecimal();
													matched = false;
													for each  bl in bookLines
													{
														blSku = bl.get("sku");
														if(blSku == skuVal)
														{
															matched = true;
															blQty = bl.get("quantity").toString().toDecimal();
															blPacked = bl.get("quantity_packed").toString().toDecimal();
															remaining = blQty - blPacked;
															if(remaining < qtyVal)
															{
																errMap.put(r.ID + "","Only " + remaining + " left to pack on SO " + soNo + " (requested " + qtyVal + ")");
															}
															else
															{
																lineMap = Map();
																lineMap.put("so_line_item_id",bl.get("line_item_id"));
																lineMap.put("quantity",qtyVal);
																// Bin-tracked items REQUIRE a storages array or Books rejects the whole
																// package with code 76014 "Associate bin details for item X" â€” confirmed
																// live 2026-07-24. CHANGED 2026-07-29, per user ("use the bin location
																// in creator to create both packages") â€” prefers THIS record's own
																// Bin_Location (already known/populated by Receiving's own bin-push,
																// e.g. "Receiving Area") over a hardcoded default, so the package's real
																// storage assignment matches what Creator already shows. Falls back to
																// "Receiving Area" only when the record's own Bin_Location is blank.
																// Resolved once per (warehouse, target bin name) per run.
																targetBinName = r.Bin_Location + "";
																if(targetBinName == null || targetBinName == "")
																{
																	targetBinName = "Receiving Area";
																}
																whId = bl.get("warehouse_id");
																itemId = bl.get("item_id");
																itemResp = invokeurl
																[
																	url :"https://www.zohoapis.com/books/v3/items/" + itemId + "?organization_id=" + orgId
																	type :GET
																	connection:"zhbooks3"
																];
																itemObj = itemResp.get("item");
																binTracked = false;
																if(itemObj != null)
																{
																	whList = itemObj.get("warehouses");
																	for each  w in whList
																	{
																		if(w.get("warehouse_id") == whId)
																		{
																			binTracked = w.get("is_storage_location_enabled");
																			break;
																		}
																	}
																}
																if(binTracked == true)
																{
																	binCacheKey = whId + "|" + targetBinName;
																	storageId = "";
																	if(binCache.containKey(binCacheKey))
																	{
																		storageId = binCache.get(binCacheKey);
																	}
																	else
																	{
																		stResp = invokeurl
																		[
																			url :"https://www.zohoapis.com/books/v3/settings/warehouses/" + whId + "/storagelocations?organization_id=" + orgId
																			type :GET
																			connection:"zhbooks3"
																		];
																		stLocs = stResp.get("storage_locations");
																		for each  st in stLocs
																		{
																			if(st.get("name") == targetBinName)
																			{
																				storageId = st.get("storage_id");
																				break;
																			}
																		}
																		binCache.put(binCacheKey,storageId);
																	}
																	if(storageId != "")
																	{
																		storagesList = List();
																		storagesList.add({"storage_id":storageId,"out_quantity":qtyVal});
																		lineMap.put("storages",storagesList);
																	}
																	else
																	{
																		errMap.put(r.ID + "","Item is bin-tracked but no '" + targetBinName + "' bin found at this warehouse â€” needs manual bin assignment in Books");
																	}
																}
																if(!errMap.containKey(r.ID + ""))
																{
																	lineItemsPayload.add(lineMap);
																	matchedIds.add(r.ID + "");
																}
															}
															break;
														}
													}
													if(!matched)
													{
														errMap.put(r.ID + "","SKU " + skuVal + " not found on SO " + soNo);
													}
												}
											}
											if(lineItemsPayload.size() > 0)
											{
												pkgBody = Map();
												pkgBody.put("date",zoho.currentdate.toString("yyyy-MM-dd"));
												pkgBody.put("line_items",lineItemsPayload);
												// ADDED 2026-07-30, per user request â€” widget now collects a mandatory
												// Delivery Type before Create Package (exact same picklist as Books' own
												// `cf_delivery_type` custom field on the Package module, confirmed via
												// so_fulfillment_sync.txt's own READ side of this same field â€” that script
												// reads api_name "cf_delivery_type"; label-keyed write matches this app's
												// own proven-working custom_fields write pattern, e.g.
												// create_estimates_inq_action.txt's ucf1.put("label", ...)).
												if(deliveryType != null && deliveryType != "")
												{
													pkgCfList = List();
													pkgCf1 = Map();
													pkgCf1.put("label","Delivery Type");
													pkgCf1.put("value",deliveryType);
													pkgCfList.add(pkgCf1);
													pkgBody.put("custom_fields",pkgCfList);
												}
												pkgResp = invokeurl
												[
													url :"https://www.zohoapis.com/books/v3/packages?organization_id=" + orgId + "&salesorder_id=" + soId
													type :POST
													parameters:pkgBody.toString()
													connection:"zhbooks3"
												];
												pkgObj = pkgResp.get("package");
												if(pkgObj != null)
												{
													pkgNo = pkgObj.get("package_number");
													pkgIdVal = pkgObj.get("package_id") + "";
													for each  midRaw in matchedIds
													{
														for each  r in Pre_Order_FF[ID == midRaw.toLong()]
														{
															// ADDED 2026-08-14, real live bug (SO-16476/PR-00006, "CUSTOMIZED
															// (FLOOR LAMP)") â€” this POST always creates a genuinely fresh Books
															// package object (no reuse/lookup logic anywhere in this file), but
															// Books itself returned the SAME package_number as an earlier,
															// already-Dispatched package for the same SO+SKU line (confirmed live
															// via the native Pre Order Report â€” PR-00003 and PR-00006 both showed
															// PAC-16497). Per user decision, the ORIGINAL already-sent package must
															// NOT be touched/reduced in Books (risk: it may already be linked to a
															// Shipment/Invoice) â€” instead, disambiguate on OUR OWN side only, so
															// checker_checklist_qc_sync.txt's SO+SKU+PAC match (and every other
															// PAC-keyed match in this pipeline â€” Readiness Gate/Pick1/Pack/QC) sees
															// this as a genuinely separate package/delivery event, never merging its
															// qty into the old one. Scans every OTHER Pre_Order_FF row for the same
															// SO+SKU whose own Package_Number is either the bare pkgNo or an already-
															// suffixed "pkgNo-N" (handles a 3rd+ collision on the same SKU, not just
															// a 2nd), and appends the next free "-N" suffix if any collision exists.
															// Books_Package_ID below is UNCHANGED â€” the real Books-side identifier
															// stays accurate; only this display/matching Package_Number is suffixed.
															// REFINED 2026-08-14, per user ("if pending pa to pwedeng old package or
															// yung existing package ang gagamitin. if Dispatched na ang status niya
															// dapat magcreate ng new package") â€” only counts as a real collision
															// needing a NEW label when the package Books reused already has a
															// DISPATCHED item on it (Order_Aggregation1.Item_Details, this SO+SKU+PAC,
															// Dispatched==true). A still-pending sibling sharing the same package is
															// fine/expected â€” nothing has physically shipped yet, so consolidating
															// into the one package is the normal, desired case, no need to force a
															// new label. dispatchedPacsForSku computed once (not per otherPoRec) â€”
															// small, bounded by this SO's own Order_Aggregation1 record (normally
															// just one).
															dispatchedPacsForSku = List();
															for each  aggCheckRec in Order_Aggregation1[SO == r.SO]
															{
																for each  aggCheckRow in aggCheckRec.Item_Details
																{
																	if(aggCheckRow.SKU + "" == r.SKU && aggCheckRow.Dispatched == true)
																	{
																		dpPac = aggCheckRow.PAC + "";
																		if(!dispatchedPacsForSku.contains(dpPac))
																		{
																			dispatchedPacsForSku.add(dpPac);
																		}
																	}
																}
															}
															pkgNoForRow = pkgNo;
															pkgCollisionCount = 0;
															for each  otherPoRec in Pre_Order_FF[SO == r.SO && SKU == r.SKU && ID != r.ID]
															{
																otherPkgStr = otherPoRec.Package_Number + "";
																if(otherPkgStr == pkgNo || otherPkgStr.startsWith(pkgNo + "-") && dispatchedPacsForSku.contains(otherPkgStr))
																{
																	pkgCollisionCount = pkgCollisionCount + 1;
																}
															}
															if(pkgCollisionCount > 0)
															{
																pkgNoForRow = pkgNo + "-" + (pkgCollisionCount + 1);
																info "Package number collision: Books returned " + pkgNo + " again for SO " + r.SO + " / SKU " + r.SKU + " but that package already has a DISPATCHED item on it â€” disambiguated to " + pkgNoForRow + " for this app's own tracking, original Books package left untouched.";
															}
															r.Package_Number=pkgNoForRow;
															r.Books_Package_ID=pkgIdVal;
															r.Select_To_Package=false;
															// FIXED 2026-08-05, real gap found â€” deliveryType was collected by the
															// widget and forwarded into the Books package's own custom field above,
															// but never written back onto this native Pre_Order_FF record. Since
															// Pre_Order1_Report (what PreOrderReport widget reads) is a report over
															// this same form, its "Delivery Type" field in Sales Order Details was
															// always blank as a result. gwDeliveryType below (used for the
															// Readiness Gate push) reads r.Delivery_Type too, so it was always
															// blank there as well â€” this one write fixes both.
															if(deliveryType != null && deliveryType != "")
															{
																r.Delivery_Type=deliveryType;
															}
															gwPreOrderStatus = r.Pre_Order_Status + "";
															if(gwPreOrderStatus == "Received")
															{
																gwSO = r.SO + "";
																gwSKU = r.SKU + "";
																// RESTORED 2026-07-30, per user request ("bring back when creating
																// package successfully -> put it in Sales Order Readiness Gate
																// again") â€” was removed 2026-07-29, now reinstated. Mirrors
																// preorder_to_readiness_gate.txt's own Pre_Order_FF ->
																// Sales_Order_Readiness_Gate upsert â€” kept as an inline,
																// duplicate-but-consistent push here (not relying on that native
																// Edited-trigger workflow firing off this Custom Function's own
																// r.Package_Number write above, same "cross-form workflow trigger
																// is unproven from inside a Custom Function" caution already
																// documented elsewhere in this app) â€” same reasoning the
																// Sales_Order_Fulfillment sync right below already uses.
																// Match key is SO+SKU only (no Package_Order), same known,
																// flagged-not-fixed limitation as preorder_to_readiness_gate.txt
																// itself (docs/2026-07-29-partial-quantity-fulfillment-design.md
																// â€” collides if the same SKU is packaged across 2 separate
																// events) â€” restoring prior behavior only, not fixing that gap
																// here. `rr_number` (Replacement_Request subform) deliberately
																// left blank â€” reading a subform off a criteria-queried record
																// inside a Custom Function is a separately-documented unreliable
																// pattern, not worth the risk for one reference-only field.
																gwOrderType = r.Order_Type + "";
																gwDeliveryType = r.Delivery_Type + "";
																// FIXED 2026-08-05, real bug found live (SO-16399, PAC-16408/PAC-16409 both
																// showed payment_status="Paid" on the native Sales_Order_Readiness_Gate_Report
																// instead of the real Yes/No/Partial vocabulary) â€” same stale-label-translation
																// bug already fixed in so_fulfillment_to_readiness_gate.txt (see that file's own
																// NOTES for the full writeup: Sales_Order_Readiness_Gate.payment_status no longer
																// uses Paid/Partially Paid/Pending). Direct passthrough is correct â€” also fixes a
																// SECOND bug that was here: the old check compared against "Partially" (with the
																// extra "ly"), but the real value this app ever writes is "Partial" (no "ly", per
																// payment_status_to_kanban/Temp.txt) â€” that branch could never have fired at all.
																gwPaymentRaw = r.Status + "";
																gwPaymentStatus = gwPaymentRaw;
																gwPR = r.PR + "";
																gwCustName = r.Customer_Name + "";
																gwCustType = r.Customer_Type + "";
																gwCustAddress = r.Customer_Address + "";
																gwItemName = r.Item_Name + "";
																gwQty = r.Qty + "";
																gwBin = r.Bin_Location + "";
																gwForCrate = r.For_Crate;
																gwTargetDelivery = r.Target_Delivery;
																// FIXED 2026-08-07 â€” same real bug/fix as so_fulfillment_to_readiness_gate.txt
																// (see that file's own comment for the full writeup). Independent code path,
																// must be fixed separately â€” confirmed not shared code.
																matchingGateRecs = Sales_Order_Readiness_Gate[sales_order_number == gwSO && SKU == gwSKU && Package_Order == pkgNoForRow];
																gwFoundExisting = false;
																for each  gateRec in matchingGateRecs
																{
																	update gateRec
																	[
																		Order_Type=gwOrderType
																		Package_Order=pkgNoForRow
																		Delivery_Type=gwDeliveryType
																		For_Crate=gwForCrate
																		payment_status=gwPaymentStatus
																		customer_name=gwCustName
																		customer_type=gwCustType
																		customer_address=gwCustAddress
																		pr_number=gwPR
																		Item_Name=gwItemName
																		Quantity=gwQty
																		Bin_Location=gwBin
																		Target_Delivery_Date=gwTargetDelivery
																	];
																	gwFoundExisting = true;
																}
																if(gwFoundExisting == false)
																{
																	insert into Sales_Order_Readiness_Gate
																	[
																		sales_order_number=gwSO
																		Order_Type=gwOrderType
																		Package_Order=pkgNoForRow
																		Delivery_Type=gwDeliveryType
																		For_Crate=gwForCrate
																		payment_status=gwPaymentStatus
																		customer_name=gwCustName
																		customer_type=gwCustType
																		customer_address=gwCustAddress
																		pr_number=gwPR
																		Item_Name=gwItemName
																		SKU=gwSKU
																		Quantity=gwQty
																		Bin_Location=gwBin
																		Target_Delivery_Date=gwTargetDelivery
																		Added_User=zoho.loginuser
																	]
																}
																// ===== INLINE Sales_Order_Fulfillment sync, added 2026-07-28 =====
																// Per user request ("when package is created in Pre Order Report
																// let's add it's number in Sales Order Report too").
																// FIXED 2026-07-29, real bug found live â€” this used to match by
																// SO_No ONLY, which meant creating a package for JUST 2 of a SO's 3
																// items still overwrote the `Package` field on ALL 3 of that SO's
																// Sales_Order_Fulfillment records â€” including the 3rd item's own,
																// genuinely different, ALREADY-EXISTING package number (confirmed
																// live: SO-16335's Aqi item had real PAC-16336, a brand-new
																// FLOOR LAMP+STEPLGHT-only package PAC-16344 silently clobbered it
																// to also show PAC-16344). Sales_Order_Fulfillment turned out to be
																// one record PER ITEM after all (confirmed via live data â€” 3 separate
																// records for one SO, each with exactly 1 row in its own
																// Item_Details1), not one-per-SO as this block's original comment
																// assumed â€” so the fix is a real per-item match: only update a
																// Sales_Order_Fulfillment record whose own Item_Details1 actually
																// contains the SKU that was just packaged.
																sofMatches = Sales_Order_Fulfillment[SO_No == gwSO];
																for each  sofRec in sofMatches
																{
																	sofSkuMatch = false;
																	for each  sofRow in sofRec.Item_Details1
																	{
																		if(sofRow.SKU + "" == gwSKU)
																		{
																			sofSkuMatch = true;
																			break;
																		}
																	}
																	if(sofSkuMatch == true)
																	{
																		// FIXED 2026-08-05, same gap as the Pre_Order_FF write above â€”
																		// SO widget's own detail view also has a "Delivery Type" row
																		// reading Sales_Order_Fulfillment.Delivery_Type, always blank
																		// until now for the same reason.
																		update sofRec
																		[
																			Package=pkgNoForRow
																			Package_Date=zoho.currentdate
																			Delivery_Type=gwDeliveryType
																		];
																	}
																}
															}
														}
														resultList.add({"recordId":midRaw,"status":"success","message":"Packaged as " + pkgNoForRow});
													}
												}
												else
												{
													for each  midRaw in matchedIds
													{
														resultList.add({"recordId":midRaw,"status":"error","message":"Books package create failed: " + pkgResp.toString()});
													}
												}
											}
											for each  ridInGrp3 in grpRecs
											{
												if(errMap.containKey(ridInGrp3))
												{
													resultList.add({"recordId":ridInGrp3,"status":"error","message":errMap.get(ridInGrp3)});
												}
											}
										}
										// ==== createPackageFF's own body ends here ====
										alertMsg = "";
										for each  resRow in resultList
										{
											alertMsg = alertMsg + resRow.get("recordId") + ": " + resRow.get("status") + " -- " + resRow.get("message") + "\n";
										}
										if(alertMsg == "")
										{
											alertMsg = "No records processed â€” check that Select_To_Package is checked on this record or its SO siblings.";
										}
										success message alertMsg;
					)
					}
				}
			}
		}
	}
