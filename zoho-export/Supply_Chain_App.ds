			PR_Export_Selected_Suppli as "PR_Export_Selected_Supplier"
			{
				type =  form
				form = Purchase_Request1

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PR_Export_Selected_Supplier ===
										// Form: Purchase_Request1 | Event: Created or Edited | Validations on form submission
										// === Step A: Hanapin ang row sa Supplier_Selected subform kung saan Selected = true ===
										for each  row in input.Supplier_Selected
										{
											if(row.Selected == true)
											{
												// === Step B: I-export ang supplier name, final cost, at lead time papunta sa PR-level fields ===
												input.Selected_Supplier = row.Suppliers;
												Selected_Final_Cost = row.Final_Price;
												input.Required_Days_Lead = row.Lead_Time;
											}
										}
						)
					}
				}

			}
			PR_Compute_Shipment_Timel as "PR_Compute_Shipment_Timeline"
			{
				type =  form
				form = Purchase_Request1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PR_Compute_Shipment_Timeline ===
										// Form: Purchase_Request1 | Event: Created or Edited | Validations on form submission
										if(input.PR_Status == "Converted to PO")
										{
											effectiveProductionDate = input.Production_Date;
										}
										else
										{
											effectiveProductionDate = zoho.currentdate;
											input.Production_Date = zoho.currentdate;
											// preview lang — mao-override ng actual date sa PO conversion
										}
										if(effectiveProductionDate != null)
										{
											shipDays = 14;
											// FIXED 2026-09-05, per user ("wala namang lcl, fcl at air pag sa local lang") —
											// Local (HC System) sourcing has no external freight leg at all, so there's no
											// shipping buffer to add — target date collapses to the production date itself
											// (already today + 0 lead days, per pr_sync_supplier_selected.txt's own Local
											// guard). Checked BEFORE the LCL/FCL check so it always wins for Local regardless
											// of whatever stale Shipment_Mode value might be sitting on the record.
											if(input.Sourcing_Type == "Local")
											{
												shipDays = 0;
											}
											else if(input.Shipment_Mode == "LCL" || input.Shipment_Mode == "FCL")
											{
												shipDays = 30;
											}
											productionEndDate = effectiveProductionDate.addDay(input.Required_Days_Lead);
											Supplier_Target_Date = productionEndDate.addDay(shipDays);
											today = zoho.currentdate;
											currentTarget = productionEndDate;
											if(today > productionEndDate)
											{
												currentTarget = Supplier_Target_Date;
											}
											rawDiff = (currentTarget - today);
											input.Remaining_Days = (rawDiff / 86400000).round(0);
											if(today > input.Supplier_Target_Date)
											{
												input.Delay_Status = "Delayed";
											}
											else if(input.Remaining_Days <= 3)
											{
												input.Delay_Status = "At Risk";
											}
											else
											{
												input.Delay_Status = "On Track";
											}
										}
						)
					}
				}

			}
			PO_Compute_Totals as "PO_Compute_Totals"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PO_Compute_Totals ===
										// Form: Purchase_Order | Event: Created or Edited | Validations on form submission
										totalValue = 0;
										totalLines = 0;
										for each  ln in input.PO_Line_Items
										{
											totalLines = totalLines + 1;
											if(ln.Line_Total != null)
											{
												totalValue = totalValue + ln.Line_Total;
											}
										}
										input.Total_PO_Value = totalValue;
										input.Total_Lines = totalLines;
						)
					}
				}

			}
			PO_Detect_Mixed as "PO_Detect_Mixed"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PO_Detect_Mixed ===
										// Form: Purchase_Order | Event: Created or Edited | Validations on form submission
										firstShippingMode = "";
										isMixedShipping = false;
										for each  ln in input.PO_Line_Items
										{
											if(firstShippingMode == "")
											{
												firstShippingMode = ln.Shipping_Mode;
											}
											else if(ln.Shipping_Mode != firstShippingMode)
											{
												isMixedShipping = true;
											}
										}
										input.Mixed_Shipping = isMixedShipping;
						)
					}
				}

			}
			PO_Status_Timestamps as "PO_Status_Timestamps"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PO_Status_Timestamps ===
										// Form: Purchase_Order | Event: Created or Edited | Validations on form submission
										oldRec = Purchase_Order[ID == input.ID];
										// Sent On — kapag bagong naging "Sent" ang status
										if(input.PO_Status == "Sent")
										{
											if(oldRec.PO_Status != "Sent")
											{
												input.Sent_On = zoho.currentdate;
											}
										}
										// Acknowledged On — kapag bagong naging "Acknowledged" ang status
										if(input.PO_Status == "Acknowledged")
										{
											if(oldRec.PO_Status != "Acknowledged")
											{
												Acknowledged_On = zoho.currentdate;
											}
										}
										// Completed On — kapag bagong naging "Completed" ang status
										if(input.PO_Status == "Completed")
										{
											if(oldRec.PO_Status != "Completed")
											{
												input.Completed_On = zoho.currentdate;
											}
										}
						)
					}
				}

			}
			Item_Image_Create_Update as "Item_Image_Create_Update"
			{
				type =  form
				form = Inquiry_Form

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											recs = Inquiry_Form[ID == input.ID];
										for each  r in recs
										{
											itemRecs = Items[SKU == r.sku];
											for each  i in itemRecs
											{
												r.Product_Image=i.Image;
												break;
											}
											break;
										}
						)
					}
				}

			}
			PR_Set_Shipment_Mode as "PR_Set_Shipment_Mode"
			{
				type =  form
				form = Purchase_Request1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PR_Set_Shipment_Mode ===
										// Form: Purchase_Request1 | Event: Created or Edited | Validations on form submission
										// Auto-derive supplier_target_date from Target_Delivery — always recompute
										if(input.Target_Delivery != null)
										{
											input.supplier_target_date = input.Target_Delivery.addDay(-4);
										}
										// Auto-set Shipment_Mode + Shipment_Days only — hindi na nag-se-set ng Remaining_Days dito
										if(input.PR_Status != "Converted to PO")
										{
											targetDate = input.supplier_target_date;
											if(targetDate != null)
											{
												remainingDays = (targetDate - zoho.currentdate);
												remainingDaysNum = (remainingDays / 86400000).round(0);
												if(remainingDaysNum >= 30)
												{
													input.Shipment_Mode = "LCL";
													input.Shipment_Days = 30;
												}
												else
												{
													input.Shipment_Mode = "Airfreight";
													input.Shipment_Days = 14;
												}
											}
										}
						)
					}
				}

			}
			PO_Generate_Number2 as "PO_Generate_Number"
			{
				type =  form
				form = Fenteng_Lighting_Purchase_Order

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// === PO_Generate_Number ===
										// Form: Purchase_Order | Event: Created | Validations on form submission
										maxNum = 0;
										existingPOs = Purchase_Order[ID != 0];
										for each  po in existingPOs
										{
											poNoStr = po.PO_No;
											if(poNoStr != null && poNoStr != "")
											{
												numPart = poNoStr.removeFirstOccurence("PO-");
												num = numPart.toLong();
												if(num > maxNum)
												{
													maxNum = num;
												}
											}
										}
										newNum = maxNum + 1;
										if(newNum < 10)
										{
											input.PO_No_Supplier1 = "PO-0000" + newNum;
										}
										else if(newNum < 100)
										{
											input.PO_No_Supplier1 = "PO-000" + newNum;
										}
										else if(newNum < 1000)
										{
											input.PO_No_Supplier1 = "PO-00" + newNum;
										}
										else if(newNum < 10000)
										{
											input.PO_No_Supplier1 = "PO-0" + newNum;
										}
										else
										{
											input.PO_No_Supplier1 = "PO-" + newNum;
										}
						)
					}
				}

			}
