			PR_Sync_Supplier_Load_Bal as "PR_Sync_Supplier_Load_Balancing"
			{
				type =  form
				form = Purchase_Request1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											prCategory = input.category;
										eligibleSupplierIDs = List();
										for each  sup in Suppliers[ID != 0]
										{
											matched = false;
											if(sup.Handles_All)
											{
												matched = true;
											}
											else if(sup.Supported_Categories != null && sup.Supported_Categories != "")
											{
												catRaw = sup.Supported_Categories.replaceAll("\r","");
												if(catRaw.contains("\n"))
												{
													catList = catRaw.toList("\n");
												}
												else
												{
													catList = catRaw.toList(",");
												}
												for each  c in catList
												{
													if(c.trim() == prCategory)
													{
														matched = true;
													}
												}
											}
											if(matched)
											{
												eligibleSupplierIDs.add(sup.ID.toString());
											}
										}
										existingSupplierIDs = List();
										for each  qr in input.Supplier_Load_Balancing
										{
											existingSupplierIDs.add(qr.Suppliers.toString());
											if(!eligibleSupplierIDs.contains(qr.Suppliers.toString()))
											{
												qr.Match_Category="Not Match";
												qr.Eligible_Supplier="Removed";
											}
										}
										for each  sid in eligibleSupplierIDs
										{
											if(!existingSupplierIDs.contains(sid))
											{
												supName = "";
												for each  supRec in Suppliers
												{
													if(supRec.ID + "" == sid)
													{
														supName = supRec.Supplier_Name.first_name + "";
														if(supName == "" || supName == "null")
														{
															supName = supRec.Supplier_Name.last_name + "";
														}
													}
												}
												newRow = Purchase_Request1.Supplier_Load_Balancing();
												newRow.Suppliers=sid;
												newRow.Match_Category="Match";
												input.Supplier_Load_Balancing.insert(newRow);
											}
										}
										/* ADDED 2026-07-15, per user ("active po count might not be accurate... also the load
										   bar"): Suppliers.Active_PO_Count/Utilization/Status are stale snapshot fields —
										   Active_PO_Count only gets recomputed by pr_to_po_grouping.txt's Action 1, and only for
										   whichever ONE supplier gets approved on a given PR (the other supplier's count never
										   updates, and neither ever decrements when a PO completes/cancels); Utilization/Status
										   are never written by ANY script in this codebase at all (confirmed via grep), so they
										   read permanently blank — that's why the load bar always showed 0%. Fix: compute
										   Active POs + Load % LIVE right here, every time this script runs, straight from real
										   Purchase_Order data — same source Action 1 itself uses (PO_Line_Items ROWS, not
										   distinct PO count, per user's explicit choice to stay consistent with Action 1's own
										   existing definition), same active/Max_Capacity ratio the widget's own
										   computeRecommendedSupplier() client fallback already uses. Deliberately does NOT
										   write anything back to the Suppliers form itself — stays fully local to this
										   subform's own display columns, so it can't race or conflict with Action 1's separate
										   Active_PO_Count snapshot/Supplier_Load_At_PO semantics elsewhere. */
										supplierNameById = Map();
										for each  sid in eligibleSupplierIDs
										{
											nm = "";
											for each  supRec2 in Suppliers
											{
												if(supRec2.ID + "" == sid)
												{
													nm = supRec2.Supplier_Name.first_name + "";
													if(nm == "" || nm == "null")
													{
														nm = supRec2.Supplier_Name.last_name + "";
													}
												}
											}
											supplierNameById.put(sid,nm);
										}
										liveCountByName = Map();
										allActivePOs = Purchase_Order[PO_Status != "Completed" && PO_Status != "Cancelled"];
										for each  po in allActivePOs
										{
											for each  poLn in po.PO_Line_Items
											{
												supNameLn = poLn.Supplier;
												curCnt = liveCountByName.get(supNameLn);
												if(curCnt == null)
												{
													curCnt = 0;
												}
												liveCountByName.put(supNameLn,curCnt + 1);
											}
										}
										/* CHANGED 2026-08-15, per user ("dapat ang recommendation ay based sa pinakababang
										   Initial Price, or if available ang Negotiated, pinaka mabilis na Lead Time (days).
										   Pero if existing na ang price, dapat sa lead time na magbebased ng recommendation.
										   and based din sa category.") — recommendedID used to be purely "fewest currently
										   active PO line items" (raw count, not even normalized against Max_Capacity). Per
										   explicit user direction, replaced with: PRICE first (Negotiated if the supplier has
										   entered one, else Initial_Price), LOWEST wins; Lead_Time (days) as the tiebreaker
										   ONLY when price is tied/equal between suppliers. Category eligibility (the
										   eligibleSupplierIDs list above) is untouched — still the same Handles_All/
										   Supported_Categories gate. Active_POs/Percent/Load_Status below are left computed
										   and displayed as before (still genuinely useful load info) — they just no longer
										   drive which supplier gets the "Recommended" tag.
										   Price/Lead_Time source: Purchase_Request1's own generic `Supplier_Selected` subform
										   (Suppliers/Availability/Initial_Price/Negotiated/Final_Price/Lead_Time per row,
										   already kept in sync from each supplier's own Fenteng_Lighting_Purchase_Request/
										   Tony_Fan_Purchase_Request submission by PR_Stage_Supplier_Changed_Supplier1/2 in
										   purchase_request_scripts1.txt) — matched by supplier NAME with the same
										   `== nm || .contains(nm)` short/full-name-safe pattern already established
										   elsewhere in this app (e.g. that same sync script's own 2026-08-07 fix,
										   supplierKeyMatch()), since `row.Suppliers` here is a name string, not the ID
										   `eligibleSupplierIDs` uses. UNTESTED — needs a live PR with 2 quoted suppliers,
										   differing prices (confirm lower price wins) and then equal prices with differing
										   Lead_Time (confirm lead time breaks the tie). */
										recommendedID = "";
										bestPriceVal = -1;
										bestLeadTimeVal = -1;
										for each  sid in eligibleSupplierIDs
										{
											nmForPrice = supplierNameById.get(sid);
											priceForSid = -1;
											leadTimeForSid = -1;
											for each  qsRow in input.Supplier_Selected
											{
												rowSupVal = qsRow.Suppliers + "";
												if(rowSupVal == nmForPrice || rowSupVal.contains(nmForPrice))
												{
													negVal = qsRow.Negotiated;
													initVal = qsRow.Initial_Price;
													if(negVal != null && negVal > 0)
													{
														priceForSid = negVal;
													}
													else if(initVal != null && initVal > 0)
													{
														priceForSid = initVal;
													}
													leadTimeForSid = qsRow.Lead_Time;
												}
											}
											if(priceForSid >= 0)
											{
												if(bestPriceVal == -1 || priceForSid < bestPriceVal)
												{
													bestPriceVal = priceForSid;
													bestLeadTimeVal = leadTimeForSid;
													recommendedID = sid;
												}
												else if(priceForSid == bestPriceVal)
												{
													if(leadTimeForSid != null && bestLeadTimeVal == -1 || leadTimeForSid < bestLeadTimeVal)
													{
														bestLeadTimeVal = leadTimeForSid;
														recommendedID = sid;
													}
												}
											}
										}
										for each  qr in input.Supplier_Load_Balancing
										{
											sidStr = qr.Suppliers.toString();
											if(eligibleSupplierIDs.contains(sidStr))
											{
												maxCap_tmp = 0;
												for each  supRec in Suppliers
												{
													if(supRec.ID + "" == sidStr)
													{
														maxCap_tmp = ifnull(supRec.Max_Capacity,0);
													}
												}
												nmForRow = supplierNameById.get(sidStr);
												liveCnt = liveCountByName.get(nmForRow);
												if(liveCnt == null)
												{
													liveCnt = 0;
												}
												maxCap = maxCap_tmp;
												pct = 0;
												if(maxCap > 0)
												{
													pct = (liveCnt * 100) / maxCap;
												}
												statusVal = "Normal";
												if(pct >= 100)
												{
													statusVal = "Overloaded";
												}
												else if(pct >= 80)
												{
													statusVal = "Near Capacity";
												}
												qr.Match_Category="Match";
												qr.Active_POs=liveCnt;
												qr.Percent=pct;
												qr.Load_Status=statusVal;
												// CHANGED 2026-08-15, label text updated to match the new price/lead-time
												// basis above — "Higher load" was accurate for the old raw-count logic,
												// no longer true now that price/lead time (not active-PO count) decides.
												if(sidStr == recommendedID)
												{
													qr.Eligible_Supplier="Recommended";
												}
												else
												{
													qr.Eligible_Supplier="Available";
												}
											}
										}
						)
					}
				}

			}
			PR_Sync_Supplier_Selected as "PR_Sync_Supplier_Selected"
			{
				type =  form
				form = Purchase_Request1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sourcing_Type == "Local")
										{
											input.Selected_Supplier = "HC System";
											input.Required_Days_Lead = 0;
											return;
										}
										// === Step 1: Build list of category-matched suppliers + find the Recommended one ===
										matchedSupplierIDs = List();
										recommendedSupplierID = "";
										for each  qr in input.Supplier_Load_Balancing
										{
											if(qr.Match_Category == "Match")
											{
												sidStr = qr.Suppliers.toString();
												if(!matchedSupplierIDs.contains(sidStr))
												{
													matchedSupplierIDs.add(sidStr);
												}
												if(qr.Eligible_Supplier == "Recommended")
												{
													recommendedSupplierID = sidStr;
												}
											}
										}
										// === Step 2: Flag existing Supplier_Selected rows no longer matched ===
										existingSelectedIDs = List();
										for each  ssel in input.Supplier_Selected
										{
											selIDStr = ssel.Supplier_ID.toString();
											existingSelectedIDs.add(selIDStr);
											if(!matchedSupplierIDs.contains(selIDStr))
											{
												ssel.Status="Removed";
												ssel.Selected=false;
												// force unselect — no longer a valid pick
											}
											else
											{
												ssel.Status="Active";
											}
										}
										// === Step 3: Add new rows for newly matched suppliers not yet present ===
										for each  sidStr in matchedSupplierIDs
										{
											if(!existingSelectedIDs.contains(sidStr))
											{
												supRec = Suppliers[ID == sidStr.toLong()];
												supName = supRec.Supplier_Name.first_name;
												if(supName == null || supName == "")
												{
													supName = supRec.Supplier_Name.last_name;
												}
												newSel = Purchase_Request1.Supplier_Selected();
												newSel.Supplier_ID=sidStr;
												newSel.Suppliers=supName;
												newSel.Status="Active";
												newSel.Selected=false;
												input.Supplier_Selected.insert(newSel);
											}
										}
										// === Step 4: Enforce only ONE winner — unselect all other rows when one is selected ===
										for each  wsel1 in input.Supplier_Selected
										{
											if(wsel1.Selected == true)
											{
												for each  wsel2 in input.Supplier_Selected
												{
													if(wsel2.ID != wsel1.ID)
													{
														wsel2.Selected=false;
													}
												}
											}
										}
										// === Step 5: Populate header fields based on the winner ===
										winnerSupplierID = "";
										winnerSupplierName = "";
										winnerFinalPrice = 0;
										winnerLeadTime = 0;
										for each  ssel in input.Supplier_Selected
										{
											if(ssel.Selected)
											{
												winnerSupplierID = ssel.Supplier_ID.toString();
												winnerSupplierName = ssel.Suppliers;
												winnerFinalPrice = ifnull(ssel.Final_Price,0);
												winnerLeadTime = ifnull(ssel.Lead_Time,0);
											}
										}
										if(winnerSupplierID != "")
										{
											input.Selected_Supplier = winnerSupplierName;
											// FIXED 2026-07-14: only overwrite Selcted_Final_Cost when the winner's OWN row
											// actually has a real price — see NOTES below for why.
											if(winnerFinalPrice > 0)
											{
												input.Selcted_Final_Cost = winnerFinalPrice;
											}
											input.Required_Days_Lead = winnerLeadTime;
											// REMOVED 2026-07-28, real bug found live (PR-00006, SO-16325) — this comparison
											// used the NATIVE Supplier_Load_Balancing subform's own recommendedSupplierID
											// (Step 1, above), computed by pr_sync_supplier_load_balancing.txt's stale-tiebreak
											// logic (first-in-list wins on an Active_POs tie — native subform order put
											// Fenteng first, widget's own live NPR_SUPPLIERS fetch order put Tony first, same
											// 0-0 tie, two different "winners"). Confirmed via direct API pull: native subform
											// said Fenteng=Recommended while the PRs widget's own live Load Balancing panel
											// (computeRecommendedSupplier(), a separate/more-current computation) correctly
											// showed Tony=Recommended. Every save/edit re-ran this Validations workflow and
											// silently reverted Followed_Recommendation back to "No" even right after being
											// manually corrected, permanently blocking Create PO with a false "needs Override
											// Reason." Real fix: this field is now owned EXCLUSIVELY by the PRs widget
											// (syncFollowedRecFromSupplier() on manual pick, autoHealFollowedRecommendation()
											// self-correcting it live whenever the recommendation shifts) — matches this app's
											// own established "native form isn't used in deployment, widget owns live
											// decisions" pattern already applied to Load Balancing itself. This workflow no
											// longer touches Followed_Recommendation at all here.
										}
										else
										{
											input.Selected_Supplier = "";
											input.Selcted_Final_Cost = 0;
											input.Required_Days_Lead = 0;
											input.Followed_Recommendation = "";
										}
						)
					}
				}

			}
			PR_Check_Readiness as "PR_Check_Readiness"
			{
				type =  form
				form = Purchase_Request1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Condition 1: Selected Supplier
										hasSelected = false;
										sup = input.Selected_Supplier;
										if(sup != null)
										{
											if(sup != "")
											{
												hasSelected = true;
											}
										}
										input.Selected_Supplier1 = hasSelected;
										// Condition 2: Final Price confirmed
										// From-inquiry items: price already validated upstream at the Inquiry's own SRP-approval
										// step, so trust it unconditionally (even a 0-rate item counts as confirmed here).
										// Not-from-inquiry items: auto-confirmed if the item has a real catalog Rate (that rate
										// is what gets sent to Books regardless of any supplier quote — see pr_to_po_grouping.txt).
										// Only a not-from-inquiry, 0-rate item needs a genuine manual supplier price
										// (Selcted_Final_Cost, synced from the winning Supplier_Selected row) to confirm.
										hasPrice = false;
										// FIXED 2026-08-05, real mismatch found live (PR-00002/SO-16399) — this check never
										// looked at SRP_Approved_PR (the manual-approval field, separate from SRP_Rate_PR/
										// inquiry_reference) at all, so a PR whose price was confirmed via SRP_Approved_PR
										// alone (inquiry_reference blank, no catalog Rate, Selcted_Final_Cost still 0) stayed
										// "Final price confirmed = false" -> PR_READY_FOR_PO = false natively, blocking the
										// native Create PO action item, while the PRs widget's OWN client-side readiness
										// checklist (which DOES check SRP_Approved_PR, same priority order already fixed this
										// session in pr_to_po_grouping.txt's approvePOFenteng/Tony) showed all 5 conditions
										// green — a genuine native-vs-widget readiness disagreement, not a stale-recompute
										// issue. Added SRP_Approved_PR as the first-checked tier, same priority order as
										// approvePOFenteng/Tony's own price resolution (SRP_Approved_PR -> SRP_Rate_PR ->
										// inquiry_reference -> catalog Rate -> Selcted_Final_Cost).
										srpApprovedVal = input.SRP_Approved_PR;
										if(srpApprovedVal != null && srpApprovedVal != 0)
										{
											hasPrice = true;
										}
										else
										{
											srpRateVal = input.SRP_Rate_PR;
											if(srpRateVal != null && srpRateVal != 0)
											{
												hasPrice = true;
											}
											else
											{
												hasInqRef = input.inquiry_reference != null && input.inquiry_reference != "";
												if(hasInqRef)
												{
													hasPrice = true;
												}
												else
												{
													itemRateVal = 0;
													itemRecCheck = Items[SKU == input.sku];
													if(itemRecCheck != null)
													{
														itemRateStrCheck = itemRecCheck.Rate + "";
														if(itemRateStrCheck != "null" && itemRateStrCheck != "" && itemRateStrCheck != "0")
														{
															itemRateVal = itemRateStrCheck.toDecimal();
														}
													}
													if(itemRateVal != 0)
													{
														hasPrice = true;
													}
													else
													{
														fp = input.Selcted_Final_Cost;
														if(fp != null && fp > 0)
														{
															hasPrice = true;
														}
													}
												}
											}
										}
										input.Final_price_confirmed = hasPrice;
										// Condition 3: Shipping mode selected
										// FIXED 2026-09-05, per user ("wala namang lcl, fcl at air pag sa local lang") —
										// Local (HC System) sourcing never has an external freight leg, so there is no
										// real Shipment_Mode value to ever pick. Without this, a Local PR's Shipment_Mode
										// stays permanently blank and this condition (and therefore PR_READY_FOR_PO)
										// would never pass — auto-satisfied for Local instead.
										hasMode = false;
										if(input.Sourcing_Type == "Local")
										{
											hasMode = true;
										}
										else
										{
											sm = input.Shipment_Mode;
											if(sm != null)
											{
												if(sm != "")
												{
													hasMode = true;
												}
											}
										}
										input.Shipping_mode_selected = hasMode;
										// Condition 4: Target date exists
										input.Target_date_exists = input.Target_Delivery != null;
										// === Final AND ===
										input.PR_READY_FOR_PO = input.Selected_Supplier1 && input.Final_price_confirmed && input.Shipping_mode_selected && input.Target_date_exists;
						)
					}
				}

			}
			Select_Unselect_Supplier as "Select_Unselect_Supplier"
			{
				type =  form
				form = Purchase_Request1

				record event = on add or edit

				on user input of Supplier_Selected.Selected
				{
					actions 
					{
						custom deluge script
						(
											if(row.Selected == true)
										{
											for each  sq in input.Supplier_Selected
											{
												if(sq.ID != row.ID)
												{
													sq.Selected=false;
