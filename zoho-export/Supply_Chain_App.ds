			INQ_Generate_Number as "INQ_Generate_Number"
			{
				type =  form
				form = Inquiry_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											seqVal = input.INQ_Seq;
										paddedSeq = "";
										if(seqVal < 10)
										{
											paddedSeq = "0000" + seqVal;
										}
										else if(seqVal < 100)
										{
											paddedSeq = "000" + seqVal;
										}
										else if(seqVal < 1000)
										{
											paddedSeq = "00" + seqVal;
										}
										else if(seqVal < 10000)
										{
											paddedSeq = "0" + seqVal;
										}
										else
										{
											paddedSeq = seqVal + "";
										}
										newInqNo = "INQ-" + paddedSeq;
										update Inquiry_Form[ID == input.ID]
										[
											INQ_No=newInqNo
										];
						)
					}
				}

			}
