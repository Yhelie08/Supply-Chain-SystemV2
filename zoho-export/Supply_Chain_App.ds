			INQ_AutoFill_Item_Details1 as "INQ_AutoFill_Item_Details_2"
			{
				type =  form
				form = Inquiry_Form

				record event = on add or edit

				on user input of Items
				{
					actions 
					{
						custom deluge script
						(
											if(input.Items != null && input.Items != 0)
										{
											records = Items[ID == input.Items];
											for each  rec in records
											{
												input.sku = rec.SKU;
												input.description = rec.Description;
												input.unit = rec.Unit;
												input.SRP_Approved1 = rec.Rate;
												input.Product_Image = rec.Image;
